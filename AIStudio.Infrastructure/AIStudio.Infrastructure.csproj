<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIStudio.Core\AIStudio.Core.csproj" />
    <!-- UpdateHub.Client SDK — kontrola aktualizací přes updatehub.niderle.cz.
         Než SDK půjde jako NuGet, používáme přímou project referenci.
         Repo: E:\Projects\updatehub (sibling solution). -->
    <ProjectReference Include="..\..\updatehub\sdk\UpdateHub.Client\UpdateHub.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-platform packages -->
    <PackageReference Include="LLamaSharp" Version="0.22.0" />
    <!-- Cpu backend je tranzitivní závislost — vyloučíme native assets aby nedošlo
         ke konfliktu AVX variant (avx/avx2/avx512/noavx) při dotnet publish -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.22.0">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Pro rozbalení ComfyUI Portable .7z archivu při auto-instalaci -->
    <PackageReference Include="SharpCompress" Version="0.40.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>

  <!-- Windows-specific packages — na macOS / Linux by build padl (CUDA driver,
       WMI, 7z native DLL bundled jen pro Windows binárky). Phase B/C přidá
       per-platform varianty: LLamaSharp.Backend.Vulkan (AMD/Intel),
       LLamaSharp.Backend.Metal (Apple Silicon). -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.22.0" />
    <!-- Vulkan backend — cross-vendor (NVIDIA / AMD / Intel). Pro AMD a Intel
         karty je to jediná akcelerace, kterou LLamaSharp na Windows nabízí.
         NVIDIA karty stále preferují CUDA (vyšší propustnost), ale Vulkan
         tady jako fallback / pro karty bez CUDA runtime. -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.22.0" />
    <!-- Bundluje 7z.dll (x64+x86) — nativní 7-Zip engine bez nutnosti instalace 7-Zipu uživatelem -->
    <PackageReference Include="SevenZipExtractor" Version="1.0.17" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.7" />
    <!-- WMI klient — pro Win32_VideoController, Win32_Processor, Win32_OperatingSystem -->
    <PackageReference Include="System.Management" Version="10.0.7" />
    <!-- LibreHardwareMonitorLib — cross-vendor GPU metrics (NVIDIA via NVAPI,
         AMD via ADL, Intel via D3D). Klíčové pro AMD karty s > 4 GB VRAM, kde
         WMI Win32_VideoController.AdapterRAM přetéká (UInt32) a hlásí 0.
         Apache-2.0 licence, bez admin práv pro většinu read-only sensorů. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <!-- Windows-specific implementace, které používají WMI / nvidia-smi / 7z DLL.
       Na non-Windows je vynech kompilace — DI registrace je už platform-guarded. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="Services\WindowsGpuDetector.cs" />
    <!-- Soubor stále SystemMonitorService.cs (class přejmenována v Phase A.4) -->
    <Compile Remove="Services\SystemMonitorService.cs" />
    <!-- Soubor stále ComfyInstaller.cs (class přejmenována v Phase A.3) -->
    <Compile Remove="Services\ComfyInstaller.cs" />
  </ItemGroup>

  <!-- macOS-specifické implementace mají [SupportedOSPlatform("macos")]
       atributy, takže kompilují na všech platformách (jen Process.Start
       calls by na Windows nikdy neproběhly). DI je registruje jen na macOS
       runtime (OperatingSystem.IsMacOS() guard v App.axaml.cs).
       Tím pádem mohou cross-referencovat z App vrstvy bez konfliktu. -->

  <!-- macOS-only packages — LLamaSharp.Backend.Metal je nutný pro Apple Silicon
       Metal akceleraci. Na Windows / Linux ho nepotřebujeme a NuGet by ho ani
       neuměl resolvnut (osx-arm64 / osx-x64 RID).
       Detekce přes MSBuild predikát funguje na Windows i POSIX shells. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="LLamaSharp.Backend.Metal" Version="0.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test projekt vidí internal helpers (mappery v GpuDetector, atd.).
         Eliminuje potřebu vytahovat čistě pomocnou logiku do public API. -->
    <InternalsVisibleTo Include="AIStudio.Tests" />
  </ItemGroup>

</Project>
