<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- OutputType per-platform:
           Windows → WinExe (bez console okna pro GUI app)
           macOS / Linux → Exe (Avalonia.Desktop zvládne GUI bez WinExe)
         Phase C přidá macOS .app bundling přes <CFBundle*> properties. -->
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- app.manifest a .ico jsou Win32 PE resource — na macOS / Linux je SDK
         ignoruje s warningem; raději úplně vyřadit. -->
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Potlačí chybu NETSDK1152 při publish (LLamaSharp.Backend.Cpu AVX varianty) -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- macOS .app bundle metadata. Aktivuje se při publish s RID osx-arm64,
       SDK pak vyrobí složku AIStudio.app/Contents/MacOS/AIStudio.App místo
       holé binárky. CFBundle* properties čte ze sourozeneckého Info.plist. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $(RuntimeIdentifier.StartsWith('osx'))">
    <!-- Identifikace bundle (musí matchnout Info.plist CFBundleIdentifier). -->
    <CFBundleIdentifier>cz.niderle.aistudio</CFBundleIdentifier>
    <CFBundleName>AI Studio</CFBundleName>
    <CFBundleDisplayName>AI Studio</CFBundleDisplayName>
    <CFBundleVersion>0.1.0</CFBundleVersion>
    <CFBundleShortVersionString>0.1.0</CFBundleShortVersionString>
    <CFBundleExecutable>AIStudio.App</CFBundleExecutable>
    <NSHumanReadableCopyright>© 2025 Ladislav Niderle</NSHumanReadableCopyright>
    <!-- Min. macOS verze. .NET 10 oficiálně 12+. -->
    <LSMinimumSystemVersion>12.0</LSMinimumSystemVersion>
  </PropertyGroup>

  <!-- Info.plist se kopíruje do AIStudio.app/Contents/ při publish. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $(RuntimeIdentifier.StartsWith('osx'))">
    <None Include="Info.plist" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Windows-only DI bootstrap (registruje WindowsGpuDetector/SystemMonitor/
       ComfyInstaller). Tyto typy jsou v Infrastructure na non-Windows Compile-Removed,
       takže reference na ně nesmí existovat v kódu kompilovaném na macOS/Linux.
       RegisterWindowsPlatformServices je partial — bez tohoto souboru zůstane
       bez těla (no-op). -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="App.Windows.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- ResX soubory pro lokalizaci — SDK je auto-embedduje s logickým názvem
         AIStudio.App.Strings.Strings.cs / .en (bez přípony .resx) -->
    <EmbeddedResource Update="Strings\Strings.cs.resx">
      <Generator></Generator>
      <LastGenOutput></LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings\Strings.en.resx">
      <Generator></Generator>
      <LastGenOutput></LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIStudio.Core\AIStudio.Core.csproj" />
    <ProjectReference Include="..\AIStudio.Infrastructure\AIStudio.Infrastructure.csproj" />
  </ItemGroup>
</Project>
