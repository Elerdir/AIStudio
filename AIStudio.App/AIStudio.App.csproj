<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- OutputType per-platform:
           Windows → WinExe (bez console okna pro GUI app)
           macOS / Linux → Exe (Avalonia.Desktop zvládne GUI bez WinExe)
         Phase C přidá macOS .app bundling přes <CFBundle*> properties. -->
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- app.manifest a .ico jsou Win32 PE resource — na macOS / Linux je SDK
         ignoruje s warningem; raději úplně vyřadit. -->
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Potlačí chybu NETSDK1152 při publish (LLamaSharp.Backend.Cpu AVX varianty) -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- ResX soubory pro lokalizaci — SDK je auto-embedduje s logickým názvem
         AIStudio.App.Strings.Strings.cs / .en (bez přípony .resx) -->
    <EmbeddedResource Update="Strings\Strings.cs.resx">
      <Generator></Generator>
      <LastGenOutput></LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Strings\Strings.en.resx">
      <Generator></Generator>
      <LastGenOutput></LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIStudio.Core\AIStudio.Core.csproj" />
    <ProjectReference Include="..\AIStudio.Infrastructure\AIStudio.Infrastructure.csproj" />
  </ItemGroup>
</Project>
