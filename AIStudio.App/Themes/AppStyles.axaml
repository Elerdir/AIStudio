<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nav item button -->
    <Style Selector="Button.navItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextLightBrush}"/>
    </Style>

    <Style Selector="Button.navItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource VeryDeepBgBrush}"/>
    </Style>

    <Style Selector="Button.navItem.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#26263A"/>
        <Setter Property="TextElement.Foreground" Value="#A78BFA"/>
    </Style>

    <Style Selector="Button.navItem.active TextBlock">
        <Setter Property="Foreground" Value="#A78BFA"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Primary action button -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#7C3AED"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#6D28D9"/>
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#5B21B6"/>
    </Style>

    <!-- Secondary button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ElevatedBgBrush}"/>
    </Style>

    <!-- Page title -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Section header -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextWeakBrush}"/>
        <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>

    <!-- Card -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Input — třída chatInput drží konzistentně tmavé pozadí ve všech stavech.
         FluentTheme má v defaultní šabloně TextBoxu vnitřní Border#PART_BorderElement
         který při :focus / :pointerover přebírá brushy TextControlBackgroundFocused
         (světlé). Bez následujících override selectorů se input v dark módu při
         kliku zbělá a text zmizí v šedi. -->
    <Style Selector="TextBox.chatInput">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="#A78BFA"/>
        <Setter Property="SelectionBrush" Value="#4C3A7A"/>
    </Style>

    <Style Selector="TextBox.chatInput:focus">
        <Setter Property="BorderBrush" Value="#7C3AED"/>
    </Style>

    <!-- Tyhle tři override drží PART_BorderElement (vnitřní fluent backplate)
         tmavý ve všech stavech. Bez nich :focus přepne na bílo. -->
    <Style Selector="TextBox.chatInput /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    </Style>
    <Style Selector="TextBox.chatInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    </Style>
    <Style Selector="TextBox.chatInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
    </Style>

    <!-- Stejný override pro „transparentní" variantu, kdy je TextBox uvnitř
         vnějšího Borderu, který drží pozadí — typicky chat input wrapper.
         (TextBox má Background=Transparent, ale FluentTheme inner BG by jinak
         přebil na světlou barvu.) -->
    <Style Selector="TextBox.chatInputInner /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.chatInputInner:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.chatInputInner:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.chatInputInner">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SelectionBrush" Value="#4C3A7A"/>
    </Style>

    <!-- Tab button -->
    <Style Selector="Button.tabBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextHintBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextLightBrush}"/>
    </Style>
    <Style Selector="Button.tabBtn.activeTab /template/ ContentPresenter">
        <Setter Property="Background" Value="#26263A"/>
        <Setter Property="TextElement.Foreground" Value="#A78BFA"/>
    </Style>
    <Style Selector="Button.tabBtn.activeTab">
        <Setter Property="Foreground" Value="#A78BFA"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</Styles>
