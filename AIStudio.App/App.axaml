<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AIStudio.App.App"
             xmlns:local="using:AIStudio.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://AIStudio.App/Themes/AppStyles.axaml"/>
        <StyleInclude Source="avares://Material.Icons.Avalonia/MaterialIconStyles.axaml"/>
    </Application.Styles>

    <!-- ══ Semantic color tokens — respond to Light/Dark theme switching ══
         All structural colors (backgrounds, borders, text) are defined here
         so views can use {DynamicResource Xxx} and get correct values in both
         themes. Accent colors (#7C3AED, #4ADE80, …) are intentionally NOT here
         — they look fine in both themes and do not need dynamic lookup.       -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ── Dark theme ──────────────────────────────────────── -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Backgrounds — deepest to shallowest -->
                    <SolidColorBrush x:Key="AppBgBrush"          Color="#0D0D0D"/>
                    <SolidColorBrush x:Key="VeryDeepBgBrush"     Color="#0A0A0C"/>
                    <SolidColorBrush x:Key="DeepPanelBgBrush"    Color="#0F0F11"/>
                    <SolidColorBrush x:Key="PanelBgBrush"        Color="#111113"/>
                    <SolidColorBrush x:Key="SubtlePanelBgBrush"  Color="#141416"/>
                    <SolidColorBrush x:Key="SidebarBgBrush"      Color="#161618"/>
                    <SolidColorBrush x:Key="CardBgBrush"         Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="HoverBgBrush"        Color="#222228"/>
                    <SolidColorBrush x:Key="AppBorderBrush"      Color="#2A2A2E"/>
                    <SolidColorBrush x:Key="ElevatedBgBrush"     Color="#333338"/>
                    <SolidColorBrush x:Key="CardHoverBgBrush"    Color="#3A3A44"/>
                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#EBEBF5"/>
                    <SolidColorBrush x:Key="TextLightBrush"      Color="#CCCCDD"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#9999AA"/>
                    <SolidColorBrush x:Key="TextMutedBrush"      Color="#888896"/>
                    <SolidColorBrush x:Key="TextHintBrush"       Color="#666672"/>
                    <SolidColorBrush x:Key="TextWeakBrush"       Color="#555560"/>
                    <SolidColorBrush x:Key="TextDisabledBrush"   Color="#444450"/>
                    <!-- Accent (fialová — primary brand) -->
                    <SolidColorBrush x:Key="AccentBrush"          Color="#7C3AED"/>
                    <SolidColorBrush x:Key="AccentLightBrush"     Color="#A78BFA"/>
                    <SolidColorBrush x:Key="AccentLighterBrush"   Color="#C4B5FD"/>
                    <SolidColorBrush x:Key="AccentSubtleBrush"    Color="#7c7398"/>
                    <!-- Semantic — stejné v obou themes pro snadnou rozpoznatelnost -->
                    <SolidColorBrush x:Key="ErrorBrush"            Color="#F87171"/>
                    <SolidColorBrush x:Key="SuccessBrush"          Color="#4ADE80"/>
                    <SolidColorBrush x:Key="WarningBrush"          Color="#F59E0B"/>
                    <SolidColorBrush x:Key="RatingBrush"           Color="#FBBF24"/>
                    <!-- Semantic surfaces — pozadí/okraj/text barevných info-panelů
                         (progress, chyba, úspěch, varování). Dark hodnoty drží stávající
                         vzhled, Light přidává čitelnou světlou variantu. -->
                    <SolidColorBrush x:Key="InfoSurfaceBrush"      Color="#1A1830"/>
                    <SolidColorBrush x:Key="InfoBorderBrush"       Color="#2A2550"/>
                    <SolidColorBrush x:Key="InfoTextBrush"         Color="#818CF8"/>
                    <SolidColorBrush x:Key="WarnSurfaceBrush"      Color="#1C1810"/>
                    <SolidColorBrush x:Key="WarnBorderBrush"       Color="#3A2E0E"/>
                    <SolidColorBrush x:Key="WarnTextBrush"         Color="#E0B050"/>
                    <SolidColorBrush x:Key="ErrSurfaceBrush"       Color="#2A1414"/>
                    <SolidColorBrush x:Key="ErrBorderBrush"        Color="#5A2424"/>
                    <SolidColorBrush x:Key="ErrTextBrush"          Color="#E08585"/>
                    <SolidColorBrush x:Key="OkSurfaceBrush"        Color="#142814"/>
                    <SolidColorBrush x:Key="OkBorderBrush"         Color="#1F3A1F"/>
                    <SolidColorBrush x:Key="OkTextBrush"           Color="#86EFAC"/>
                </ResourceDictionary>

                <!-- ── Light theme ─────────────────────────────────────── -->
                <ResourceDictionary x:Key="Light">
                    <!-- Backgrounds -->
                    <SolidColorBrush x:Key="AppBgBrush"          Color="#F2F2F7"/>
                    <SolidColorBrush x:Key="VeryDeepBgBrush"     Color="#E5E5EA"/>
                    <SolidColorBrush x:Key="DeepPanelBgBrush"    Color="#E8E8ED"/>
                    <SolidColorBrush x:Key="PanelBgBrush"        Color="#EBEBF0"/>
                    <SolidColorBrush x:Key="SubtlePanelBgBrush"  Color="#E8E8ED"/>
                    <SolidColorBrush x:Key="SidebarBgBrush"      Color="#E5E5EA"/>
                    <SolidColorBrush x:Key="CardBgBrush"         Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HoverBgBrush"        Color="#D8D8E0"/>
                    <SolidColorBrush x:Key="AppBorderBrush"      Color="#D1D1D6"/>
                    <SolidColorBrush x:Key="ElevatedBgBrush"     Color="#E0E0E8"/>
                    <SolidColorBrush x:Key="CardHoverBgBrush"    Color="#F0F0F8"/>
                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#1C1C1E"/>
                    <SolidColorBrush x:Key="TextLightBrush"      Color="#3C3C48"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#5A5A68"/>
                    <SolidColorBrush x:Key="TextMutedBrush"      Color="#636370"/>
                    <SolidColorBrush x:Key="TextHintBrush"       Color="#707078"/>
                    <SolidColorBrush x:Key="TextWeakBrush"       Color="#8E8E98"/>
                    <SolidColorBrush x:Key="TextDisabledBrush"   Color="#A0A0A8"/>
                    <!-- Accent — stejné jako dark, fialová je distinct dost na obou pozadích -->
                    <SolidColorBrush x:Key="AccentBrush"          Color="#7C3AED"/>
                    <SolidColorBrush x:Key="AccentLightBrush"     Color="#8B5CF6"/>
                    <SolidColorBrush x:Key="AccentLighterBrush"   Color="#7C3AED"/>
                    <SolidColorBrush x:Key="AccentSubtleBrush"    Color="#7c7398"/>
                    <!-- Semantic — tmavší varianty pro lepší kontrast na světlém pozadí -->
                    <SolidColorBrush x:Key="ErrorBrush"            Color="#DC2626"/>
                    <SolidColorBrush x:Key="SuccessBrush"          Color="#16A34A"/>
                    <SolidColorBrush x:Key="WarningBrush"          Color="#D97706"/>
                    <SolidColorBrush x:Key="RatingBrush"           Color="#CA8A04"/>
                    <!-- Semantic surfaces — světlé tinty pro barevné info-panely -->
                    <SolidColorBrush x:Key="InfoSurfaceBrush"      Color="#ECECFB"/>
                    <SolidColorBrush x:Key="InfoBorderBrush"       Color="#C7C7EE"/>
                    <SolidColorBrush x:Key="InfoTextBrush"         Color="#4F46E5"/>
                    <SolidColorBrush x:Key="WarnSurfaceBrush"      Color="#FBF1D6"/>
                    <SolidColorBrush x:Key="WarnBorderBrush"       Color="#E3C778"/>
                    <SolidColorBrush x:Key="WarnTextBrush"         Color="#8A5A00"/>
                    <SolidColorBrush x:Key="ErrSurfaceBrush"       Color="#FCE3E3"/>
                    <SolidColorBrush x:Key="ErrBorderBrush"        Color="#E8A5A5"/>
                    <SolidColorBrush x:Key="ErrTextBrush"          Color="#B91C1C"/>
                    <SolidColorBrush x:Key="OkSurfaceBrush"        Color="#DDF4E1"/>
                    <SolidColorBrush x:Key="OkBorderBrush"         Color="#A5D7AF"/>
                    <SolidColorBrush x:Key="OkTextBrush"           Color="#15803D"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
