<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.Chat"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             xmlns:ctrl="using:AIStudio.App.Controls"
             xmlns:conv="using:AIStudio.App.Converters"
             xmlns:models="using:AIStudio.Core.Models"
             x:Class="AIStudio.App.Views.Chat.ChatPageView"
             x:DataType="vm:ChatPageViewModel">

    <UserControl.KeyBindings>
        <!-- Globální zkratky pro chat stránku -->
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConversationCommand}"/>
        <KeyBinding Gesture="F2"     Command="{Binding BeginEditTitleCommand}"/>
    </UserControl.KeyBindings>

    <Grid ColumnDefinitions="240,*">

        <!-- ═══════════════════ SIDEBAR — seznam konverzací ═══════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <Border DockPanel.Dock="Top" Padding="10,14,10,8">
                    <Button Classes="primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,10"
                            Command="{Binding NewConversationCommand}"
                            Content="+ Nový chat"/>
                </Border>

                <!-- Vyhledávání v konverzacích -->
                <Border DockPanel.Dock="Top" Padding="8,0,8,6">
                    <TextBox Text="{Binding SidebarSearch}"
                             PlaceholderText="&#xE721; Hledat…"
                             Background="{DynamicResource CardBgBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                             Foreground="{DynamicResource TextLightBrush}" CaretBrush="{DynamicResource AccentLightBrush}"
                             CornerRadius="8" Padding="10,6"
                             FontSize="12"/>
                </Border>

                <Border DockPanel.Dock="Top" Padding="14,2,14,4">
                    <TextBlock Text="KONVERZACE" Classes="sectionHeader"/>
                </Border>

                <ListBox ItemsSource="{Binding FilteredConversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent"
                         Padding="6,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationViewModel">
                            <Border Padding="8,10" CornerRadius="8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <!-- Připnutá konverzace: fialová tečka vlevo od názvu -->
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="●" FontSize="7" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsPinned}"/>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextLightBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Title}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding ShortDate}"
                                                       FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"/>
                                            <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource ElevatedBgBrush}"/>
                                            <TextBlock Text="{Binding SelectedModelName}"
                                                       FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="80"/>
                                            <!-- Počet zpráv — zobrazí se pouze pokud existují zprávy -->
                                            <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource ElevatedBgBrush}"
                                                       IsVisible="{Binding HasMessages}"/>
                                            <TextBlock Text="{Binding MessageCount}"
                                                       FontSize="11" Foreground="#333A48"
                                                       IsVisible="{Binding HasMessages}"
                                                       ToolTip.Tip="{Binding MessageCount, StringFormat='Počet zpráv: {0}'}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Připnout — fade-in při hover, vždy viditelné pokud je připnuto -->
                                    <Button Grid.Column="1"
                                            Classes="pinConv"
                                            Command="{ReflectionBinding $parent[ListBox].DataContext.TogglePinConversationCommand}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24" Padding="0"
                                            CornerRadius="6"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Připnout / Odepnout">
                                        <Panel>
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pin}" Width="12" Height="12" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsPinned}"/>
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.PinOutline}" Width="12" Height="12" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsPinned}"/>
                                        </Panel>
                                    </Button>

                                    <!-- Smazat — fade-in při hover -->
                                    <Button Grid.Column="2"
                                            Classes="deleteConv"
                                            Command="{ReflectionBinding $parent[ListBox].DataContext.DeleteConversationCommand}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24" Padding="0"
                                            CornerRadius="6"
                                            Background="{DynamicResource ErrSurfaceBrush}" BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Smazat konverzaci">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="12" Height="12" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AppBorderBrush}"/>
                        </Style>
                        <Style Selector="Button.pinConv">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Button.pinConv">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover Button.pinConv">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <!-- Připnuté konverzace: pin ikona vždy viditelná -->
                        <Style Selector="Button.pinConv[Tag=pinned]">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <Style Selector="Button.deleteConv">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Button.deleteConv">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Button.deleteConv">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover Button.deleteConv">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════════════ CHAT AREA ═══════════════════════════════════ -->
        <!--
            Row 0: Header (titulek, model picker, token slider)
            Row 1: Context usage strip (Auto, viditelný jen pokud je vybraná konverzace)
            Row 2: System prompt panel (Auto, skrytý pokud IsSystemPromptVisible=false)
            Row 3: Zprávy (*)
            Row 4: Regenerate / Loading strip (Auto)
            Row 5: Input area (Auto)
        -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

            <!-- ── Row 0: Header ── -->
            <Border Grid.Row="0" Padding="20,12,20,10"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource PanelBgBrush}">
                <StackPanel Spacing="10">

                    <!-- ── Řádek 1: Titulek konverzace + akční ikony (celá šířka) ── -->
                    <Panel VerticalAlignment="Center">

                        <!-- View mode -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4"
                              IsVisible="{Binding !IsEditingTitle}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedConversation.Title}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- Přejmenovat -->
                            <Button Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding BeginEditTitleCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="Přejmenovat (F2)">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pencil}" Width="14" Height="14" Foreground="{DynamicResource TextDisabledBrush}"/>
                            </Button>
                            <!-- Kopírovat celou konverzaci do schránky (plain text, role: obsah) -->
                            <Button Grid.Column="2"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding CopyConversationCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedConversation.HasMessages}"
                                    ToolTip.Tip="Zkopírovat celou konverzaci do schránky">
                                <Panel>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="14" Height="14" IsVisible="{Binding !IsConversationCopied}" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="14" Height="14" IsVisible="{Binding IsConversationCopied}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <!-- Exportovat -->
                            <Button Grid.Column="3"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding ExportConversationCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="Exportovat konverzaci (MD / TXT)">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Export}" Width="14" Height="14" Foreground="{DynamicResource TextDisabledBrush}"/>
                            </Button>
                            <!-- Systémový prompt toggle -->
                            <Button Grid.Column="4"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding ToggleSystemPromptCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="Systémový prompt">
                                <Panel>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CommentTextOutline}" Width="14" Height="14" IsVisible="{Binding !IsSystemPromptVisible}" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CommentTextOutline}" Width="14" Height="14" IsVisible="{Binding IsSystemPromptVisible}" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <!-- Compact: shrnout starší zprávy a uvolnit kontext (jako /compact) -->
                            <Button Grid.Column="5"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding CompactConversationCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanCompactConversation}"
                                    ToolTip.Tip="Shrnout starší zprávy a uvolnit kontext — okno tak zůstane funkční déle a bere míň tokenů">
                                <Panel>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ArrowCollapseVertical}" Width="14" Height="14" IsVisible="{Binding !IsCompacting}" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Timer}" Width="14" Height="14" IsVisible="{Binding IsCompacting}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                            </Button>
                            <!-- Vymazat zprávy konverzace -->
                            <Button Grid.Column="6"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4" Width="26" Height="26" CornerRadius="6"
                                    Command="{Binding ClearConversationCommand}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedConversation.HasMessages}"
                                    ToolTip.Tip="Vymazat zprávy (zachová nastavení konverzace)">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Eraser}" Width="14" Height="14" Foreground="{DynamicResource TextDisabledBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Edit mode -->
                        <TextBox Name="TitleEditBox"
                                 Text="{Binding EditingTitle}"
                                 IsVisible="{Binding IsEditingTitle}"
                                 Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="#4C3A7A"
                                 BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                 CornerRadius="8" Padding="8,5"
                                 FontSize="14" FontWeight="SemiBold"
                                 LostFocus="TitleEditBox_LostFocus"
                                 KeyDown="TitleEditBox_KeyDown"/>
                    </Panel>

                    <!-- ── Řádek 2: Model picker + posuvníky ──
                         WrapPanel se zalomí na víc řádků, když okno není dost
                         široké. Tím pádem titulek nahoře i posuvník teploty
                         zůstanou vždy celé vidět, místo aby se ořezaly. -->
                    <WrapPanel Orientation="Horizontal">

                    <!-- Model picker + unload + thinking toggle -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center"
                                Margin="0,0,16,4">
                        <TextBlock Text="Model:"
                                   FontSize="11" Foreground="{DynamicResource TextWeakBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedConversation.SelectedModelName}"
                                  Background="{DynamicResource CardBgBrush}"
                                  Foreground="{DynamicResource TextLightBrush}"
                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                  CornerRadius="8"
                                  FontSize="12"
                                  MinWidth="190"
                                  IsEnabled="{Binding !IsSending}"/>
                        <!-- GPU badge — zelený, viditelný pouze pokud model jede na GPU -->
                        <Border IsVisible="{Binding IsGpuBackend}"
                                Background="{DynamicResource OkSurfaceBrush}"
                                CornerRadius="6" Padding="6,3"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding BackendTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Gpu}"
                                                 Width="12" Height="12" Foreground="{DynamicResource SuccessBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="GPU" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- CPU badge — jantarový, viditelný pokud model jede přes CPU (ne GPU) -->
                        <Border IsVisible="{Binding IsCpuBackend}"
                                Background="{DynamicResource WarnSurfaceBrush}"
                                CornerRadius="6" Padding="6,3"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding BackendTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Chip}"
                                                 Width="12" Height="12" Foreground="{DynamicResource WarningBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Live RAM/VRAM ticker — pro GPU backend ukazuje VRAM, pro CPU RAM.
                             Aktualizováno každé 2,5 s ze SystemMonitorService. -->
                        <Border IsVisible="{Binding IsModelLoaded}"
                                Background="{DynamicResource HoverBgBrush}"
                                CornerRadius="6" Padding="6,3"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding MemoryUsageTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Memory}"
                                                 Width="12" Height="12"
                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MemoryUsageLabel}"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Live ticker rychlosti generování (tok/s) — jen během streamu -->
                        <Border IsVisible="{Binding HasGenerationSpeed}"
                                Background="{DynamicResource HoverBgBrush}"
                                CornerRadius="6" Padding="6,3"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Rychlost generování odpovědi (tokeny za sekundu)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Speedometer}"
                                                 Width="12" Height="12"
                                                 Foreground="{DynamicResource AccentLightBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GenerationSpeedLabel}"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Uvolnit model z VRAM -->
                        <Button IsVisible="{Binding IsModelLoaded}"
                                Command="{Binding UnloadModelCommand}"
                                Background="{DynamicResource WarnSurfaceBrush}"
                                BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                CornerRadius="8"
                                Width="28" Height="28" Padding="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding LoadedModelName, StringFormat='Uvolnit &quot;{0}&quot; z VRAM'}">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Memory}" Width="14" Height="14" Foreground="{DynamicResource WarnTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Thinking mode toggle — pouze pro Qwen3 modely -->
                        <Button IsVisible="{Binding SelectedConversation.IsQwen3Selected}"
                                Command="{Binding ToggleThinkingModeCommand}"
                                BorderThickness="1" CornerRadius="8"
                                Width="28" Height="28" Padding="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Thinking mode (Qwen3) — interní přemýšlení před odpovědí">
                            <Button.Background>
                                <SolidColorBrush Color="#0F0A1E"/>
                            </Button.Background>
                            <Button.BorderBrush>
                                <SolidColorBrush Color="#2A1A44"/>
                            </Button.BorderBrush>
                            <Panel>
                                <!-- Zapnuto -->
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Brain}" Width="14" Height="14" IsVisible="{Binding SelectedConversation.IsThinkingEnabled}" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Vypnuto -->
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Brain}" Width="14" Height="14" IsVisible="{Binding !SelectedConversation.IsThinkingEnabled}" Foreground="#333344" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </Button>
                    </StackPanel>

                    <!-- Token slider (limit délky odpovědi modelu) -->
                    <StackPanel Spacing="3" VerticalAlignment="Center"
                                Width="210" Margin="0,0,16,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Tokeny"
                                       FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                       ToolTip.Tip="Maximální délka odpovědi modelu"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedConversation.MaxTokensLabel}"
                                       FontSize="11" Foreground="{DynamicResource AccentLightBrush}"
                                       FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <Slider Value="{Binding SelectedConversation.TokenSliderValue}"
                                Minimum="0" Maximum="100"
                                TickFrequency="0"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Temperature slider -->
                    <StackPanel Spacing="3" VerticalAlignment="Center"
                                Width="160" Margin="0,0,0,4"
                                IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Teplota"
                                       FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedConversation.TemperatureLabel}"
                                       FontSize="11" Foreground="{DynamicResource AccentLightBrush}"
                                       FontWeight="SemiBold" TextAlignment="Right"/>
                        </Grid>
                        <Slider Value="{Binding SelectedConversation.Temperature}"
                                Minimum="0" Maximum="2"
                                TickFrequency="0"
                                IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ── Row 1: Context usage strip — výrazný ukazatel naplnění
                          KV cache modelu. Vždy viditelný (pokud máme konverzaci)
                          aby uživatel věděl, kdy se kontext blíží limitu. ── -->
            <Border Grid.Row="1"
                    IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,6,20,8"
                    ToolTip.Tip="{Binding ContextUsageTooltip}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Memory}"
                                         Width="13" Height="13"
                                         Foreground="{DynamicResource TextWeakBrush}"
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="Kontext"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextHintBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                                 Value="{Binding ContextUsagePercent}"
                                 Minimum="0" Maximum="100"
                                 Height="6" CornerRadius="3"
                                 Foreground="{Binding ContextBarBrush}"
                                 Background="{DynamicResource CardBgBrush}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ContextUsageLabel}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextLightBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Row 2: Systémový prompt panel (skrytý pokud není aktivní) ── -->
            <Border Grid.Row="2"
                    IsVisible="{Binding IsSystemPromptVisible}"
                    Background="{DynamicResource VeryDeepBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,10,20,12">
                <Grid RowDefinitions="Auto,6,Auto,6,Auto,6,Auto" >
                    <!-- Hlavička panelu -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CommentTextOutline}" Width="14" Height="14" Foreground="{DynamicResource TextWeakBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="SYSTÉMOVÝ PROMPT"
                                       Classes="sectionHeader"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="· přepíše výchozí instrukce pro tento chat"
                                       FontSize="10" Foreground="{DynamicResource CardHoverBgBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Uložit aktuální prompt jako preset -->
                        <Button Grid.Column="1"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,2" Height="22" CornerRadius="6"
                                Command="{Binding BeginSavePresetCommand}"
                                ToolTip.Tip="Uložit tento systémový prompt jako vlastní preset">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentSaveOutline}" Width="12" Height="12" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Uložit preset" FontSize="10" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Background="Transparent" BorderThickness="0"
                                Padding="4" Width="22" Height="22" CornerRadius="6"
                                Command="{Binding ToggleSystemPromptCommand}"
                                ToolTip.Tip="Skrýt panel">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="12" Height="12" Foreground="{DynamicResource TextDisabledBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Čipy presetů — klik naplní prompt; × smaže vlastní -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SystemPromptPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SystemPromptPreset">
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="14" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding Name}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.ApplySystemPromptPresetCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource TextLightBrush}" FontSize="11"
                                                Padding="10,4"
                                                ToolTip.Tip="Použít tento preset"/>
                                        <Button IsVisible="{Binding !IsBuiltIn}"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.DeletePresetCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                                ToolTip.Tip="Smazat preset">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="10" Height="10" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- TextBox systémového promptu -->
                    <TextBox Grid.Row="4"
                             Text="{Binding SelectedConversation.SystemPrompt}"
                             PlaceholderText="Instrukce pro model — napiš vlastní jednorázový prompt, nebo klikni na preset výše…"
                             Background="{DynamicResource SidebarBgBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                             Foreground="{DynamicResource TextLightBrush}"
                             CaretBrush="{DynamicResource AccentLightBrush}"
                             Padding="12,8"
                             FontSize="12"
                             AcceptsReturn="True"
                             MaxLines="8"
                             MaxLength="4000"
                             TextWrapping="Wrap"
                             CornerRadius="8"/>

                    <!-- Inline pojmenování při ukládání presetu -->
                    <Grid Grid.Row="6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                          IsVisible="{Binding IsNamingPreset}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewPresetName}"
                                 PlaceholderText="Název presetu (např. 'Erotická povídka')…"
                                 Background="{DynamicResource CardBgBrush}"
                                 BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource TextLightBrush}" CaretBrush="{DynamicResource AccentLightBrush}"
                                 Padding="10,5" FontSize="12" CornerRadius="8"/>
                        <Button Grid.Column="1" Content="Uložit"
                                Command="{Binding ConfirmSavePresetCommand}"
                                FontSize="12" Padding="12,5" CornerRadius="8"
                                Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Foreground="{DynamicResource AccentLighterBrush}"/>
                        <Button Grid.Column="2" Content="Zrušit"
                                Command="{Binding CancelSavePresetCommand}"
                                FontSize="12" Padding="12,5" CornerRadius="8"
                                Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Row 3: Zprávy + FAB ── -->
            <Panel Grid.Row="3">
              <ScrollViewer Padding="28,16,28,0" Name="MessagesScroll"
                            VerticalScrollBarVisibility="Auto"
                            AllowAutoHide="False"
                            Classes="visibleScrollbar">
              <Panel>

                <!-- Prázdný stav — žádná konverzace vůbec (vše smazáno) -->
                <StackPanel IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNull}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" Margin="0,40,0,0" MaxWidth="380">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Forum}" Width="52" Height="52" Foreground="#1A1A22" HorizontalAlignment="Center"/>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Žádný chat"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#252530"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Vlevo klikni na tlačítko + Nový chat a můžeš začít psát."
                                   FontSize="13" Foreground="#1E1E28"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Command="{Binding NewConversationCommand}"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource InfoSurfaceBrush}"
                            BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="20,10">
                        <TextBlock Text="+ Nový chat"
                                   FontSize="13" Foreground="{DynamicResource AccentLightBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Prázdný stav — konverzace vybraná, ale ještě beze zpráv -->
                <StackPanel IsVisible="{Binding SelectedConversation.HasNoMessages}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="0" Margin="0,40,0,0" MaxWidth="420">

                    <!-- Stav A: žádný stažený model -->
                    <StackPanel IsVisible="{Binding !HasDownloadedModels}"
                                HorizontalAlignment="Center" Spacing="16">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Robot}" Width="52" Height="52" Foreground="#1E1E28" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="Zatím žádný model"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="#2A2A38"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Stáhni si model a pak se sem vrať."
                                       FontSize="13" Foreground="#222230"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding NavigateToModelsCommand}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="20,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Robot}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Přejít do Modelů"
                                           FontSize="13" Foreground="{DynamicResource AccentLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Stav B: model existuje, chat je prázdný -->
                    <StackPanel IsVisible="{Binding HasDownloadedModels}"
                                HorizontalAlignment="Center" Spacing="12">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Forum}" Width="52" Height="52" Foreground="#1A1A22" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Začni konverzaci"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="#252530"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Napiš zprávu níže a stiskni Enter."
                                       FontSize="13" Foreground="#1E1E28"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Model se načte automaticky při prvním odeslání."
                                       FontSize="11" Foreground="#1A1A24"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!-- Bottom margin 100: garantovaný gap pod poslední bublinou.
                     SVPadding.Bottom je 0 (nuly se nepletou do extent výpočtu).
                     ScrollToBottom nastaví Offset = Extent.Height, ScrollViewer
                     clampuje na max → pod poslední bublinou je vždy 100px volna. -->
                <StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}"
                              Margin="0,0,0,100">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessage">
                            <Border Margin="0,6">
                                <Grid ColumnDefinitions="60,*,60">

                                    <!-- Uživatelská zpráva (vpravo) -->
                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            MaxWidth="640"
                                            Background="{DynamicResource InfoSurfaceBrush}"
                                            BorderBrush="{DynamicResource InfoSurfaceBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14,14,2,14"
                                            Padding="14,10,14,14"
                                            IsVisible="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MessageRole.User}}">
                                        <Panel>

                                            <!-- Zobrazení (normální stav) -->
                                            <StackPanel Spacing="0" IsVisible="{Binding !IsEditing}">
                                                <!-- Přiložené obrázky — náhledy (bez možnosti smazat, zpráva už je odeslaná) -->
                                                <ItemsControl ItemsSource="{Binding AttachmentPaths}"
                                                              IsVisible="{Binding HasAttachments}"
                                                              Margin="0,0,0,8">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border CornerRadius="8" ClipToBounds="True"
                                                                    Margin="0,0,8,8" MaxWidth="200"
                                                                    Background="{DynamicResource InfoSurfaceBrush}">
                                                                <Image Stretch="Uniform" MaxHeight="180"
                                                                       Source="{Binding Converter={x:Static conv:ImagePathToThumbnailConverter.Instance}}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <SelectableTextBlock Text="{Binding DisplayText}"
                                                           IsVisible="{Binding DisplayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                           Foreground="{DynamicResource InfoTextBrush}"
                                                           FontSize="14" LineHeight="22"
                                                           TextWrapping="Wrap"/>
                                                <!-- Řádek: čas + tokeny (vlevo) + akce (vpravo) -->
                                                <StackPanel Spacing="8" Margin="0,12,0,6">
                                                <Border Height="1" Background="{DynamicResource AccentLightBrush}" Opacity="0.5"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeLabel}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InfoTextBrush}"/>
                                                        <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource InfoTextBrush}"
                                                                   IsVisible="{Binding TokenHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding TokenHint}"
                                                                   FontSize="11" Foreground="{DynamicResource InfoTextBrush}"
                                                                   IsVisible="{Binding TokenHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="msgAction"
                                                                Command="{Binding CopyContentCommand}"
                                                                ToolTip.Tip="Kopírovat"
                                                                Width="24" Height="24" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <Panel>
                                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="14" Height="14" Foreground="{DynamicResource AccentLighterBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsCopied}"/>
                                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCopied}"/>
                                                            </Panel>
                                                        </Button>
                                                        <Button Classes="msgAction"
                                                                Command="{Binding BeginEditCommand}"
                                                                ToolTip.Tip="Upravit zprávu"
                                                                Width="24" Height="24" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pencil}" Width="14" Height="14" Foreground="{DynamicResource AccentLighterBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Větev konverzace od této zprávy -->
                                                        <Button Classes="msgAction"
                                                                Command="{ReflectionBinding $parent[UserControl].DataContext.BranchConversationCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Větev od této zprávy"
                                                                Width="24" Height="24" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.SourceFork}" Width="14" Height="14" Foreground="{DynamicResource AccentLighterBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Editační mód -->
                                            <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                                                <TextBox Text="{Binding EditContent}"
                                                         Background="{DynamicResource InfoSurfaceBrush}"
                                                         BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                         Foreground="{DynamicResource InfoTextBrush}"
                                                         CaretBrush="{DynamicResource AccentLightBrush}"
                                                         SelectionBrush="#4C3A7A"
                                                         Padding="10,8"
                                                         FontSize="14"
                                                         AcceptsReturn="True"
                                                         MaxLines="10"
                                                         TextWrapping="Wrap"
                                                         CornerRadius="8"
                                                         MinWidth="260">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}"/>
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Spacing="6">
                                                    <Button Command="{Binding CancelEditCommand}"
                                                            Content="Zrušit"
                                                            FontSize="12" Padding="10,5"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource ErrSurfaceBrush}"
                                                            BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                                                            Foreground="{DynamicResource ErrorBrush}"/>
                                                    <Button Command="{ReflectionBinding $parent[UserControl].DataContext.ConfirmEditCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="Potvrdit"
                                                            FontSize="12" Padding="10,5"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource InfoSurfaceBrush}"
                                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                            Foreground="{DynamicResource AccentLighterBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                        </Panel>
                                    </Border>

                                    <!-- Asistent (vlevo, nebo uprostřed při image progress loaderu) -->
                                    <Border Grid.Column="1"
                                            Classes="assistantBubble"
                                            Classes.centerOnImageProgress="{Binding IsImageProgressOnly}"
                                            MaxWidth="640"
                                            Background="{DynamicResource CardBgBrush}"
                                            CornerRadius="14,14,14,2"
                                            Padding="14,10,14,14"
                                            IsVisible="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MessageRole.Assistant}}">
                                        <StackPanel Spacing="0">
                                            <!-- ════════════ IMAGE BUBLINA (chat → image gen) ════════════
                                                 Zobrazena pokud zpráva nese ImagePath (hotový obrázek) NEBO
                                                 IsImageGenerating (běží Comfy). Stručný subtitle pod obrázkem
                                                 ukáže model + reasoning od intent parseru.
                                                 Klik na obrázek = ImageZoomWindow s plnou velikostí. -->
                                            <Panel IsVisible="{Binding IsImageMessage}">

                                                <!-- Searching placeholder — recommender + live search běží (1-3s) -->
                                                <Border IsVisible="{Binding IsSearchingForUpgrade}"
                                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="24,18"
                                                        MinWidth="420" MinHeight="90">
                                                    <StackPanel Orientation="Horizontal" Spacing="14"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MagnifyScan}"
                                                                         Width="26" Height="26" Foreground="{DynamicResource AccentLightBrush}"
                                                                         VerticalAlignment="Center"/>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Hledám nejlepší model pro tento prompt…"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentLighterBrush}"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="Zkoumám stažené modely i online katalog (Civitai, HuggingFace)."
                                                                       FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}"
                                                                       TextWrapping="Wrap" MaxWidth="360"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Upgrade prompt panel — recommender našel lepší nesažený model -->
                                                <Border IsVisible="{Binding IsAwaitingUpgradeChoice}"
                                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                                                        CornerRadius="10" Padding="16,14"
                                                        MinWidth="320">
                                                    <StackPanel Spacing="10">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.LightbulbOutline}"
                                                                             Width="18" Height="18" Foreground="{DynamicResource AccentLightBrush}"
                                                                             VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Mám lepší model pro tento typ scény"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentLighterBrush}"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}"
                                                                           TextWrapping="Wrap" MaxWidth="380"
                                                                           Text="{Binding PendingUpgradeOffer.Reason}"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding PendingUpgradeOffer.Name}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentLightBrush}"/>
                                                                    <TextBlock Text="·" FontSize="11" Foreground="#3a3a4a"/>
                                                                    <TextBlock Text="{Binding UpgradeOfferSizeLabel}"
                                                                               FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                            <Button Grid.Column="0"
                                                                    Classes="secondary"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Command="{Binding RejectUpgradeCommand}">
                                                                <TextBlock Text="Použít stažený" FontSize="12"/>
                                                            </Button>
                                                            <Button Grid.Column="1"
                                                                    Classes="primary"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    Command="{Binding AcceptUpgradeCommand}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}"
                                                                                     Width="14" Height="14" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Stáhnout lepší" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                        <!-- Civitai API klíč warning — pokud nabídka je z Civitai a klíč není nastaven -->
                                                        <Border IsVisible="{Binding CivitaiKeyWarningVisible}"
                                                                Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                                                CornerRadius="6" Padding="10,6" Margin="0,2,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertOutline}"
                                                                                 Width="13" Height="13" Foreground="{DynamicResource WarningBrush}"
                                                                                 VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource WarnTextBrush}"
                                                                           TextWrapping="Wrap" MaxWidth="380"
                                                                           Text="Tip: nastav Civitai API klíč v Nastavení → Stahování pro spolehlivější stažení. Bez klíče může selhat rate-limitem."/>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- "Už mi to nenabízej pro tento typ" — perzistuje do Settings, když uživatel klikne Použít stažený -->
                                                        <CheckBox IsChecked="{Binding DontAskAgainForThisKind}"
                                                                  Content="Už mi to nenabízej pro tento typ"
                                                                  FontSize="11"
                                                                  Foreground="{DynamicResource AccentSubtleBrush}"
                                                                  Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Download progress — viditelný jen pokud uživatel zvolí Stáhnout lepší -->
                                                <Border IsVisible="{Binding IsDownloadingUpgradeModel}"
                                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                                                        CornerRadius="10" Padding="16,14"
                                                        MinWidth="320">
                                                    <StackPanel Spacing="10">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}"
                                                                             Width="18" Height="18" Foreground="{DynamicResource AccentLightBrush}"
                                                                             VerticalAlignment="Center"/>
                                                            <TextBlock Text="Stahuju model na pozadí…"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentLighterBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <ProgressBar Value="{Binding UpgradeDownloadPercent}"
                                                                     Minimum="0" Maximum="100"
                                                                     Height="4" CornerRadius="2"
                                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InfoSurfaceBrush}"/>
                                                        <TextBlock Text="{Binding UpgradeDownloadStatusLabel}"
                                                                   FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Loading placeholder dokud běží generování -->
                                                <Border IsVisible="{Binding IsImageGenerating}"
                                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="24,20"
                                                        MinWidth="420" MinHeight="110">
                                                    <StackPanel Orientation="Horizontal" Spacing="14"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}"
                                                                         Width="28" Height="28" Foreground="{DynamicResource AccentLightBrush}"
                                                                         VerticalAlignment="Center"/>
                                                        <StackPanel Spacing="6" MinWidth="300">
                                                            <TextBlock Text="{Binding ImageGeneratingLabel}"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentLighterBrush}"
                                                                       HorizontalAlignment="Center"/>
                                                            <!-- Živý progress bar z ComfyUI (0–100). -->
                                                            <ProgressBar Value="{Binding ImageGenProgress}"
                                                                         Minimum="0" Maximum="100"
                                                                         Height="6" CornerRadius="3"
                                                                         Foreground="{DynamicResource AccentLightBrush}"
                                                                         Background="{DynamicResource InfoSurfaceBrush}"/>
                                                            <TextBlock Text="Po dokončení se model uvolní z VRAM."
                                                                       FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}"
                                                                       TextWrapping="Wrap" MaxWidth="360"
                                                                       TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Hotový obrázek (klik = zoom).
                                                     POZN: Použit Tapped handler v code-behind místo Button + Command.
                                                     Důvod: Button + ICommand binding nefungoval spolehlivě uvnitř
                                                     vnořeného DataTemplate (klik se občas chytil event handlerem
                                                     ScrollVieweru nad ItemsControlem a chápal se jako pan gesto,
                                                     navíc DataContext byl ne-deterministický kvůli Classes-binding
                                                     na rodičovské bublině). Tapped event v code-behind nemá tyhle
                                                     gotchas a vždy zavolá příslušnou ChatMessage.OpenImageZoom. -->
                                                <StackPanel Spacing="6" IsVisible="{Binding !IsImageGenerating}">
                                                    <Border CornerRadius="10" ClipToBounds="True"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Left"
                                                            Tapped="GeneratedImage_Tapped"
                                                            ToolTip.Tip="Klikni pro zvětšení na plnou velikost">
                                                        <Border.Styles>
                                                            <Style Selector="Border:pointerover">
                                                                <Setter Property="Opacity" Value="0.92"/>
                                                            </Style>
                                                        </Border.Styles>
                                                        <Image Source="{Binding ImagePath, Converter={x:Static vm:ChatImagePathToBitmapConverter.Instance}}"
                                                               Stretch="Uniform"
                                                               MaxWidth="560" MaxHeight="560"/>
                                                    </Border>

                                                    <!-- Hover action bar pod obrázkem -->
                                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                                IsVisible="{Binding ImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <Button Classes="msgAction"
                                                                Command="{Binding OpenImageZoomCommand}"
                                                                ToolTip.Tip="Zvětšit na plnou velikost"
                                                                Width="22" Height="22" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Magnify}"
                                                                             Width="12" Height="12"
                                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Classes="msgAction"
                                                                Command="{Binding SaveImageAsCommand}"
                                                                ToolTip.Tip="Uložit jako…"
                                                                Width="22" Height="22" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}"
                                                                             Width="12" Height="12"
                                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Classes="msgAction"
                                                                Command="{Binding OpenImageExternalCommand}"
                                                                ToolTip.Tip="Otevřít v externí prohlížečce"
                                                                Width="22" Height="22" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.OpenInNew}"
                                                                             Width="12" Height="12"
                                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Upravit tento obrázek (vyzbrojí edit pro další zprávu) -->
                                                        <Button Classes="msgAction"
                                                                Command="{Binding EditImageCommand}"
                                                                ToolTip.Tip="Upravit tento obrázek — napiš pak instrukci, co změnit"
                                                                Width="22" Height="22" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pencil}"
                                                                             Width="12" Height="12"
                                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Upscale (ESRGAN ~2×, vyšší rozlišení a ostrost) -->
                                                        <Button Classes="msgAction"
                                                                Command="{Binding UpscaleImageCommand}"
                                                                ToolTip.Tip="Upscale — zvětšit a zostřit (~2×)"
                                                                Width="22" Height="22" Padding="0"
                                                                CornerRadius="6"
                                                                Background="Transparent" BorderThickness="0">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ArrowExpandAll}"
                                                                             Width="12" Height="12"
                                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Subtitle (model + reasoning od intent parseru) -->
                                                    <SelectableTextBlock Text="{Binding Content}"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                                         FontSize="11" LineHeight="16"
                                                                         TextWrapping="Wrap"
                                                                         MaxWidth="560"
                                                                         IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </Panel>

                                            <!-- ════════════ TEXT BUBLINA (klasická LLM odpověď) ════════════
                                                 Skryta pokud je zpráva obrázek (a obráceně), ať se template
                                                 neperou o stejný prostor. -->
                                            <Panel IsVisible="{Binding !IsImageMessage}">
                                            <!-- ── Streaming pohled — laciný plain text + typing dots ──
                                                 MarkdownViewer při každé změně Content znovu staví celý
                                                 strom (StackPanel, TextBlocky, code-block bordery…), takže
                                                 při ~60 tokenech/s zahltí UI thread → "Neodpovídá".
                                                 Během streamu proto použijeme jen SelectableTextBlock
                                                 (laciný Avalonia primitive) a teprve po dokončení
                                                 přepneme na plný markdown render — jen jednou. -->
                                            <StackPanel Spacing="0">
                                            <Panel IsVisible="{Binding IsStreaming}">
                                                <!-- Typing dots — viditelné dokud nedorazí první token -->
                                                <StackPanel Classes="typingIndicator"
                                                            Orientation="Horizontal" Spacing="4"
                                                            Margin="0,2,0,4"
                                                            IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource TextWeakBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource TextWeakBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource TextWeakBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Živě se aktualizující plain text -->
                                                <SelectableTextBlock Text="{Binding Content}"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     FontSize="14" LineHeight="22"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </Panel>
                                            <!-- Plný markdown render — pouze po dokončení streamu -->
                                            <ctrl:MarkdownViewer Markdown="{Binding Content}"
                                                                 Padding="0"
                                                                 IsVisible="{Binding !IsStreaming}"/>
                                            <!-- Footer wrap (separator čára + akční řádek).
                                                 Separator je samostatný Border s vlastní Opacity,
                                                 aby neovlivnil průhlednost children (TextBlock + akce). -->
                                            <StackPanel IsVisible="{Binding !IsStreaming}" Spacing="8" Margin="0,12,0,6">
                                            <Border Height="1" Background="{DynamicResource InfoSurfaceBrush}" Opacity="0.6"/>
                                            <Border Padding="0,2,0,0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeLabel}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                                               IsVisible="{Binding TokenHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <TextBlock Text="{Binding TokenHint}"
                                                               FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                                               IsVisible="{Binding TokenHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                    <!-- Zkusit znovu (jen při chybě) -->
                                                    <Button Classes="msgAction"
                                                            IsVisible="{Binding IsError}"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.RegenerateLastResponseCommand}"
                                                            ToolTip.Tip="Zkusit znovu"
                                                            Width="24" Height="24" Padding="0"
                                                            CornerRadius="6"
                                                            Background="Transparent" BorderThickness="0">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Refresh}" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <!-- Větev konverzace -->
                                                    <Button Classes="msgAction"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.BranchConversationCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Větev od této zprávy"
                                                            Width="24" Height="24" Padding="0"
                                                            CornerRadius="6"
                                                            Background="Transparent" BorderThickness="0">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.SourceFork}" Width="14" Height="14" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <!-- Kopírovat -->
                                                    <Button Classes="msgAction"
                                                            Command="{Binding CopyContentCommand}"
                                                            ToolTip.Tip="Kopírovat"
                                                            Width="24" Height="24" Padding="0"
                                                            CornerRadius="6"
                                                            Background="Transparent" BorderThickness="0">
                                                        <Panel>
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="14" Height="14" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsCopied}"/>
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCopied}"/>
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            </Border>
                                            </StackPanel>
                                            </StackPanel>
                                            </Panel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Systémová / compact summary zpráva (přes celou šířku, centrovaná).
                                         Vzniká po kliknutí na „Shrnout" — shrne starší část konverzace,
                                         aby kontext nepřetekl. Vizuálně decentní, ať není zaměnitelná
                                         s běžnou odpovědí. -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            HorizontalAlignment="Center"
                                            MaxWidth="720"
                                            Margin="0,4"
                                            Background="{DynamicResource InfoSurfaceBrush}"
                                            BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16,12"
                                            IsVisible="{Binding Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:MessageRole.System}}">
                                        <StackPanel Spacing="6">
                                            <ctrl:MarkdownViewer Markdown="{Binding Content}" Padding="0"/>
                                            <Border Height="1" Background="{DynamicResource InfoBorderBrush}" Opacity="0.6"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="Starší zprávy byly shrnuty pro úsporu kontextu"
                                                           FontSize="11" Foreground="{DynamicResource TextWeakBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="msgAction"
                                                        Command="{Binding CopyContentCommand}"
                                                        ToolTip.Tip="Kopírovat shrnutí"
                                                        Width="24" Height="24" Padding="0"
                                                        CornerRadius="6"
                                                        Background="Transparent" BorderThickness="0">
                                                    <Panel>
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="14" Height="14" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsCopied}"/>
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCopied}"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Styles>
                        <!-- Asistentská bublina:
                             - default vlevo (běžná text/obrázková zpráva)
                             - .centerOnImageProgress aktivní = bublina ve středu chatu
                               (zatímco se hledá model / stahuje / generuje obrázek)
                               Po dokončení (ImagePath přibyde) se přepne zpátky vlevo. -->
                        <Style Selector="Border.assistantBubble">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                        <Style Selector="Border.assistantBubble.centerOnImageProgress">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>

                        <!-- Animace typing dots v asistentské bublině -->
                        <Style Selector="StackPanel.typingIndicator">
                            <Style.Animations>
                                <Animation Duration="0:0:0.9" IterationCount="INFINITE"
                                           Easing="SineEaseInOut" FillMode="Both">
                                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                    <KeyFrame Cue="50%"> <Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                        <!-- Akční tlačítka pod každou bublinou: vždy dobře viditelná (0.75),
                             na hover plné. Předtím byla 0.45 a uživatel je sotva viděl =
                             bublina vypadala "bez konce". -->
                        <Style Selector="Border Button.msgAction">
                            <Setter Property="Opacity" Value="0.75"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Border:pointerover Button.msgAction">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <!-- Hover na tlačítko samotné: highlight pozadí pro feedback -->
                        <Style Selector="Button.msgAction:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                        </Style>
                    </ItemsControl.Styles>
                </ItemsControl>

                </StackPanel>

              </Panel>
              </ScrollViewer>

              <!-- FAB: Scroll na konec (zobrazí se, když uživatel scrolloval nahoru) -->
              <Button Name="ScrollToBottomFab"
                      IsVisible="False"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,28,16"
                      Width="36" Height="36" Padding="0"
                      CornerRadius="18"
                      Background="{DynamicResource InfoBorderBrush}"
                      BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                      ToolTip.Tip="Přejít na konec (↓)"
                      Click="ScrollToBottomFab_Click">
                  <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ChevronDown}" Width="16" Height="16" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </Panel>

            <!-- ── Row 4: Stripy (StackPanel = více pruhů může být viditelných naráz) ── -->
            <StackPanel Grid.Row="4">

                <!-- Edit-mode strip — aktivní editace zprávy -->
                <Border IsVisible="{Binding SelectedConversation.IsAnyMessageEditing}"
                        Background="{DynamicResource VeryDeepBgBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="20,7,20,7">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pencil}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Editace zprávy — potvrď nebo zruš"
                                   FontSize="12" Foreground="{DynamicResource InfoTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Loading strip -->
                <Border IsVisible="{Binding IsLoadingModel}"
                        Background="{DynamicResource WarnSurfaceBrush}"
                        BorderBrush="{DynamicResource WarnSurfaceBrush}" BorderThickness="0,1,0,0"
                        Padding="20,7,20,7">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressBar IsIndeterminate="True"
                                     Width="120" Height="2"
                                     Foreground="{DynamicResource WarningBrush}"
                                     Background="{DynamicResource WarnSurfaceBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ModelStatusText}"
                                   FontSize="12" Foreground="{DynamicResource WarnTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Regenerate / Porovnat strip přesunut do Row 4 (input area) jako
                     kompaktní ikonová tlačítka vlevo od Send. Šetří vertikální místo
                     pro samotnou konverzaci. -->


                <!-- Compare model picker strip -->
                <Border IsVisible="{Binding IsComparePickerVisible}"
                        Background="{DynamicResource VeryDeepBgBrush}"
                        BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="0,1,0,0"
                        Padding="20,8,20,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="Porovnat s modelem:"
                                   FontSize="12" Foreground="{DynamicResource TextWeakBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding CompareModelName}"
                                  Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextLightBrush}"
                                  BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" FontSize="12"/>
                        <Button Grid.Column="2"
                                Command="{Binding CompareWithModelCommand}"
                                Background="#1A1A3A" BorderBrush="#3A3A6A" BorderThickness="1"
                                CornerRadius="8" Padding="12,5"
                                ToolTip.Tip="Vytvořit větev a vygenerovat odpověď zvoleným modelem">
                            <TextBlock Text="Spustit" FontSize="12" Foreground="{DynamicResource InfoTextBrush}"/>
                        </Button>
                        <Button Grid.Column="3"
                                Command="{Binding ToggleComparePickerCommand}"
                                Background="Transparent" BorderThickness="0"
                                Width="26" Height="26" Padding="0" CornerRadius="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="12" Height="12" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ── Row 5: Input area (drag&drop obrázků sem) ── -->
            <Border Grid.Row="5"
                    Name="InputDropArea"
                    DragDrop.AllowDrop="True"
                    Padding="20,10,20,18"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppBgBrush}">
                <StackPanel Spacing="8">

                    <!-- Chip „Upravuji obrázek" — viditelný po kliku na ikonu Upravit -->
                    <Border IsVisible="{Binding HasPendingEdit}"
                            Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Pencil}"
                                             Width="14" Height="14"
                                             Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="Upravuji obrázek:"/>
                                <Run Text="{Binding PendingEditFileName}" FontWeight="SemiBold"/>
                                <Run Text="— napiš, co změnit" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </TextBlock>
                            <Button Command="{Binding CancelPendingEditCommand}"
                                    ToolTip.Tip="Zrušit editaci"
                                    Width="20" Height="20" Padding="0" CornerRadius="5"
                                    Background="Transparent" BorderThickness="0">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}"
                                                 Width="12" Height="12"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Přiložené obrázky — strip náhledů s křížkem (multi + drag&drop) -->
                    <ItemsControl ItemsSource="{Binding AttachedImages}"
                                  IsVisible="{Binding HasAttachedImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Width="64" Height="64" Margin="0,0,8,8"
                                        CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource PanelBgBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <Panel>
                                        <!-- Náhled (dekódovaný na ~120 px) -->
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding Converter={x:Static conv:ImagePathToThumbnailConverter.Instance}}"
                                               ToolTip.Tip="{Binding}"/>
                                        <!-- Křížek pro odebrání (vpravo nahoře) -->
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Width="20" Height="20" Padding="0" Margin="2"
                                                CornerRadius="10"
                                                Background="#CC1A1A1F" BorderThickness="0"
                                                Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Odebrat obrázek">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="11" Height="11" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Input řádek: attach + image-mode toggle + textbox + regenerate/compare + send/stop -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">

                        <!-- Přiložit obrázek -->
                        <Button Grid.Column="0"
                                Command="{Binding AttachImageCommand}"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Width="46" Height="46" Padding="0" CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Přiložit obrázek">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Paperclip}" Width="18" Height="18" Foreground="{DynamicResource TextDisabledBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Image-mode toggle: cyklický Auto → ForceImage → ForceChat → Auto.
                             Vizuál se mění podle ImageMode (palette outline / palette solid /
                             palette přeškrtnutá), aby uživatel věděl, ve kterém režimu je. -->
                        <Button Grid.Column="1"
                                Command="{Binding CycleImageModeCommand}"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Width="46" Height="46" Padding="0" CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding ImageModeTooltip}">
                            <Panel>
                                <!-- Auto — outline -->
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.PaletteOutline}" Width="18" Height="18"
                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsImageModeAuto}"/>
                                <!-- ForceImage — solid + akcent -->
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Palette}" Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentLightBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsImageModeForceImage}"/>
                                <!-- ForceChat — palette se zákazem -->
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.PaletteSwatchOutline}" Width="18" Height="18"
                                                 Foreground="{DynamicResource ErrorBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsVisible="{Binding IsImageModeForceChat}"/>
                            </Panel>
                        </Button>

                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <TextBox Name="ChatInputBox"
                                     Text="{Binding InputText}"
                                     PlaceholderText="Napiš zprávu… (Enter = odeslat)"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentLightBrush}"
                                     Padding="16,12"
                                     FontSize="14"
                                     AcceptsReturn="False"
                                     MaxLines="1"
                                     MaxLength="8000"
                                     IsEnabled="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     KeyDown="InputBox_KeyDown"/>
                        </Border>

                        <!-- Regenerovat odpověď — kompaktní ikonové tlačítko -->
                        <Button Grid.Column="3"
                                Command="{Binding RegenerateLastResponseCommand}"
                                IsVisible="{Binding CanRegenerate}"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Width="46" Height="46" Padding="0" CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Regenerovat poslední odpověď">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Refresh}" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Porovnat s jiným modelem — kompaktní ikonové tlačítko -->
                        <Button Grid.Column="4"
                                Command="{Binding ToggleComparePickerCommand}"
                                IsVisible="{Binding CanRegenerate}"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                Width="46" Height="46" Padding="0" CornerRadius="12"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Porovnat odpověď s jiným modelem">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Compare}" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Panel Grid.Column="5" Width="46" Height="46">
                            <!-- Odeslat -->
                            <Button Classes="primary"
                                    Command="{Binding SendMessageCommand}"
                                    IsVisible="{Binding !IsSending}"
                                    IsEnabled="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Width="46" Height="46" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="12">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Send}" Width="18" Height="18"/>
                            </Button>
                            <!-- Zastavit generování -->
                            <Button Command="{Binding StopGenerationCommand}"
                                    IsVisible="{Binding IsSending}"
                                    Width="46" Height="46" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="12"
                                    Background="{DynamicResource ErrSurfaceBrush}"
                                    BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                                    ToolTip.Tip="Zastavit generování (Esc)">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Stop}" Width="18" Height="18" Foreground="{DynamicResource ErrorBrush}"/>
                            </Button>
                        </Panel>
                    </Grid>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
