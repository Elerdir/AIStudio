<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIStudio.App.ViewModels.Settings"
        x:Class="AIStudio.App.Views.Settings.LogViewerWindow"
        x:DataType="vm:LogViewerViewModel"
        Title="AI Studio — Log Viewer"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400"
        Background="#0D0D0D"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header s title -->
        <Border Grid.Row="0" Padding="20,16,20,12"
                BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock Text="Log Viewer" FontSize="18" FontWeight="Bold" Foreground="#EBEBF5"/>
                <TextBlock Text="Diagnostické logy aplikace — pro hledání chyb a posílání podpoře."
                           FontSize="11" Foreground="#666672"/>
            </StackPanel>
        </Border>

        <!-- Toolbar: výběr souboru, filtr, hledání, akce -->
        <Border Grid.Row="1" Padding="20,12" Background="#0F0F11"
                BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="280,140,*,Auto,Auto,Auto" ColumnSpacing="10">

                <!-- Výběr souboru -->
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableFiles}"
                          SelectedItem="{Binding SelectedFile}"
                          HorizontalAlignment="Stretch"
                          Background="#1C1C1E" Foreground="#EBEBF5"
                          BorderBrush="#2A2A2E" CornerRadius="8"
                          FontSize="12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogFileItem">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Filtr úrovně -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding SelectedLevel}"
                          HorizontalAlignment="Stretch"
                          Background="#1C1C1E" Foreground="#EBEBF5"
                          BorderBrush="#2A2A2E" CornerRadius="8"
                          FontSize="12"/>

                <!-- Search -->
                <Border Grid.Column="2"
                        Background="#1C1C1E" BorderBrush="#2A2A2E" BorderThickness="1"
                        CornerRadius="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="#555560"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Hledat v logu..."
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#EBEBF5" CaretBrush="#A78BFA"
                                 Padding="8,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Aktualizovat -->
                <Button Grid.Column="3"
                        Classes="secondary"
                        Padding="10,8"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Načíst znovu z disku">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktualizovat" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Otevřít složku -->
                <Button Grid.Column="4"
                        Classes="secondary"
                        Padding="10,8"
                        Command="{Binding OpenLogsFolderCommand}"
                        ToolTip.Tip="Otevřít složku %AppData%\AIStudio\logs\">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Složka" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Kopírovat -->
                <Button Grid.Column="5"
                        Classes="primary"
                        Padding="10,8"
                        Command="{Binding CopyToClipboardCommand}"
                        ToolTip.Tip="Zkopírovat zobrazený obsah do schránky">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsCopied}"/>
                        <TextBlock Text="Kopírovat" FontSize="12" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsCopied}"/>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#4ADE80" VerticalAlignment="Center"
                                   IsVisible="{Binding IsCopied}"/>
                        <TextBlock Text="Zkopírováno" FontSize="12" Foreground="#4ADE80"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsCopied}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Obsah logu -->
        <Border Grid.Row="2" Padding="0" Background="#0A0A0C">
            <Panel>
                <!-- Loading overlay -->
                <Border IsVisible="{Binding IsLoading}"
                        Background="#88000000" ZIndex="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="3"
                                     Foreground="#7C3AED" Background="#222228"/>
                        <TextBlock Text="Načítám…" FontSize="12" Foreground="#888896"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Log textarea -->
                <ScrollViewer Padding="0">
                    <TextBox Text="{Binding FilteredContent, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, Cascadia Mono, monospace"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#CCCCDD"
                             SelectionBrush="#3A2A6A"
                             Padding="20,12"/>
                </ScrollViewer>

                <!-- Empty state — žádný log soubor v adresáři -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="380">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsLoading"/>
                            <Binding Path="AvailableFiles.Count"
                                     Converter="{x:Static ObjectConverters.Equal}"
                                     ConverterParameter="0"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets"
                               FontSize="48" Foreground="#1A1A22"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Žádné logy"
                               FontSize="16" FontWeight="SemiBold" Foreground="#252530"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="V %AppData%\AIStudio\logs\ zatím nic není. Logy se vytvoří během používání aplikace."
                               FontSize="11" Foreground="#1E1E28"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Panel>
        </Border>

        <!-- Footer s počítadlem řádků -->
        <Border Grid.Row="3" Padding="20,8" Background="#0F0F11"
                BorderBrush="#2A2A2E" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding LineCount}"
                           FontSize="11" Foreground="#666672"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Tip: pošli obsah podpoře přes Kopírovat — zachytí filtr i hledání."
                           FontSize="11" Foreground="#444450"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
