<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIStudio.App.ViewModels"
        xmlns:enums="using:AIStudio.Core.Enums"
        xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AIStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AI Studio"
        Width="1280" Height="800"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Icon="/Assets/app-icon.png">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,22,20,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="/Assets/app-icon.png" Width="30" Height="30"/>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="AI Studio"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"/>
                            <TextBlock Text="Lokální AI asistent"
                                       FontSize="10"
                                       Foreground="#55555F"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource AppBorderBrush}" Margin="16,0,16,8"/>

                <!-- Navigation (top items) -->
                <Border Grid.Row="2" Padding="8,0" VerticalAlignment="Top">
                    <StackPanel Spacing="2">

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static enums:NavigationPage.Chat}"
                                Classes="navItem"
                                Classes.active="{Binding ActivePage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:NavigationPage.Chat}}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Forum}" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Chat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static enums:NavigationPage.ImageStudio}"
                                Classes="navItem"
                                Classes.active="{Binding ActivePage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:NavigationPage.ImageStudio}}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Image Studio" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static enums:NavigationPage.Models}"
                                Classes="navItem"
                                Classes.active="{Binding ActivePage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:NavigationPage.Models}}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Robot}" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Modely" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static enums:NavigationPage.System}"
                                Classes="navItem"
                                Classes.active="{Binding ActivePage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:NavigationPage.System}}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Monitor}" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Systém" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- Settings (pinned to bottom, above status bar) -->
                <Border Grid.Row="3" Padding="8,4">
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static enums:NavigationPage.Settings}"
                            Classes="navItem"
                            Classes.active="{Binding ActivePage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:NavigationPage.Settings}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Cog}" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Nastavení" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Status bar (bottom of sidebar) s GPU / VRAM přehledem -->
                <Border Grid.Row="4"
                        Padding="14,8,14,10"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Cursor="Hand">
                    <StackPanel Spacing="4">
                        <!-- Název GPU (jen pokud je dostupná) -->
                        <TextBlock Text="{Binding GpuNameShort}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextWeakBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding GpuAvailable}"/>
                        <!-- VRAM řádek: label + hodnota -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="VRAM"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VramCompact}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextHintBrush}"/>
                        </Grid>
                        <!-- VRAM progress bar -->
                        <ProgressBar Value="{Binding VramPercent}"
                                     Minimum="0" Maximum="100"
                                     Height="3"
                                     CornerRadius="2"
                                     Foreground="#F59E0B"
                                     Background="{DynamicResource HoverBgBrush}"/>
                        <!-- Model / stav -->
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="v0.1.0-beta"
                                   FontSize="10"
                                   Foreground="{DynamicResource ElevatedBgBrush}"/>

                        <!-- Badge: dostupná aktualizace -->
                        <Button Classes="secondary"
                                Padding="6,3"
                                FontSize="10"
                                IsVisible="{Binding Updates.HasUpdate}"
                                Command="{Binding Updates.InstallCommand}"
                                ToolTip.Tip="{Binding Updates.StatusMessage}">
                            <TextBlock Text="{Binding Updates.UpdateLabel}"
                                       Foreground="#F59E0B"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Background="{DynamicResource AppBgBrush}">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

    </Grid>

</Window>
