<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AIStudio.App.ViewModels.Setup"
        xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
        x:Class="AIStudio.App.Views.Setup.FirstRunWizardWindow"
        x:DataType="vm:FirstRunWizardViewModel"
        Title="AI Studio — Průvodce nastavením"
        Width="700" Height="660"
        MinWidth="640" MinHeight="540"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Hlavička: krok-indikátor + název kroku ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                Padding="32,20,32,18">
            <Grid RowDefinitions="Auto,12,Auto">

                <!-- Logo + název aplikace -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="#7C3AED">
                        <TextBlock Text="AI" FontSize="13" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI Studio" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Průvodce nastavením" FontSize="11"
                                   Foreground="{DynamicResource TextWeakBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step dots (7 kroků: uvítání, modely, GPU, tokeny, ComfyUI, doporučené modely, souhrn) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">

                    <!-- Dot 0 -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep0}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep0}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 1 -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep1}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep1}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 2 -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep2}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep2}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 3 -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep3}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep3}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 4 (ComfyUI) -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep4}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep4}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 5 (doporučené modely) -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep5}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep5}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                    <!-- Dot 6 (souhrn) -->
                    <Panel Width="24" Height="8">
                        <Border CornerRadius="4" Background="#7C3AED"
                                IsVisible="{Binding IsStep6}"
                                Width="24" Height="8"/>
                        <Border CornerRadius="4" Background="{DynamicResource AppBorderBrush}"
                                IsVisible="{Binding !IsStep6}"
                                Width="8" Height="8" HorizontalAlignment="Center"/>
                    </Panel>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Obsah kroků ── -->
        <Panel Grid.Row="1">

            <!-- ═══ KROK 0: Uvítání ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep0}" Padding="40,32,40,0"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0">
                    <TextBlock Text="Vítejte v AI Studiu 👋"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               LineHeight="22" TextWrapping="Wrap"
                               Text="Vše pro lokální AI v jedné aplikaci. Tento průvodce vás provede základním nastavením za pár kliknutí."/>

                    <Border Margin="0,28,0,0" Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="20,16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#1A1228">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Forum}" Width="18" Height="18" Foreground="#A78BFA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lokální LLM chat" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                                    <TextBlock Text="LlamaSharp + GGUF modely — žádný cloud"
                                               FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#0E1A18">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="18" Height="18" Foreground="#34D399"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Generování obrázků" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                                    <TextBlock Text="ComfyUI frontend — FLUX, SDXL a další"
                                               FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#1A1018">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}" Width="18" Height="18" Foreground="#F472B6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Správa modelů" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                                    <TextBlock Text="Stahování, katalog, správa VRAM"
                                               FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,20,0,0"
                               FontSize="11" Foreground="{DynamicResource CardHoverBgBrush}"
                               Text="🔒 Veškerá data zůstávají pouze na vašem počítači."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 1: Složka modelů ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep1}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="Kde ukládat modely?" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" LineHeight="22"
                           Text="Modely GGUF mohou mít 5–40 GB. Zvolte disk s dostatkem místa."/>

                <TextBlock Margin="0,24,0,6" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Text="Složka pro modely:"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <TextBox Text="{Binding ModelsDirectory}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="#A78BFA"
                                 Padding="12,10"
                                 FontSize="13"
                                 Name="ModelsPathBox"/>
                    </Border>
                    <Button Grid.Column="1"
                            Name="BrowseBtn"
                            Click="BrowseBtn_Click"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="14,10"
                            FontSize="13" Foreground="{DynamicResource TextLightBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderSearch}" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Procházet" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Margin="0,16,0,0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertOutline}" Width="14" Height="14" Foreground="#A78BFA"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Výchozí umístění:" FontSize="11"
                                       Foreground="{DynamicResource TextWeakBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DefaultModelsDir}"
                                   FontSize="11" Foreground="{DynamicResource CardHoverBgBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource TextWeakBrush}"
                           TextWrapping="Wrap"
                           Text="Složku lze kdykoliv změnit v Nastavení → Cesty."/>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 2: GPU detekce ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep2}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="Hardware a výkon" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           Text="AI Studio detekuje GPU a nastaví optimální výkon."/>

                <!-- Detekce probíhá -->
                <Border IsVisible="{Binding IsDetectingGpu}"
                        Margin="0,24,0,0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ProgressBar IsIndeterminate="True"
                                     Width="80" Height="2"
                                     Foreground="#7C3AED"
                                     Background="{DynamicResource AppBorderBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="Detekuji GPU…" FontSize="13"
                                   Foreground="{DynamicResource TextWeakBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- GPU nalezeno -->
                <Border IsVisible="{Binding GpuDetected}"
                        Margin="0,24,0,0" Background="#0D1A12"
                        BorderBrush="#166534" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Width="44" Height="44"
                                CornerRadius="10" Background="#14532D">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Harddisk}" Width="22" Height="22" Foreground="#4ADE80"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding GpuName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#CCFFCC"/>
                            <TextBlock FontSize="12" Foreground="#4ADE80">
                                <Run Text="VRAM: "/>
                                <Run Text="{Binding VramTotalGb, StringFormat='{}{0:F1} GB'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU nenalezeno (a detekce skončila) -->
                <Border IsVisible="{Binding !GpuDetected}"
                        Margin="0,24,0,0" Background="#1A1008"
                        BorderBrush="#3A2A10" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="4"
                                IsVisible="{Binding !IsDetectingGpu}">
                        <TextBlock Text="GPU nedetekováno" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#FBBF24"/>
                        <TextBlock FontSize="12" Foreground="#A07820" TextWrapping="Wrap"
                                   Text="Inference poběží na CPU — bude pomalejší. Pro GPU je potřeba NVIDIA s CUDA 12."/>
                    </StackPanel>
                </Border>

                <!-- Vendor-specific info box — pravdivé info o tom, co AI Studio
                     s detekovaným vendorem reálně umí. Skryje se pokud detekce
                     vrátila Unknown (tam místo toho funguje box „GPU nedetekováno"). -->
                <Border IsVisible="{Binding HasGpuDetail}"
                        Margin="0,12,0,0"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,11">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.InformationOutline}"
                                         Width="14" Height="14"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding GpuDetailLine}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Toggle GPU / CPU -->
                <Border Margin="0,16,0,0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Preferovaný výpočetní prostředek:"
                                   FontSize="12" Foreground="{DynamicResource TextWeakBrush}"/>
                        <StackPanel Spacing="8">
                            <!-- GPU option -->
                            <Border CornerRadius="8" Padding="12,10"
                                    Background="#1A1228"
                                    Cursor="Hand"
                                    PointerPressed="GpuOption_Pressed">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="18" Height="18"
                                            CornerRadius="9"
                                            BorderBrush="#7C3AED" BorderThickness="2"
                                            Background="#7C3AED">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="White"
                                                IsVisible="{Binding UseGpu}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="GPU (doporučeno)"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextLightBrush}"/>
                                        <TextBlock Text="Rychlé — využívá CUDA jádra"
                                                   FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2"
                                               Kind="{x:Static miKind:MaterialIconKind.Harddisk}" Width="16" Height="16" Foreground="#A78BFA"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#201830"/>
                                    </Style>
                                </Border.Styles>
                            </Border>
                            <!-- CPU option -->
                            <Border CornerRadius="8" Padding="12,10"
                                    Background="{DynamicResource PanelBgBrush}" Cursor="Hand"
                                    PointerPressed="CpuOption_Pressed">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Width="18" Height="18"
                                            CornerRadius="9"
                                            BorderBrush="{DynamicResource CardHoverBgBrush}" BorderThickness="2"
                                            Background="Transparent">
                                        <Border Width="6" Height="6" CornerRadius="3"
                                                Background="#7C3AED"
                                                IsVisible="{Binding !UseGpu}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Jen CPU"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextLightBrush}"/>
                                        <TextBlock Text="Pomalejší — funguje bez GPU"
                                                   FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2"
                                               Kind="{x:Static miKind:MaterialIconKind.Monitor}" Width="16" Height="16" Foreground="{DynamicResource TextWeakBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 3: API tokeny ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep3}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="API tokeny (volitelné)" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" LineHeight="22"
                           Text="Pro stahování veřejných modelů z HuggingFace token nepotřebujete. Tokeny jsou uloženy pouze lokálně."/>

                <!-- HuggingFace -->
                <TextBlock Margin="0,24,0,6" FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="HuggingFace token "/>
                    <Run Text="— hf_..." Foreground="{DynamicResource CardHoverBgBrush}"/>
                </TextBlock>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding HuggingFaceToken}"
                                 PlaceholderText="hf_xxxxxxxxxxxxxxxxxxxxxxxx"
                                 PasswordChar="•"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="#A78BFA"
                                 Padding="12,10"
                                 FontSize="13"
                                 Name="HfTokenBox"/>
                        <Button Grid.Column="1"
                                Name="ToggleHfVisBtn"
                                Click="ToggleHfVis_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="36" Padding="0" CornerRadius="0,9,9,0"
                                ToolTip.Tip="Zobrazit/skrýt token">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.EyeOff}" Width="16" Height="16" Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource CardHoverBgBrush}"
                           Text="Potřebujete pro gated modely (Llama 3, Gemma…)"/>

                <!-- Civitai -->
                <TextBlock Margin="0,20,0,6" FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="Civitai API klíč "/>
                    <Run Text="— pro SDXL modely" Foreground="{DynamicResource CardHoverBgBrush}"/>
                </TextBlock>
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding CivitaiApiKey}"
                                 PlaceholderText="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                 PasswordChar="•"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="#A78BFA"
                                 Padding="12,10"
                                 FontSize="13"
                                 Name="CivitaiKeyBox"/>
                        <Button Grid.Column="1"
                                Name="ToggleCivitaiVisBtn"
                                Click="ToggleCivitaiVis_Click"
                                Background="Transparent" BorderThickness="0"
                                Width="36" Padding="0" CornerRadius="0,9,9,0"
                                ToolTip.Tip="Zobrazit/skrýt klíč">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.EyeOff}" Width="16" Height="16" Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource CardHoverBgBrush}"
                           Text="Dostupný na civitai.com v Profil → API Keys"/>

                <TextBlock Margin="0,20,0,0" FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                           Text="Tokeny lze kdykoliv přidat nebo změnit v Nastavení → API."/>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 4: Generování obrázků (ComfyUI install) ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep4}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="Generování obrázků" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           LineHeight="22" TextWrapping="Wrap"
                           Text="AI Studio používá ComfyUI jako engine pro generování obrázků. Můžeme ho stáhnout a nastavit za vás — nebo tento krok přeskočit, pokud vás obrázky nezajímají (ComfyUI lze doinstalovat kdykoliv později v Nastavení)."/>

                <!-- Karta — stav instalace -->
                <Border Margin="0,24,0,0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="16">

                        <!-- Hlavička karty -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1A1228">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageMultipleOutline}"
                                                 Width="18" Height="18" Foreground="#A78BFA"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ComfyUI Portable"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="Stáhneme oficiální Windows Portable build (~3 GB)"
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Badge „Nainstalováno" -->
                        <Border IsVisible="{Binding ShowComfyInstalledBadge}"
                                Background="#0F1A0F" BorderBrush="#1F3A1F" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CheckCircleOutline}"
                                                 Width="18" Height="18" Foreground="#4ADE80"
                                                 VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ComfyUI je nainstalovaný a připravený"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#86EFAC"/>
                                    <TextBlock Text="Po dokončení průvodce se spustí automaticky"
                                               FontSize="11" Foreground="#5a8a5a"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tlačítko Install -->
                        <StackPanel IsVisible="{Binding ShowComfyInstallButton}" Spacing="10">
                            <Button Classes="primary"
                                    Command="{Binding StartComfyInstallCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="0,12" CornerRadius="9" FontSize="13">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}"
                                                     Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nainstalovat ComfyUI automaticky" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Chyba předchozího pokusu -->
                            <Border IsVisible="{Binding HasComfyInstallError}"
                                    Background="#1A0E0E" BorderBrush="#3A1A1A" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertCircleOutline}"
                                                     Width="14" Height="14" Foreground="#EF4444"
                                                     VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding ComfyInstallError}"
                                               FontSize="11" Foreground="#FCA5A5"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Progress panel -->
                        <StackPanel IsVisible="{Binding ShowComfyInstallProgress}" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ComfyInstallStatus}"
                                           FontSize="12" Foreground="#C4B5FD"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ComfyInstallSpeed}"
                                           FontSize="11" Foreground="#7c7398"/>
                            </Grid>
                            <ProgressBar Value="{Binding ComfyInstallPercent}"
                                         Minimum="0" Maximum="100"
                                         Height="6" CornerRadius="3"
                                         Foreground="#7C3AED"
                                         Background="#1F1B3D"/>
                            <Button Classes="secondary"
                                    Command="{Binding CancelComfyInstallCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="10,5">
                                <TextBlock Text="Zrušit instalaci" FontSize="11"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Info — co to obnáší -->
                <Border Margin="0,16,0,0"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,11"
                        IsVisible="{Binding !IsComfyInstalled}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.InformationOutline}"
                                             Width="14" Height="14" VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Co se nainstaluje:"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Margin="22,0,0,0">
                            <Run Text="• ComfyUI Portable (Windows + NVIDIA) přímo z GitHubu autora"/>
                            <LineBreak/>
                            <Run Text="• Embedded Python 3.11 (žádná systémová instalace nezasáhne vaše prostředí)"/>
                            <LineBreak/>
                            <Run Text="• Custom node ComfyUI-GGUF pro FLUX kvantizace"/>
                            <LineBreak/>
                            <Run Text="• Cílová složka: "/>
                            <Run Text="{Binding ComfyInstallDir}" FontFamily="Consolas,monospace"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                           TextWrapping="Wrap"
                           Text="Pokud krok přeskočíte, generování obrázků nebude dostupné dokud ComfyUI ručně nezapnete v Nastavení."/>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 5: Doporučené modely ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep5}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="Doporučené modely" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           LineHeight="22" TextWrapping="Wrap"
                           Text="Vybereme za vás jeden chat model a jeden generátor obrázků. Po dokončení průvodce se začnou stahovat na pozadí — vidět budou v sekci Modely."/>

                <!-- Karty modelů -->
                <ItemsControl Margin="0,24,0,0"
                              ItemsSource="{Binding RecommendedModelChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FirstRunWizardViewModel+RecommendedModelChoice">
                            <Border Margin="0,0,0,12"
                                    Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"/>

                                    <!-- Detail -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Model.Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextLightBrush}"/>
                                            <Border Background="#1A1228" CornerRadius="4" Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           FontSize="10" Foreground="#A78BFA"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Model.Description}"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Velikost -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeLabel}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextLightBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="ke stažení"
                                                   FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Info pruh -->
                <Border Margin="0,8,0,0"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,11">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.InformationOutline}"
                                         Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                Modely se stáhnou na pozadí <Run FontWeight="SemiBold" Text="po dokončení průvodce"/>. Aplikace bude fungovat — během stahování vidíte progres v sekci Modely.
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                       TextWrapping="Wrap"
                                       Text="Tip: krok lze přeskočit a stáhnout si modely sami z Modely → Doporučené."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══ KROK 6: Hotovo ═══ -->
            <ScrollViewer IsVisible="{Binding IsStep6}" Padding="40,32,40,16"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0" Spacing="0">
                <TextBlock Text="Vše je připraveno! 🎉" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Nastavení bylo uloženo. Tady je přehled:"/>

                <Border Margin="0,24,0,0" Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="12">

                        <!-- Složka modelů -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="16" Height="16" Foreground="#4ADE80"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Složka modelů"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SummaryModelsDir}"
                                           FontSize="11" Foreground="{DynamicResource TextLightBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>

                        <!-- GPU -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="16" Height="16" Foreground="#4ADE80"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Výpočetní prostředek"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding GpuSummaryLine}"
                                           FontSize="11" Foreground="{DynamicResource TextLightBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>

                        <!-- API tokeny -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="16" Height="16" Foreground="#4ADE80"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="API tokeny"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="HuggingFace:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="nastaven ✓"  FontSize="11" Foreground="#4ADE80"
                                               IsVisible="{Binding HasHfToken}"/>
                                    <TextBlock Text="(nevyplněn)" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                               IsVisible="{Binding !HasHfToken}"/>
                                    <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource CardHoverBgBrush}" Margin="4,0"/>
                                    <TextBlock Text="Civitai:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="nastaven ✓"  FontSize="11" Foreground="#4ADE80"
                                               IsVisible="{Binding HasCivitaiKey}"/>
                                    <TextBlock Text="(nevyplněn)" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                               IsVisible="{Binding !HasCivitaiKey}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>

                        <!-- ComfyUI -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="16" Height="16" Foreground="#4ADE80"
                                       IsVisible="{Binding IsComfyInstalled}"
                                       VerticalAlignment="Center"/>
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Minus}" Width="16" Height="16"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       IsVisible="{Binding !IsComfyInstalled}"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="ComfyUI (generování obrázků)"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ComfySummaryLine}"
                                           FontSize="11" Foreground="{DynamicResource TextLightBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>

                        <!-- Doporučené modely -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Check}" Width="16" Height="16" Foreground="#4ADE80"
                                       IsVisible="{Binding HasSelectedRecommendedModels}"
                                       VerticalAlignment="Center"/>
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Minus}" Width="16" Height="16"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       IsVisible="{Binding !HasSelectedRecommendedModels}"
                                       VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Doporučené modely"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding RecommendedSummaryLine}"
                                           FontSize="11" Foreground="{DynamicResource TextLightBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Background="#0D150D"
                        BorderBrush="#14532D" BorderThickness="1"
                        CornerRadius="10" Padding="16,12">
                    <TextBlock FontSize="13" Foreground="#86EFAC"
                               TextWrapping="Wrap" LineHeight="22">
                        <Run Text="Nyní přejděte do "/>
                        <Run Text="Modely" FontWeight="SemiBold"/>
                        <Run Text=" a stáhněte svůj první GGUF model (doporučujeme Qwen3 14B nebo Llama 3.1 8B). Pak se vraťte na "/>
                        <Run Text="Chat" FontWeight="SemiBold"/>
                        <Run Text=" a začněte konverzovat. 🚀"/>
                    </TextBlock>
                </Border>
            </StackPanel>
            </ScrollViewer>

        </Panel>

        <!-- ── Tlačítka navigace ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="32,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <!-- Zpět -->
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        IsVisible="{Binding CanGoBack}"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="18,10"
                        FontSize="13" Foreground="{DynamicResource TextMutedBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ChevronLeft}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Zpět" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Přeskočit (jen kroky 1-3) -->
                <Button Grid.Column="1"
                        HorizontalAlignment="Left"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding !IsLastStep}"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,10" FontSize="12" Foreground="{DynamicResource CardHoverBgBrush}"
                        ToolTip.Tip="Tento krok přeskočit">
                    <TextBlock IsVisible="{Binding !IsStep0}" Text="Přeskočit"/>
                </Button>

                <!-- Pokračovat / Spustit -->
                <Button Grid.Column="2"
                        Classes="primary"
                        Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Padding="22,10" CornerRadius="9" FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding NextButtonText}"
                                   VerticalAlignment="Center"/>
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ChevronRight}" Width="14" Height="14" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsLastStep}"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>
