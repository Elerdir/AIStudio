<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.Lora"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             x:Class="AIStudio.App.Views.Lora.LoraLibraryPageView"
             x:DataType="vm:LoraLibraryPageViewModel">

    <UserControl.DataTemplates>
        <!-- Šablona pro jednu LoRA položku v hlavním seznamu -->
        <DataTemplate DataType="vm:LoraItemViewModel" x:DataType="vm:LoraItemViewModel">
            <Border Margin="0,0,14,8" CornerRadius="12" Padding="14"
                    Background="{DynamicResource CardBgBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                    <!-- Ikona LoRA -->
                    <Border Grid.Column="0"
                            Width="44" Height="44" CornerRadius="10"
                            Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="#3B2F5A" BorderThickness="1"
                            VerticalAlignment="Top">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Layers}"
                                         Width="22" Height="22"
                                         Foreground="{DynamicResource AccentLightBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>

                    <!-- Název, podsložka, velikost -->
                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}"/>
                        <WrapPanel>
                            <Border IsVisible="{Binding SubfolderLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Margin="0,0,6,0"
                                    Background="#1A1F2C" BorderBrush="#2A324A" BorderThickness="1"
                                    CornerRadius="4" Padding="7,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOutline}"
                                                     Width="11" Height="11"
                                                     Foreground="#7A8BB0"
                                                     VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SubfolderLabel}"
                                               FontSize="10" Foreground="#7A8BB0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,6,0"
                                    Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="7,2">
                                <TextBlock Text="{Binding SizeLabel}"
                                           FontSize="10" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                            <Border Margin="0,0,6,0"
                                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="7,2">
                                <TextBlock Text="{Binding Extension}"
                                           FontSize="10" Foreground="{DynamicResource TextHintBrush}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Pravá strana: akce -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Command="{Binding RevealCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="8" CornerRadius="6"
                                ToolTip.Tip="Zobrazit ve složce">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}"
                                             Width="18" Height="18"
                                             Foreground="{DynamicResource TextHintBrush}"/>
                        </Button>
                        <Button Command="{Binding DeleteCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="8" CornerRadius="6"
                                IsEnabled="{Binding !IsDeleting}"
                                ToolTip.Tip="Smazat soubor">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.TrashCanOutline}"
                                             Width="18" Height="18"
                                             Foreground="{DynamicResource ErrTextBrush}"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="28,22,28,16"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="LoRA" Classes="pageTitle"/>
                    <TextBlock Text="Knihovna stažených LoRA adapterů — použij je v Image Studiu pro úpravu stylu generování"
                               FontSize="12" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SummaryLabel}"
                               FontSize="11" Foreground="{DynamicResource TextWeakBrush}"
                               Margin="0,2,0,0"
                               IsVisible="{Binding SummaryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsLibraryTab}">
                    <Button Command="{Binding OpenLorasFolderCommand}"
                            Classes="secondary"
                            Padding="12,8"
                            ToolTip.Tip="{Binding LorasDirectoryPath}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Otevřít složku" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Classes="secondary"
                            Padding="12,8"
                            IsEnabled="{Binding !IsLoading}"
                            ToolTip.Tip="Znovu naskenovat složku">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Refresh}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab switcher: Knihovna / Trénovat -->
        <Border DockPanel.Dock="Top" Padding="28,8,28,0"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="tabBtn"
                        Classes.activeTab="{Binding IsLibraryTab}"
                        Command="{Binding SelectLibraryTabCommand}"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.LibraryShelves}"
                                         Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Knihovna" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="tabBtn"
                        Classes.activeTab="{Binding IsTrainingTab}"
                        Command="{Binding SelectTrainingTabCommand}"
                        Padding="14,10"
                        IsVisible="{Binding TrainingPane, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.School}"
                                         Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Trénovat" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="tabBtn"
                        Classes.activeTab="{Binding IsVideoTab}"
                        Command="{Binding SelectVideoTabCommand}"
                        Padding="14,10"
                        IsVisible="{Binding VideoLoraPane, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MovieOpenOutline}"
                                         Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Z videa" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Toolbar: search + status (jen v Knihovna tabu) -->
        <Border DockPanel.Dock="Top" Padding="28,12,28,12"
                IsVisible="{Binding IsLibraryTab}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Background="{DynamicResource SubtlePanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Magnify}"
                                         Width="16" Height="16"
                                         Foreground="{DynamicResource TextHintBrush}"
                                         VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchText}"
                                 PlaceholderText="Hledat LoRA podle názvu nebo podsložky…"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 PlaceholderForeground="{DynamicResource TextDisabledBrush}"
                                 MinWidth="320"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextHintBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
        </Border>

        <!-- Inline delete confirm strip (zobrazený když PendingDelete != null) -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}"
                Padding="28,12,28,12"
                Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <mi:MaterialIcon Grid.Column="0"
                                 Kind="{x:Static miKind:MaterialIconKind.AlertOutline}"
                                 Width="20" Height="20"
                                 Foreground="{DynamicResource ErrTextBrush}"
                                 VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Opravdu smazat tento LoRA soubor?"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PendingDelete.Name}"
                               FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding CancelDeleteCommand}"
                        Classes="secondary"
                        Padding="14,7"
                        Content="Zrušit"/>
                <Button Grid.Column="3"
                        Command="{Binding ConfirmDeleteCommand}"
                        Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                        Foreground="White"
                        Padding="14,7"
                        CornerRadius="8"
                        Content="Smazat"/>
            </Grid>
        </Border>

        <!-- Main content area: vyplní zbytek; obsah se přepíná podle aktivního tabu -->
        <Panel>

            <!-- ═══════════════════ TAB: KNIHOVNA ═══════════════════ -->
            <Grid IsVisible="{Binding IsLibraryTab}">

                <!-- Loading state -->
                <StackPanel IsVisible="{Binding IsLoading}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Loading}"
                                     Width="36" Height="36"
                                     Foreground="{DynamicResource TextHintBrush}"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="Načítám LoRA…"
                               FontSize="13"
                               Foreground="{DynamicResource TextHintBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Empty state — žádné LoRA v knihovně -->
                <StackPanel IsVisible="{Binding HasNoItems}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="440" Spacing="14">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="#3B2F5A" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Layers}"
                                         Width="30" Height="30"
                                         Foreground="{DynamicResource AccentLightBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Žádné LoRA"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextHintBrush}">
                        <Run Text="LoRA adaptery (.safetensors) si stáhni například z "/>
                        <Run Text="civitai.com" Foreground="{DynamicResource AccentLightBrush}"/>
                        <Run Text=" a ulož je do složky "/>
                        <Run Text="Models/loras/" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Run Text=" — pak klikni na Refresh. Nebo si vlastní natrénuj v tabu Trénovat."/>
                    </TextBlock>
                    <Button Command="{Binding OpenLorasFolderCommand}"
                            Classes="secondary"
                            Padding="14,8"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Otevřít složku Models/loras" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Empty state — filter nenašel nic -->
                <StackPanel IsVisible="{Binding HasNoMatches}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MagnifyClose}"
                                     Width="36" Height="36"
                                     Foreground="{DynamicResource TextDisabledBrush}"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="Žádná LoRA neodpovídá vyhledávání"
                               FontSize="13"
                               Foreground="{DynamicResource TextHintBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Seznam LoRA -->
                <ScrollViewer Padding="28,8,14,28"
                              IsVisible="{Binding FilteredItems.Count}">
                    <ItemsControl ItemsSource="{Binding FilteredItems}"/>
                </ScrollViewer>
            </Grid>

            <!-- ═══════════════════ TAB: TRÉNOVAT ═══════════════════
                 DataContext se přepíná až na vnitřním StackPanelu, aby IsVisible
                 binding na ScrollVieweru evaluoval IsTrainingTab z page VM, ne
                 z TrainingPane (kde by neexistoval = compile error AVLN2000). -->
            <Panel IsVisible="{Binding IsTrainingTab}">
              <DockPanel>

                <!-- ── Připnutý footer: Spustit/Zrušit + progress + výsledek ──
                     Dock=Bottom = vždy viditelné dole, ať je formulář jakkoliv
                     dlouhý. Scrolluje jen oblast nad footerem. Tím je primární
                     akce (Spustit trénink) vždy dosažitelná bez ohledu na počet
                     fotek v datasetu. -->
                <Border DockPanel.Dock="Bottom"
                        DataContext="{Binding TrainingPane}"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="28,12,28,16">
                  <StackPanel Spacing="10" MaxWidth="780" HorizontalAlignment="Left">

                    <!-- Result message (nad tlačítkem ať je vidět hned po dokončení) -->
                    <Border IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="{DynamicResource OkSurfaceBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                            </Style>
                        </Border.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CheckCircleOutline}"
                                             Width="18" Height="18"
                                             Foreground="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsResultSuccess}"
                                             VerticalAlignment="Center"/>
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertCircleOutline}"
                                             Width="18" Height="18"
                                             Foreground="{DynamicResource ErrTextBrush}"
                                             IsVisible="{Binding IsResultError}"
                                             VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ResultMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress (jen během tréninku) -->
                    <Border IsVisible="{Binding IsTraining}"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="#3B2F5A" BorderThickness="1"
                            CornerRadius="10" Padding="16,14">
                        <StackPanel Spacing="10">
                            <!-- Horní řádek: spinner + status + velká procenta -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <mi:MaterialIcon Grid.Column="0"
                                                 Kind="{x:Static miKind:MaterialIconKind.Loading}"
                                                 Width="18" Height="18"
                                                 Foreground="{DynamicResource AccentLightBrush}"
                                                 VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <!-- Inicializace: jasná hláška místo statického „Krok 0" -->
                                    <TextBlock Text="Inicializuji — načítám model do VRAM…"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextLightBrush}"
                                               IsVisible="{Binding IsInitializing}"/>
                                    <TextBlock Text="{Binding StatusLine}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextLightBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding !IsInitializing}"/>
                                    <TextBlock Text="{Binding LossLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               IsVisible="{Binding LossLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProgressPercentLabel}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLightBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Tlustší, výraznější progress bar -->
                            <ProgressBar Value="{Binding CurrentProgress}"
                                         Minimum="0" Maximum="100"
                                         Height="12" CornerRadius="6"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource CardBgBrush}"
                                         IsIndeterminate="{Binding IsInitializing}"/>
                            <!-- Spodní řádek: uplynulý / zbývající čas -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ElapsedLabel, StringFormat='Uplynulo: {0}'}"
                                           FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RemainingLabel}"
                                           FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                           IsVisible="{Binding RemainingLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Start / Cancel -->
                    <Grid ColumnDefinitions="*">
                        <Button Grid.Column="0"
                                Classes="primary"
                                IsVisible="{Binding IsIdle}"
                                IsEnabled="{Binding CanStartTraining}"
                                Command="{Binding StartTrainingCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Play}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Spustit trénink" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="0"
                                IsVisible="{Binding IsTraining}"
                                Command="{Binding CancelTrainingCommand}"
                                Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                                Foreground="White"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                CornerRadius="10" Padding="0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Stop}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Zrušit trénink" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                  </StackPanel>
                </Border>

                <!-- ── Scrollovatelný formulář (vyplní zbytek nad footerem) ── -->
                <ScrollViewer Padding="28,16,14,0"
                              VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="False"
                              Classes="visibleScrollbar">
                <StackPanel Spacing="20" MaxWidth="780" HorizontalAlignment="Left"
                            DataContext="{Binding TrainingPane}">

                    <!-- HW indikátor -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Gpu}"
                                                 Width="16" Height="16"
                                                 Foreground="{DynamicResource AccentLightBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HwInfoLabel}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HwWarningText}"
                                       FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HwWarningText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── 0a) Přepínač typu tréninku (SDXL / FLUX) ── -->
                    <StackPanel Spacing="8" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="TYP TRÉNINKU" Classes="sectionHeader"/>
                        <Border Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <StackPanel.Styles>
                                    <Style Selector="Button.seg">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="18,7"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                    <Style Selector="Button.seg.segActive">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </StackPanel.Styles>
                                <Button Classes="seg" Content="SDXL  ·  rychlé"
                                        Classes.segActive="{Binding IsSdxlType}"
                                        Command="{Binding SelectTrainingTypeCommand}" CommandParameter="SDXL"/>
                                <Button Classes="seg" Content="FLUX  ·  kvalita"
                                        Classes.segActive="{Binding IsFluxType}"
                                        Command="{Binding SelectTrainingTypeCommand}" CommandParameter="FLUX"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TrainingTypeGuidance}"
                                   FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ── 0) Doporučené modely (ke stažení v aplikaci) ── -->
                    <StackPanel Spacing="10" IsEnabled="{Binding IsIdle}"
                                IsVisible="{Binding IsDownloadSupported}">
                        <TextBlock Text="DOPORUČENÉ MODELY" Classes="sectionHeader"/>
                        <TextBlock Text="Jeden klik = stažení rovnou do Models/checkpoints/. Po dokončení se objeví v dropdownu níže."
                                   FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="0,-4,0,0"/>
                        <ItemsControl ItemsSource="{Binding FilteredRecommendedBaseModels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecommendedBaseModelViewModel">
                                    <Border Classes="card" Padding="14,10">
                                        <StackPanel Spacing="8">
                                            <!-- Hlavička: název + badges + akce -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="#3B2F5A" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ModelTypeLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource CardBgBrush}"
                                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource TextHintBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsDownloaded}">
                                                            <TextBlock Text="✓ Staženo" FontSize="10"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <!-- Akce: Stáhnout / Zrušit -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding DownloadCommand}"
                                                            Classes="primary"
                                                            Padding="12,6"
                                                            IsVisible="{Binding CanDownload}">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Download}"
                                                                             Width="13" Height="13" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Stáhnout" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding CancelCommand}"
                                                            Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                                                            Foreground="White"
                                                            CornerRadius="8" Padding="10,6"
                                                            IsVisible="{Binding IsDownloading}">
                                                        <TextBlock Text="Zrušit" FontSize="11"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress strip — viditelný jen při IsDownloading -->
                                            <StackPanel Spacing="4" IsVisible="{Binding IsDownloading}">
                                                <ProgressBar Value="{Binding DownloadProgress}"
                                                             Minimum="0" Maximum="100"
                                                             Height="4" CornerRadius="2"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             Background="{DynamicResource CardBgBrush}"/>
                                                <TextBlock Text="{Binding DownloadStatusLine}"
                                                           FontSize="10" Foreground="{DynamicResource TextHintBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ── 1) Pojmenování + base model ── -->
                    <StackPanel Spacing="10" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="1) ZÁKLADNÍ NASTAVENÍ" Classes="sectionHeader"/>
                        <Border Classes="card" Padding="16,14">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Název LoRA"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Základní model"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding TrainingName}"
                                         PlaceholderText="např. nikol_v1"
                                         Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8"
                                         Padding="12,8" FontSize="13"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableBaseModels}"
                                              SelectedItem="{Binding SelectedBaseModel}"
                                              PlaceholderText="-- vyber checkpoint --"
                                              Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8"
                                              Padding="12,8" FontSize="13"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="{Binding HasAvailableBaseModels}"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding BrowseBaseModelCommand}"
                                            Classes="secondary"
                                            Padding="10,8"
                                            ToolTip.Tip="Najít checkpoint jinde na disku">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderSearchOutline}"
                                                         Width="14" Height="14" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Pojmenuj LoRA bez .safetensors přípony"
                                           FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                           Margin="0,4,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="#3B2F5A" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2"
                                            IsVisible="{Binding BaseModelTypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding BaseModelTypeLabel}" FontSize="10"
                                                   Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding EstimatedTimeLabel, StringFormat='odhad {0}'}"
                                               FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding EstimatedTimeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Empty state: žádný checkpoint v Models/checkpoints/ -->
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                        IsVisible="{Binding !HasAvailableBaseModels}"
                                        Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertOutline}"
                                                             Width="14" Height="14"
                                                             Foreground="{DynamicResource WarningBrush}"
                                                             VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Žádný základní model nenalezen"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarnTextBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource WarnTextBrush}" TextWrapping="Wrap">
                                                    <Run Text="LoRA potřebuje základ — typicky "/>
                                                    <Run Text="SDXL Base 1.0" FontWeight="SemiBold"/>
                                                    <Run Text=", "/>
                                                    <Run Text="JuggernautXL" FontWeight="SemiBold"/>
                                                    <Run Text=" (foto), nebo "/>
                                                    <Run Text="Animagine XL 3.1" FontWeight="SemiBold"/>
                                                    <Run Text=" (anime)."/>
                                                    <LineBreak/>
                                                    <Run Text="Hledám v "/>
                                                    <Run Text="Models/checkpoints/" FontWeight="SemiBold"/>
                                                    <Run Text=" i v "/>
                                                    <Run Text="ComfyUI/models/checkpoints/" FontWeight="SemiBold"/>
                                                    <Run Text=" (kam stahuje Image Studio). Pro model na jiné cestě klikni na ikonku 🔍 vedle dropdownu."/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="22,0,0,0">
                                            <Button Command="{Binding RefreshBaseModelsCommand}"
                                                    Classes="secondary" Padding="10,5">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Refresh}"
                                                                     Width="12" Height="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Obnovit" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenCheckpointsFolderCommand}"
                                                    Classes="secondary" Padding="10,5">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}"
                                                                     Width="12" Height="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Otevřít složku" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── 2) Dataset ── -->
                    <StackPanel Spacing="10" IsEnabled="{Binding IsIdle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="2) DATASET" Classes="sectionHeader"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DatasetStatusLabel}"
                                           FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Command="{Binding AddImagesFromPickerCommand}"
                                        Classes="secondary" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Přidat" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Auto-caption: jen pokud je service dostupná a máme obrázky -->
                                <Button Command="{Binding GenerateCaptionsCommand}"
                                        Classes="secondary" Padding="10,5"
                                        IsVisible="{Binding IsCaptioningSupported}"
                                        IsEnabled="{Binding CanStartCaptioning}"
                                        ToolTip.Tip="Vygenerovat popisky automaticky (BLIP/WD14)">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.RobotHappyOutline}"
                                                         Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Auto-popisek" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearDatasetCommand}"
                                        Classes="secondary" Padding="10,5"
                                        IsEnabled="{Binding !HasNoDatasetItems}">
                                    <TextBlock Text="Vyčistit" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Caption progress strip — viditelný během captioningu -->
                        <Border IsVisible="{Binding IsCaptioning}"
                                Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CaptionStatusLabel}"
                                               FontSize="12" Foreground="{DynamicResource TextLightBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding CancelCaptioningCommand}"
                                            Classes="secondary" Padding="8,4">
                                        <TextBlock Text="Zrušit" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <ProgressBar Value="{Binding CaptionProgress}"
                                             Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"
                                             Foreground="{DynamicResource SuccessBrush}"
                                             Background="{DynamicResource CardBgBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Režim popisků: pro osobu/postavu trénovat jen na trigger token -->
                        <CheckBox IsChecked="{Binding TokenOnlyCaptions}"
                                  ToolTip.Tip="Popisky fotek se ignorují a nahradí se samotným názvem LoRA (trigger token). Pro LoRA na konkrétní osobu/postavu/obličej dává mnohem věrnější výsledek — identita se naváže na token, ne na popisná slova. Pro styl/koncept LoRA vypni.">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Trénovat jen na trigger token (osoba / postava / obličej)"
                                           FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="Doporučeno pro věrnost obličeje. Popisky se přepíšou na samotný název LoRA. Pro styl/koncept vypni."
                                           FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Velikost varování -->
                        <Border IsVisible="{Binding IsDatasetSizeWarning}"
                                Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AlertOutline}"
                                                 Width="14" Height="14" Foreground="{DynamicResource WarningBrush}"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DatasetSizeWarningText}"
                                           FontSize="11" Foreground="{DynamicResource WarnTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Drop zone — empty state -->
                        <Border IsVisible="{Binding HasNoDatasetItems}"
                                Name="DatasetDropZone"
                                Background="{DynamicResource SubtlePanelBgBrush}"
                                BorderBrush="#3B2F5A" BorderThickness="2"
                                CornerRadius="12" Padding="24,28"
                                MinHeight="160"
                                HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageMultipleOutline}"
                                                 Width="38" Height="38"
                                                 Foreground="{DynamicResource InfoTextBrush}"
                                                 HorizontalAlignment="Center"/>
                                <TextBlock Text="Přetáhni obrázky sem"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="…nebo klikni na ‚Přidat'. 15-30 fotek, různé úhly, dobré osvětlení."
                                           FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="320"/>
                            </StackPanel>
                        </Border>

                        <!-- Dataset items.
                             POZN: Vnořený ScrollViewer + MaxHeight zde POŽÍRAL kolečko
                             myši — vnější ScrollViewer training panu se nehnul a
                             uživatel se nedostal k tlačítku Spustit trénink. Odstraněno:
                             dataset roste přirozeně v hlavním scrollu (běžný UX pattern
                             pro dlouhé seznamy). -->
                        <Border IsVisible="{Binding !HasNoDatasetItems}"
                                Name="DatasetItemsPanel"
                                Background="{DynamicResource SubtlePanelBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="6">
                                <ItemsControl ItemsSource="{Binding DatasetItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LoraDatasetItemViewModel">
                                            <Border Margin="4" Padding="8" CornerRadius="8"
                                                    Background="{DynamicResource CardBgBrush}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- Thumbnail (nebo ikona placeholder dokud Bitmap nedorazí) -->
                                                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="6"
                                                            ClipToBounds="True" Background="{DynamicResource DeepPanelBgBrush}"
                                                            BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1">
                                                        <Panel>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasThumbnail}"/>
                                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}"
                                                                             Width="22" Height="22"
                                                                             Foreground="#3B2F5A"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             IsVisible="{Binding !HasThumbnail}"/>
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBox Text="{Binding Caption}"
                                                                 PlaceholderText="popisek pro trénink (např. young woman, beach)…"
                                                                 Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6"
                                                                 Padding="8,5" FontSize="11"
                                                                 MaxLength="500"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding RemoveCommand}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="6" Width="28" Height="28"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Odebrat z datasetu">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}"
                                                                         Width="14" Height="14"
                                                                         Foreground="{DynamicResource ErrTextBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ── 3) Parametry tréninku ── -->
                    <StackPanel Spacing="10" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="3) PARAMETRY TRÉNINKU" Classes="sectionHeader"/>

                        <!-- Presety jedním klikem — aktivní je zvýrazněný fialově -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="person"
                                    Classes="presetBtn"
                                    Classes.presetActive="{Binding IsPresetPerson}"
                                    ToolTip.Tip="Rank 32, 1500 kroků — pro konkrétní osobu / obličej (15-30 fotek)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AccountOutline}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Postava" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="style"
                                    Classes="presetBtn"
                                    Classes.presetActive="{Binding IsPresetStyle}"
                                    ToolTip.Tip="Rank 64, 2000 kroků, nižší LR — pro estetiku / umělecký styl">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.PaletteOutline}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Styl" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="quick"
                                    Classes="presetBtn"
                                    Classes.presetActive="{Binding IsPresetQuick}"
                                    ToolTip.Tip="Rank 16, jen 400 kroků (~2-3 min) — rychlé ověření, že trénink funguje">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FlashOutline}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rychlý test" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="vlastní" FontSize="11" Foreground="{DynamicResource TextHintBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       IsVisible="{Binding ActivePreset, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </StackPanel>

                        <Border Classes="card" Padding="16,14">
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rank"   FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Alpha"  FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Steps"  FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Batch"  FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>

                                <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding Rank}"      Minimum="4"  Maximum="128"  Increment="4"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Alpha}"     Minimum="1"  Maximum="128"  Increment="1"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Steps}"     Minimum="100" Maximum="10000" Increment="100"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding BatchSize}" Minimum="1"  Maximum="8"    Increment="1"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="Learning rate" FontSize="11" Foreground="{DynamicResource TextHintBrush}" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                           Text="Optimizer" FontSize="11" Foreground="{DynamicResource TextHintBrush}" Margin="0,8,0,0"/>

                                <NumericUpDown Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                               Value="{Binding LearningRate}"
                                               Minimum="0.00001" Maximum="0.01"
                                               Increment="0.00005"
                                               FormatString="0.000000"/>
                                <ComboBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding AvailableOptimizers}"
                                          SelectedItem="{Binding SelectedOptimizer}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8"
                                          Padding="10,6" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Spodní rezerva (uvnitř scrollovaného obsahu, ne ScrollViewer.Padding —
                         Avalonia kvirk: spodní padding se nezapočítá do scroll extentu).
                         Dělá mezeru mezi poslední sekcí (3 Parametry) a připnutým footerem
                         se Spustit/statusem, ať není nalepená na spodek. -->
                    <Border Height="28"/>

                </StackPanel>
              </ScrollViewer>

              </DockPanel>

              <!-- ═══════════ Code of Conduct overlay ═══════════
                   Zobrazí se při prvním pokusu o spuštění tréninku.
                   Po souhlasu se LoraTrainingCodeOfConductAccepted=true uloží
                   a další tréninky to už neprosí. -->
              <Border IsVisible="{Binding TrainingPane.IsCodeOfConductVisible}"
                      Background="#CC000000">
                  <Border DataContext="{Binding TrainingPane}"
                          MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Background="{DynamicResource CardBgBrush}"
                          BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                          CornerRadius="14" Padding="28,24">
                      <StackPanel Spacing="14">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                              <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ShieldCheckOutline}"
                                               Width="24" Height="24"
                                               Foreground="{DynamicResource AccentLightBrush}"
                                               VerticalAlignment="Center"/>
                              <TextBlock Text="Pravidla použití LoRA tréninku"
                                         FontSize="16" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextLightBrush}"
                                         VerticalAlignment="Center"/>
                          </StackPanel>

                          <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                     Foreground="{DynamicResource TextSecondaryBrush}">
                              <Run Text="Než natrénuješ vlastní LoRA, prosím přečti si:"/>
                              <LineBreak/><LineBreak/>
                              <Run Text="🔒 " /><Run Text="Trénink na fotky cizích osob" FontWeight="SemiBold"/>
                              <Run Text=" vyžaduje jejich souhlas. Trénovat na partnera/kamaráda bez vědomí je porušení soukromí a v ČR může být i trestné (GDPR, §84 OZ — ochrana osobnosti)."/>
                              <LineBreak/><LineBreak/>
                              <Run Text="🚫 " /><Run Text="Nikdy" FontWeight="SemiBold"/>
                              <Run Text=" netrénuj LoRA na nezletilé osoby, zesnulé bez souhlasu rodiny, nebo s cílem vytvářet pornografický / urážlivý obsah konkrétních lidí. Tohle je v mnoha zemích trestný čin."/>
                              <LineBreak/><LineBreak/>
                              <Run Text="✓ " /><Run Text="OK je" FontWeight="SemiBold"/>
                              <Run Text=" trénovat na sebe, na veřejně sdílené fotky se souhlasem, na fiktivní postavy, nebo na umělecké styly."/>
                              <LineBreak/><LineBreak/>
                              <Run Text="Plnou zodpovědnost za výsledky tréninku a jejich použití nese uživatel. AI Studio je jen nástroj a nemá kontrolu nad výstupy."/>
                          </TextBlock>

                          <Border Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                                  CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                  <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.InformationOutline}"
                                                   Width="14" Height="14"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                                  <TextBlock FontSize="11" Foreground="{DynamicResource WarnTextBrush}" TextWrapping="Wrap"
                                             Text="Tato pravidla potvrdíš jen jednou — pak už se nezobrazí."/>
                              </StackPanel>
                          </Border>

                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                              <Button Grid.Column="0"
                                      Classes="secondary"
                                      Command="{Binding DeclineCodeOfConductCommand}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                      Padding="0,10">
                                  <TextBlock Text="Nesouhlasím" FontSize="13"/>
                              </Button>
                              <Button Grid.Column="1"
                                      Classes="primary"
                                      Command="{Binding AcceptCodeOfConductCommand}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                      Padding="0,10">
                                  <TextBlock Text="Souhlasím a chci pokračovat" FontSize="13" FontWeight="SemiBold"/>
                              </Button>
                          </Grid>
                      </StackPanel>
                  </Border>
              </Border>

            </Panel>

            <!-- ═══════════════════ TAB: Z VIDEA ═══════════════════ -->
            <Panel IsVisible="{Binding IsVideoTab}">
              <Grid DataContext="{Binding VideoLoraPane}" x:DataType="vm:VideoLoraPaneViewModel"
                    RowDefinitions="Auto,*,Auto">

                <!-- ── Vstupní videa + volby + Analyzovat ── -->
                <Border Grid.Row="0" Margin="28,12,28,8" Padding="16" CornerRadius="12"
                        Background="{DynamicResource CardBgBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Z videí vytvoříš LoRA: vlož videa → Analyzovat → vyber snímky → předej do tréninku."
                                   FontSize="12" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"/>

                        <!-- Drop zóna -->
                        <Border x:Name="VideoDropZone"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="16" Background="{DynamicResource SubtlePanelBgBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MovieOpenOutline}"
                                                 Width="22" Height="22" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Přetáhni sem videa nebo" FontSize="12"
                                           Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                                <Button Classes="secondary" Padding="12,6"
                                        Command="{Binding AddVideosFromPickerCommand}">
                                    <TextBlock Text="Přidat videa" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Přidaná videa (chipy) -->
                        <ItemsControl ItemsSource="{Binding VideoPaths}" IsVisible="{Binding VideoCount}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Margin="0,0,8,8" CornerRadius="8" Padding="10,6"
                                            Background="{DynamicResource SubtlePanelBgBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Movie}" Width="14" Height="14"
                                                             Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="11" MaxWidth="220"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <Button Classes="secondary" Padding="4" Width="22" Height="22"
                                                    Command="{Binding $parent[ItemsControl].((vm:VideoLoraPaneViewModel)DataContext).RemoveVideoCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Odebrat">
                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Close}" Width="12" Height="12"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Volby -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Snímků / video" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <NumericUpDown Value="{Binding FramesPerVideo}" Minimum="1" Maximum="200" Increment="5"
                                               Width="120" FontSize="13"
                                               Background="{DynamicResource SubtlePanelBgBrush}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Název LoRA / trigger" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <TextBox Text="{Binding LoraName}" Width="200" FontSize="13"
                                         PlaceholderText="např. Nikol"
                                         Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="8" Padding="10,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Bottom">
                                <TextBlock Text="Osoba/postava (token-only)" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                <ToggleSwitch IsChecked="{Binding TokenOnlyCaptions}" OffContent="" OnContent=""/>
                            </StackPanel>
                        </Grid>

                        <!-- Analyzovat / průběh -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Grid.Column="0" Classes="primary" Padding="16,9"
                                    IsVisible="{Binding IsIdle}"
                                    IsEnabled="{Binding CanAnalyze}"
                                    Command="{Binding AnalyzeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Magnify}" Width="15" Height="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Analyzovat" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="0" Classes="secondary" Padding="16,9"
                                    IsVisible="{Binding IsAnalyzing}"
                                    Command="{Binding CancelAnalyzeCommand}">
                                <TextBlock Text="Zrušit" FontSize="13"/>
                            </Button>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding AnalyzeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding AnalyzeStatus}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Value="{Binding AnalyzeProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2" IsVisible="{Binding IsAnalyzing}"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource HoverBgBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Mřížka kandidátů ── -->
                <ScrollViewer Grid.Row="1" Padding="28,0,14,8"
                              VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
                    <Panel>
                        <TextBlock IsVisible="{Binding !HasCandidates}"
                                   Text="Zatím žádné snímky — vlož videa a klikni Analyzovat."
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextHintBrush}"/>
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CandidateFrameViewModel">
                                    <Border Width="200" Margin="0,0,12,12" CornerRadius="10"
                                            Background="{DynamicResource CardBgBrush}" ClipToBounds="True">
                                        <StackPanel>
                                            <Panel Height="128">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                       IsVisible="{Binding HasThumbnail}"/>
                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}"
                                                                 Width="28" Height="28" IsVisible="{Binding !HasThumbnail}"
                                                                 Foreground="{DynamicResource TextDisabledBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"/>
                                                <Border Background="#AA000000" CornerRadius="4" Padding="5,2"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                                    <TextBlock Text="{Binding TimestampLabel}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </Panel>
                                            <TextBox Text="{Binding Caption}" Margin="8" FontSize="11"
                                                     PlaceholderText="popisek…" MaxHeight="60" AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Background="{DynamicResource SubtlePanelBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                     BorderBrush="{DynamicResource AppBorderBrush}" CornerRadius="6"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>

                <!-- ── Footer: výběr + předání do tréninku ── -->
                <Border Grid.Row="2" Padding="28,12" IsVisible="{Binding HasCandidates}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource SubtlePanelBgBrush}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="secondary" Padding="10,7"
                                Command="{Binding SelectAllCommand}">
                            <TextBlock Text="Vybrat vše" FontSize="12"/>
                        </Button>
                        <Button Grid.Column="1" Classes="secondary" Padding="10,7"
                                Command="{Binding SelectNoneCommand}">
                            <TextBlock Text="Odznačit" FontSize="12"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding SelectedCountLabel}" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Classes="primary" Padding="16,9"
                                IsEnabled="{Binding CanUseForTraining}"
                                Command="{Binding UseForTrainingCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Použít vybrané do tréninku" FontSize="13" VerticalAlignment="Center"/>
                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ArrowRight}" Width="15" Height="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

              </Grid>
            </Panel>

        </Panel>

    </DockPanel>

</UserControl>
