<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.ImageStudio"
             xmlns:conv="using:AIStudio.App.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             xmlns:models="using:AIStudio.Core.Models"
             x:Class="AIStudio.App.Views.ImageStudio.ImageStudioPageView"
             x:DataType="vm:ImageStudioPageViewModel">

    <UserControl.Resources>
        <conv:AspectRatioLabelConverter x:Key="AspectRatioLabel"/>
        <conv:ImageQualityLabelConverter x:Key="QualityLabel"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,22,28,14"
                BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Image Studio" Classes="pageTitle"/>
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding AddGeneratorCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Nový generátor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── ComfyUI status bar ──────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#0A0A0C"
                BorderBrush="#2A2A2E"
                BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Status dot — Panel se čtyřmi Ellipsy, vždy právě jeden viditelný -->
                <Panel Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Fill="#4ADE80" IsVisible="{Binding ComfyRunning}"/>
                    <Ellipse Fill="#F59E0B" IsVisible="{Binding ComfyStarting}"/>
                    <Ellipse Fill="#EF4444" IsVisible="{Binding ComfyError}"/>
                    <Ellipse Fill="#444450" IsVisible="{Binding ComfyIdle}"/>
                </Panel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ComfyStatusMessage}"
                           FontSize="12"
                           Foreground="#888896"
                           VerticalAlignment="Center"/>

                <!-- Konfiguruj — když ComfyUI cesta není nastavená -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        IsVisible="{Binding !ComfyConfigured}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Cog}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Otevřít Nastavení" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Spustit — když je nakonfigurováno, ale neběží -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding StartComfyCommand}"
                        IsEnabled="{Binding !ComfyStarting}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ComfyConfigured"/>
                            <Binding Path="!ComfyRunning"/>
                        </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Play}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Spustit ComfyUI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Stop button (shown when running) -->
                <Button Grid.Column="3"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Background="#1A1010"
                        BorderBrush="#3A1515"
                        BorderThickness="1"
                        CornerRadius="8"
                        Command="{Binding StopComfyCommand}"
                        IsVisible="{Binding ComfyRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Power}" Width="14" Height="14" Foreground="#F87171" VerticalAlignment="Center"/>
                        <TextBlock Text="Zastavit" Foreground="#F87171" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Generator tabs ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#0F0F11"
                BorderBrush="#2A2A2E"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Generators}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageGeneratorViewModel">
                            <!-- Classes.active / Classes.inactive řídí vizuální styl tabu -->
                            <Border CornerRadius="8,8,0,0"
                                    Cursor="Hand"
                                    BorderThickness="1,1,1,0"
                                    Classes.active="{Binding IsActive}"
                                    Classes.inactive="{Binding !IsActive}">
                                <Border.Styles>
                                    <Style Selector="Border.active">
                                        <Setter Property="Background" Value="#111113"/>
                                        <Setter Property="BorderBrush" Value="#3A3A44"/>
                                    </Style>
                                    <Style Selector="Border.inactive">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Border.inactive:pointerover">
                                        <Setter Property="Background" Value="#0D0D0F"/>
                                        <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                    </Style>
                                    <!-- Název aktivního tabu světlejší -->
                                    <Style Selector="Border.active TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="#EBEBF5"/>
                                    </Style>
                                    <Style Selector="Border.inactive TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="#888896"/>
                                    </Style>
                                </Border.Styles>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,8,8,8"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.SelectGeneratorCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0"
                                                   Classes="tabTitle"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Foreground="#555560"
                                                FontSize="11"
                                                Content="✕"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.CloseGeneratorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Active generator ─────────────────────────────────────────────── -->
        <Grid Grid.Row="3" DataContext="{Binding ActiveGenerator}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left panel – controls ──────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="#111113"
                    BorderBrush="#2A2A2E"
                    BorderThickness="0,0,0,0">
                <Grid RowDefinitions="*,Auto">

                    <ScrollViewer Grid.Row="0" Padding="18,16,18,80">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- ── Přepínač Smart / Manuální ───────────────────── -->
                            <Border Background="#0F0F11"
                                    BorderBrush="#2A2A2E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <!-- Smart tlačítko -->
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,8"
                                            CornerRadius="7"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Command="{Binding SetSmartModeCommand}">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#888896"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsEnabled>
                                            <Binding Path="IsManualMode"/>
                                        </Button.IsEnabled>
                                        <Button.Background>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="IsSmartMode" Converter="{x:Static BoolConverters.Not}"/>
                                                <Binding Path="IsSmartMode" Converter="{x:Static BoolConverters.Not}"/>
                                            </MultiBinding>
                                        </Button.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AutoFix}" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Smart" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Manuální tlačítko -->
                                    <Button Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,8"
                                            CornerRadius="7"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Command="{Binding SetManualModeCommand}">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#888896"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </Button.Styles>
                                        <Button.IsEnabled>
                                            <Binding Path="IsSmartMode"/>
                                        </Button.IsEnabled>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.TuneVariant}" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Manuální" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ══ SMART MÓD — sekce jsou přímí potomci vnějšího StackPanelu ══ -->

                            <!-- Popis v češtině -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <TextBlock Text="POPIS OBRÁZKU" Classes="sectionHeader"/>
                                    <TextBox Text="{Binding CzechDescription}"
                                             PlaceholderText="Napiš co chceš vygenerovat, klidně česky…"
                                             AcceptsReturn="True"
                                             Height="120"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             Background="#1C1C1E"
                                             Foreground="#EBEBF5"
                                             BorderBrush="#2A2A2E"
                                             CornerRadius="10"
                                             Padding="12,10"
                                             FontSize="13"/>
                                </StackPanel>

                                <!-- Orientace — 3 tlačítka -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <TextBlock Text="ORIENTACE" Classes="sectionHeader"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"
                                          HorizontalAlignment="Stretch">
                                        <!-- Čtverec -->
                                        <Border Grid.Column="0"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationSquare}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="#1C1C1E"/>
                                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationSquareCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="20" Height="20"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Čtverec" FontSize="10" Foreground="#888896" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <!-- Na výšku -->
                                        <Border Grid.Column="1"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationPortrait}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="#1C1C1E"/>
                                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationPortraitCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="14" Height="20"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Na výšku" FontSize="10" Foreground="#888896" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <!-- Na šířku -->
                                        <Border Grid.Column="2"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationLandscape}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="#1C1C1E"/>
                                                    <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationLandscapeCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="20" Height="14"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Na šířku" FontSize="10" Foreground="#888896" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Referenční obrázky (smart verze — reference + slider) -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0"
                                                   Text="REFERENČNÍ OBRÁZEK (nepovinné)"
                                                   Classes="sectionHeader"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Padding="8,4"
                                                FontSize="11"
                                                Command="{Binding PickReferenceImageCommand}"
                                                ToolTip.Tip="Přidat referenční obrázek (styl, kompozice)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Přidat" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Prázdný stav -->
                                    <Border Background="#0F0F11"
                                            BorderBrush="#222228"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,12"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{Binding !HasReferenceImage}">
                                        <TextBlock Text="Bez reference — generuje se pouze z popisu"
                                                   FontSize="11"
                                                   Foreground="#444450"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Obrázky + slider -->
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch" IsVisible="{Binding HasReferenceImage}">
                                        <ItemsControl ItemsSource="{Binding ReferenceImagePaths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="#141416"
                                                            BorderBrush="#222228"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,6"
                                                            Margin="0,0,0,4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <mi:MaterialIcon Grid.Column="0"
                                                                       Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="14" Height="14"
                                                                       Foreground="#444450"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontSize="11"
                                                                       Foreground="#8888A0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding}"/>
                                                            <Button Grid.Column="2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="4,2"
                                                                    Foreground="#555560"
                                                                    FontSize="11"
                                                                    Content="✕"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ClearReferenceImageCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="Kreativní volnost"
                                                       FontSize="11"
                                                       Foreground="#555560"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="0 = drž se reference, 1 = jen inspirace"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ReferenceStrength, StringFormat={}{0:P0}}"
                                                       FontSize="11"
                                                       Foreground="#888896"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,2"
                                                    Foreground="#555560"
                                                    FontSize="10"
                                                    Content="✕ vše"
                                                    Command="{Binding ClearAllReferenceImagesCommand}"/>
                                        </Grid>
                                        <Slider Value="{Binding ReferenceStrength}"
                                                Minimum="0.0" Maximum="1.0"
                                                SmallChange="0.05"
                                                HorizontalAlignment="Stretch"
                                                Foreground="#7C3AED"/>
                                    </StackPanel>
                                </StackPanel>
                            <!-- ══ konec SMART MÓD sekcí ══════════════════════════ -->

                            <!-- ══ MANUÁLNÍ MÓD panel ════════════════════════════ -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsManualMode}">

                            <!-- Model -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="MODEL" Classes="sectionHeader"/>
                                <ComboBox ItemsSource="{Binding AvailableCheckpoints}"
                                          SelectedItem="{Binding SelectedModel}"
                                          HorizontalAlignment="Stretch"
                                          Background="#1C1C1E"
                                          Foreground="#EBEBF5"
                                          BorderBrush="#2A2A2E"
                                          CornerRadius="8"
                                          FontSize="13"
                                          PlaceholderText="Vybrat checkpoint…"/>
                            </StackPanel>

                            <!-- Prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding Prompt}"
                                         PlaceholderText="Popiš obrázek..."
                                         AcceptsReturn="True"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         Background="#1C1C1E"
                                         Foreground="#EBEBF5"
                                         BorderBrush="#2A2A2E"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Negative prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="NEGATIVNÍ PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding NegativePrompt}"
                                         PlaceholderText="Co nechceš na obrázku..."
                                         AcceptsReturn="True"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         Background="#1C1C1E"
                                         Foreground="#EBEBF5"
                                         BorderBrush="#2A2A2E"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Referenční obrázky (více) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="REFERENČNÍ OBRÁZKY"
                                               Classes="sectionHeader"
                                               VerticalAlignment="Center"/>
                                    <!-- Tlačítko Přidat vždy viditelné -->
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Padding="8,4"
                                            FontSize="11"
                                            Command="{Binding PickReferenceImageCommand}"
                                            ToolTip.Tip="Přidat jeden nebo více obrázků jako referenci">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Přidat" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Prázdný stav -->
                                <Border Background="#0F0F11"
                                        BorderBrush="#222228"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,16"
                                        IsVisible="{Binding !HasReferenceImage}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="22" Height="22"
                                                   Foreground="#333340"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Žádná reference — generuje se z promptu"
                                                   FontSize="11"
                                                   Foreground="#444450"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seznam obrázků -->
                                <ItemsControl ItemsSource="{Binding ReferenceImagePaths}"
                                              IsVisible="{Binding HasReferenceImage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="#141416"
                                                    BorderBrush="#222228"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,6"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Pořadí -->
                                                    <mi:MaterialIcon Grid.Column="0"
                                                               Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="16" Height="16"
                                                               Foreground="#444450"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <!-- Cesta — zkrácená -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="#8888A0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding}"/>
                                                    <!-- Odebrat -->
                                                    <Button Grid.Column="2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="6,2"
                                                            Foreground="#555560"
                                                            FontSize="11"
                                                            Content="✕"
                                                            ToolTip.Tip="Odebrat z reference"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ClearReferenceImageCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Slider kreativní volnost + tlačítko vymazat vše -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasReferenceImage}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Kreativní volnost"
                                                   FontSize="11"
                                                   Foreground="#555560"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="0 = výsledek blízký referenci&#10;1 = výsledek blízký promptu (reference jen inspiruje)"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ReferenceStrength, StringFormat={}{0:P0}}"
                                                   FontSize="11"
                                                   Foreground="#888896"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Foreground="#555560"
                                                FontSize="10"
                                                Content="✕ vše"
                                                ToolTip.Tip="Odebrat všechny reference"
                                                Command="{Binding ClearAllReferenceImagesCommand}"/>
                                    </Grid>
                                    <Slider Value="{Binding ReferenceStrength}"
                                            Minimum="0.0" Maximum="1.0"
                                            SmallChange="0.05"
                                            Foreground="#7C3AED"/>
                                    <TextBlock FontSize="10"
                                               Foreground="#3A3A44"
                                               TextWrapping="Wrap">
                                        <Run Text="Img2img: první obrázek jako základ, prompt řídí výsledek."/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- LoRA adaptery -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="LORA ADAPTERY"
                                               Classes="sectionHeader"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Padding="8,4"
                                            FontSize="11"
                                            Command="{Binding LoadLorasCommand}"
                                            ToolTip.Tip="Načíst dostupné LoRA soubory">
                                        ↻ Načíst
                                    </Button>
                                </Grid>

                                <!-- Řádek pro výběr a přidání LoRA -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableLoras}"
                                              SelectedItem="{Binding SelectedLoraToAdd}"
                                              HorizontalAlignment="Stretch"
                                              Background="#1C1C1E"
                                              Foreground="#EBEBF5"
                                              BorderBrush="#2A2A2E"
                                              CornerRadius="8"
                                              FontSize="12"
                                              PlaceholderText="Vybrat LoRA…"/>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding LoraStrength}"
                                                   Minimum="0.0" Maximum="2.0"
                                                   Increment="0.05"
                                                   FormatString="0.00"
                                                   Width="80"
                                                   FontSize="12"
                                                   ToolTip.Tip="Síla LoRA (1.0 = plný efekt)"/>
                                    <Button Grid.Column="2"
                                            Classes="secondary"
                                            Padding="8,4"
                                            FontSize="12"
                                            Command="{Binding AddLoraCommand}"
                                            ToolTip.Tip="Přidat LoRA do fronty">
                                        + Přidat
                                    </Button>
                                </Grid>

                                <!-- Aktivní LoRA seznam -->
                                <ItemsControl ItemsSource="{Binding SelectedLoras}"
                                              IsVisible="{Binding HasLoras}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LoraItem">
                                            <Border Background="#1C1C1E"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,2">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="#A78BFA"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="6,0"
                                                               FontSize="11"
                                                               Foreground="#888896"
                                                               VerticalAlignment="Center">
                                                        <Run Text="×"/>
                                                        <Run Text="{Binding StrengthModel, StringFormat='{}{0:0.00}'}"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="2"
                                                            Classes="secondary"
                                                            Padding="4,2"
                                                            FontSize="10"
                                                            Content="✕"
                                                            Command="{Binding $parent[UserControl].((vm:ImageGeneratorViewModel)DataContext).RemoveLoraCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Aspect ratio + quality -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POMĚR STRAN" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.AspectRatios}"
                                              SelectedItem="{Binding SelectedAspectRatio}"
                                              HorizontalAlignment="Stretch"
                                              Background="#1C1C1E"
                                              Foreground="#EBEBF5"
                                              BorderBrush="#2A2A2E"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AspectRatioLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="KVALITA" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.Qualities}"
                                              SelectedItem="{Binding SelectedQuality}"
                                              HorizontalAlignment="Stretch"
                                              Background="#1C1C1E"
                                              Foreground="#EBEBF5"
                                              BorderBrush="#2A2A2E"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource QualityLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Resolution preview -->
                            <Border Background="#141416" CornerRadius="8" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Rozlišení" FontSize="12" Foreground="#555560"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResolutionLabel}"
                                               FontSize="12" Foreground="#A78BFA" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Steps, CFG -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="KROKY" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Steps}"
                                                   Minimum="1" Maximum="150"
                                                   HorizontalAlignment="Stretch"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="CFG / GUIDANCE" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Cfg}"
                                                   Minimum="0" Maximum="20"
                                                   Increment="0.5"
                                                   HorizontalAlignment="Stretch"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Seed + Variants -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="SEED (-1 = náhodný)" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Seed}"
                                                   Minimum="-1" Maximum="2147483647"
                                                   HorizontalAlignment="Stretch"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        VerticalAlignment="Bottom"
                                        Padding="10,10"
                                        ToolTip.Tip="Náhodný seed"
                                        Command="{Binding RandomizeSeedCommand}">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Shuffle}" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POČET VARIANT" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding VariantCount}"
                                                   Minimum="1" Maximum="8"
                                                   HorizontalAlignment="Stretch"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            </StackPanel>
                            <!-- ══ konec MANUÁLNÍ MÓD ══════════════════════════ -->

                            <!-- Spacer na konci formuláře — zaručí, že poslední ovládací prvek
                                 má pod sebou rezervu i v případě, že ScrollViewer.Padding
                                 (Avalonia kvirk) extent správně nezahrne. -->
                            <Border Height="40"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Generate / Stop button row -->
                    <Border Grid.Row="1"
                            Padding="18,12"
                            BorderBrush="#2A2A2E"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">

                            <!-- Progress bar + status (visible while generating) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsGenerating}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GenerationStatus}"
                                               FontSize="11"
                                               Foreground="#888896"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GenerationProgress, StringFormat={}{0} %}"
                                               FontSize="11"
                                               Foreground="#666672"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <ProgressBar Value="{Binding GenerationProgress}"
                                             Minimum="0" Maximum="100"
                                             Height="3"
                                             Foreground="#7C3AED"
                                             Background="#222228"/>
                            </StackPanel>

                            <!-- Status text when idle (chyby, pre-flight hlášky atd.) -->
                            <!-- HorizontalAlignment=Stretch + TextAlignment=Center místo
                                 HorizontalAlignment=Center: jinak by se TextBlock smrsknul
                                 na natural width a delší texty (např. info o chybějících
                                 závislostech) by se ořezávaly. -->
                            <TextBlock Text="{Binding GenerationStatus}"
                                       FontSize="11"
                                       Foreground="#888896"
                                       IsVisible="{Binding !IsGenerating}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"/>

                            <Panel>
                                <!-- Generate -->
                                <Button Classes="primary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Command="{Binding GenerateCommand}"
                                        IsVisible="{Binding !IsGenerating}">
                                    <TextBlock Text="Generovat" FontSize="14" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Stop -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Background="#3A1515"
                                        BorderBrush="#6B2020"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Command="{Binding StopGenerationCommand}"
                                        IsVisible="{Binding IsGenerating}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Stop}" Width="16" Height="16" Foreground="#F87171" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zastavit" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F87171" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- ── Posuvná příčka ─────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#1A1A1E"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── Right panel – canvas / gallery ───────────────────────────── -->
            <Grid Grid.Column="2" Background="#0D0D0D" RowDefinitions="*,Auto">

                <!-- Main view area -->
                <Grid Grid.Row="0">

                    <!-- State A: Prázdný canvas, negeneruje se -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="!IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="52" Height="52"
                                   Foreground="#222228"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zatím žádný obrázek"
                                   FontSize="14"
                                   Foreground="#3A3A44"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zadej prompt a stiskni Generovat"
                                   FontSize="12"
                                   Foreground="#2A2A32"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State B: Prázdný canvas, generuje se (první obrázek) -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"
                                     Height="3"
                                     Foreground="#7C3AED"/>
                        <TextBlock Text="{Binding GenerationStatus}"
                                   FontSize="13"
                                   Foreground="#888896"
                                   MaxWidth="500"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State C: Existují obrázky — zobraz poslední + overlay při generování -->
                    <Grid IsVisible="{Binding HasGeneratedImages}" RowDefinitions="*,Auto">
                        <Border Grid.Row="0" Padding="24" Background="#0D0D0D">
                            <Image Source="{Binding LatestImage.FullBitmap}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>

                        <!-- Generating overlay over existing image -->
                        <Border Grid.Row="0"
                                Background="#88000000"
                                IsVisible="{Binding IsGenerating}">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <ProgressBar IsIndeterminate="True"
                                             Width="200"
                                             Height="3"
                                             Foreground="#7C3AED"/>
                                <TextBlock Text="{Binding GenerationStatus}"
                                           FontSize="13"
                                           Foreground="#EBEBF5"
                                           MaxWidth="500"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Image metadata bar -->
                        <Border Grid.Row="1"
                                Background="#0A0A0C"
                                BorderBrush="#1E1E24"
                                BorderThickness="0,1,0,0"
                                Padding="16,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  DataContext="{Binding LatestImage}">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Prompt}"
                                           FontSize="11"
                                           Foreground="#666672"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResolutionLabel}"
                                           FontSize="11"
                                           Foreground="#555560"
                                           Margin="12,0"
                                           VerticalAlignment="Center"/>
                                <!-- Copy prompt -->
                                <Button Grid.Column="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        ToolTip.Tip="Kopírovat prompt"
                                        Command="{Binding CopyPromptCommand}">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="16" Height="16" Foreground="#555560"/>
                                </Button>
                                <!-- Open in Explorer -->
                                <Button Grid.Column="3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        ToolTip.Tip="Otevřít ve Průzkumníku"
                                        Command="{Binding OpenInExplorerCommand}">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}" Width="16" Height="16" Foreground="#555560"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── Thumbnail strip ──────────────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#080809"
                        BorderBrush="#1E1E24"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        IsVisible="{Binding HasGeneratedImages}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="90">
                        <ItemsControl ItemsSource="{Binding GeneratedImages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GeneratedImageViewModel">
                                    <Border CornerRadius="6"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding TimeLabel}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected)">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected):pointerover">
                                                <Setter Property="BorderBrush" Value="#5B21B6"/>
                                            </Style>
                                        </Border.Styles>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.SelectImageCommand}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{Binding Thumbnail}"
                                                   Width="78"
                                                   Height="78"
                                                   Stretch="UniformToFill"/>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
