<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.ImageStudio"
             xmlns:conv="using:AIStudio.App.Converters"
             x:Class="AIStudio.App.Views.ImageStudio.ImageStudioPageView"
             x:DataType="vm:ImageStudioPageViewModel">

    <UserControl.Resources>
        <conv:AspectRatioLabelConverter x:Key="AspectRatioLabel"/>
        <conv:ImageQualityLabelConverter x:Key="QualityLabel"/>
        <conv:FileNameWithoutExtensionConverter x:Key="StripExt"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,22,28,14"
                BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Image Studio" Classes="pageTitle"/>
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding AddGeneratorCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Nový generátor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── ComfyUI status bar ──────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#0A0A0C"
                BorderBrush="#2A2A2E"
                BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Status dot — Panel se čtyřmi Ellipsy, vždy právě jeden viditelný -->
                <Panel Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Fill="#4ADE80" IsVisible="{Binding ComfyRunning}"/>
                    <Ellipse Fill="#F59E0B" IsVisible="{Binding ComfyStarting}"/>
                    <Ellipse Fill="#EF4444" IsVisible="{Binding ComfyError}"/>
                    <Ellipse Fill="#444450" IsVisible="{Binding ComfyIdle}"/>
                </Panel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ComfyStatusMessage}"
                           FontSize="12"
                           Foreground="#888896"
                           VerticalAlignment="Center"/>

                <!-- Konfiguruj — když ComfyUI cesta není nastavená -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        IsVisible="{Binding !ComfyConfigured}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Otevřít Nastavení" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Spustit — když je nakonfigurováno, ale neběží -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding StartComfyCommand}"
                        IsEnabled="{Binding !ComfyStarting}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ComfyConfigured"/>
                            <Binding Path="!ComfyRunning"/>
                        </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Spustit ComfyUI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Stop button (shown when running) -->
                <Button Grid.Column="3"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Background="#1A1010"
                        BorderBrush="#3A1515"
                        BorderThickness="1"
                        CornerRadius="8"
                        Command="{Binding StopComfyCommand}"
                        IsVisible="{Binding ComfyRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#F87171" VerticalAlignment="Center"/>
                        <TextBlock Text="Zastavit" Foreground="#F87171" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Generator tabs ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#0F0F11"
                BorderBrush="#2A2A2E"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Generators}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageGeneratorViewModel">
                            <!-- Classes.active / Classes.inactive řídí vizuální styl tabu -->
                            <Border CornerRadius="8,8,0,0"
                                    Cursor="Hand"
                                    BorderThickness="1,1,1,0"
                                    Classes.active="{Binding IsActive}"
                                    Classes.inactive="{Binding !IsActive}">
                                <Border.Styles>
                                    <Style Selector="Border.active">
                                        <Setter Property="Background" Value="#111113"/>
                                        <Setter Property="BorderBrush" Value="#3A3A44"/>
                                    </Style>
                                    <Style Selector="Border.inactive">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Border.inactive:pointerover">
                                        <Setter Property="Background" Value="#0D0D0F"/>
                                        <Setter Property="BorderBrush" Value="#2A2A2E"/>
                                    </Style>
                                    <!-- Název aktivního tabu světlejší -->
                                    <Style Selector="Border.active TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="#EBEBF5"/>
                                    </Style>
                                    <Style Selector="Border.inactive TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="#888896"/>
                                    </Style>
                                </Border.Styles>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,8,8,8"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.SelectGeneratorCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0"
                                                   Classes="tabTitle"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Foreground="#555560"
                                                FontSize="11"
                                                Content="✕"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.CloseGeneratorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Active generator ─────────────────────────────────────────────── -->
        <!-- Form column = 360 px (bylo 320) — dává Smart UI dost místa pro
             3-tlačítkový aspect picker bez stísnění. Canvas vpravo má přesto
             dost prostoru pro 1024×1024 obrázek. -->
        <Grid Grid.Row="3" ColumnDefinitions="360,*"
              DataContext="{Binding ActiveGenerator}">

            <!-- ── Left panel – controls ──────────────────────────────────── -->
            <!-- ClipToBounds=True kruciální: bez toho mohou Border s vnořeným
                 TextBoxem/Buttonem (které mají intrinsic measure logiku v FluentTheme)
                 vykreslit svůj obsah PŘES hranice form column, do canvas oblasti.
                 Tohle byla příčina „bubliny utíkají doprava" — měřily se širší než
                 sloupec a v default Avalonia chování renderovaly přes okraj. -->
            <Border Background="#111113"
                    BorderBrush="#2A2A2E"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Grid RowDefinitions="*,Auto" ClipToBounds="True">

                    <!-- ScrollViewer + horizontální clip přes Disabled, aby žádný child
                         nemohl horizontálně přesáhnout viewport (TextBox s placeholder
                         to dříve dělal). Vertikální scrollbar je default Auto. -->
                    <ScrollViewer Grid.Row="0" Padding="18,16,18,80"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                            <!-- Smart / Manual toggle — segmented switch nahoře, vždy viditelný.
                                 Name="ToggleAnchor" je sentinel: ostatní Smart UI elementy
                                 si přes Width="{Binding #ToggleAnchor.Bounds.Width}"
                                 vynucují přesně stejnou šířku. Avalonia StackPanel by JINAK
                                 měl všem children dát stejný arrange-rect, ale v praxi
                                 různé controls (Border, TextBox, FluentTheme Button) si
                                 do měření přimíchají vlastní MinWidth/Padding logiku
                                 a výsledné renderované šířky se mírně liší. -->
                            <Border Name="ToggleAnchor"
                                    Background="#0F0F11" BorderBrush="#1E1E22" BorderThickness="1"
                                    CornerRadius="8" Padding="3">
                                <Grid ColumnDefinitions="*,*">
                                    <Button Grid.Column="0" Classes="tabBtn"
                                            Classes.activeTab="{Binding IsSmartMode}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetSmartModeCommand}"
                                            CommandParameter="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Smart" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="tabBtn"
                                            Classes.activeTab="{Binding !IsSmartMode}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding SetSmartModeCommand}"
                                            CommandParameter="False">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Manuál" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ═══════════════════ SMART MODE ═══════════════════ -->
                            <StackPanel Spacing="14" IsVisible="{Binding IsSmartMode}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="POPIS OBRÁZKU" Classes="sectionHeader"/>
                                    <!-- Width pevně bound na ToggleAnchor — vynutí přesně
                                         stejnou šířku jako Smart/Manuál toggle. -->
                                    <Border Background="#1C1C1E" BorderBrush="#2A2A2E" BorderThickness="1"
                                            CornerRadius="8" MinHeight="100"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            Width="{Binding #ToggleAnchor.Bounds.Width}">
                                        <TextBox Classes="chatInputInner"
                                                 Text="{Binding SmartPrompt}"
                                                 PlaceholderText="Popíš obrázek česky nebo anglicky…"
                                                 Foreground="#EBEBF5"
                                                 CaretBrush="#A78BFA"
                                                 Padding="12,10"
                                                 FontSize="13"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinLines="3"
                                                 MaxLines="8"
                                                 MaxLength="2000"/>
                                    </Border>
                                    <!-- Hint pod bublinou — také pevně bound na ToggleAnchor,
                                         jinak by stejně jako bublina utíkal mimo viewport
                                         a TextWrapping=Wrap by se neuplatnil (text by měl
                                         k dispozici nekonečnou šířku). -->
                                    <TextBlock Text="Smart vybere model, přepíše prompt do angličtiny, doplní negative tagy. Aspect a kvalitu detekuje z popisu, dolaď je níž pokud chceš."
                                               FontSize="11" Foreground="#555560"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"
                                               Width="{Binding #ToggleAnchor.Bounds.Width}"/>
                                </StackPanel>

                                <!-- Aspect override — 3 ikony -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="POMĚR STRAN" Classes="sectionHeader"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"
                                          HorizontalAlignment="Left"
                                          Width="{Binding #ToggleAnchor.Bounds.Width}">
                                        <Button Grid.Column="0" Classes="tabBtn" Padding="0,10"
                                                Classes.activeTab="{Binding IsAspectSquare}"
                                                Command="{Binding SetAspectCommand}" CommandParameter="R1x1"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="◻" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Čtverec" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="tabBtn" Padding="0,10"
                                                Classes.activeTab="{Binding IsAspectLandscape}"
                                                Command="{Binding SetAspectCommand}" CommandParameter="R16x9"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="▭" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Šířka" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="tabBtn" Padding="0,10"
                                                Classes.activeTab="{Binding IsAspectPortrait}"
                                                Command="{Binding SetAspectCommand}" CommandParameter="R9x16"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="▯" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Výška" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Reference images — kompaktní verze pro Smart mód.
                                     Sdílí ReferenceImages collection a Pick/Remove commands
                                     s Manual módem; pipeline upload + workflow injection
                                     už multi-reference podporují (viz GenerateAsync). -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="REFERENČNÍ OBRÁZKY (volitelné)"
                                                   Classes="sectionHeader" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ReferenceImages.Count, StringFormat={}{0} ks}"
                                                   FontSize="10" Foreground="#444450"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasReferenceImages}"/>
                                    </Grid>

                                    <!-- Empty state — Width pevně bound na ToggleAnchor. -->
                                    <Button IsVisible="{Binding !HasReferenceImages}"
                                            HorizontalAlignment="Left"
                                            Width="{Binding #ToggleAnchor.Bounds.Width}"
                                            HorizontalContentAlignment="Center"
                                            Background="#141416" BorderBrush="#2A2A30" BorderThickness="1"
                                            CornerRadius="8" Padding="0,12"
                                            Command="{Binding PickReferenceImageCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="#666672"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Přidat referenční obrázky"
                                                           FontSize="11" Foreground="#888896"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    <!-- List vybraných — Width pevně bound na ToggleAnchor. -->
                                    <Border IsVisible="{Binding HasReferenceImages}"
                                            HorizontalAlignment="Left"
                                            Width="{Binding #ToggleAnchor.Bounds.Width}"
                                            Background="#141416" BorderBrush="#2A2A30" BorderThickness="1"
                                            CornerRadius="8" Padding="6">
                                        <StackPanel Spacing="6">
                                            <ScrollViewer MaxHeight="200"
                                                          VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ReferenceImages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReferenceImageItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                                              Margin="0,0,0,4">
                                                            <Border Grid.Column="0"
                                                                    Width="36" Height="36"
                                                                    CornerRadius="4"
                                                                    ClipToBounds="True"
                                                                    Background="#1C1C1E">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FileName}"
                                                                       FontSize="11" Foreground="#9999AA"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding Path}"/>
                                                            <Button Grid.Column="2"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="4" Width="22" Height="22"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    ToolTip.Tip="Odebrat"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.RemoveReferenceImageCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="9" Foreground="#F87171"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Přidat další + reference strength slider -->
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderBrush="#2A2A30" BorderThickness="1"
                                                    CornerRadius="6" Padding="0,6"
                                                    Command="{Binding PickReferenceImageCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Foreground="#888896"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Přidat další"
                                                               FontSize="11" Foreground="#888896"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <StackPanel Spacing="3" Margin="2,4,2,2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="Síla reference"
                                                               FontSize="10" Foreground="#666672"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ReferenceStrength, StringFormat={}{0:F2}}"
                                                               FontSize="10" Foreground="#A78BFA"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                                <Slider Value="{Binding ReferenceStrength}"
                                                        Minimum="0.0" Maximum="1.0"
                                                        TickFrequency="0"
                                                        IsSnapToTickEnabled="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Reasoning badge — Width pevně bound na ToggleAnchor. -->
                                <Border IsVisible="{Binding SmartReasoning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        HorizontalAlignment="Left"
                                        Width="{Binding #ToggleAnchor.Bounds.Width}"
                                        Background="#0F0E1C" BorderBrush="#1F1B3D" BorderThickness="1"
                                        CornerRadius="8" Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#A78BFA"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SmartReasoning}"
                                                   FontSize="11" Foreground="#A78BFA" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- Spinner při LLM parsování -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                            IsVisible="{Binding IsParsingIntent}">
                                    <ProgressBar IsIndeterminate="True" Width="180" Height="2"
                                                 Foreground="#7C3AED" Background="#222228"/>
                                    <TextBlock Text="Analyzuji popis…" FontSize="11" Foreground="#888896"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ═══════════════════ MANUÁL MODE ═══════════════════ -->
                            <!-- Stávající form schovaný pod tlačítkem „Manuál". V Smart módu zůstává
                                 v paměti, takže když Smart auto-vyplní pole, uživatel je v Manuálu
                                 přesně vidí — užitečné pro dolaďování po prvním návrhu. -->
                            <StackPanel Spacing="16" IsVisible="{Binding !IsSmartMode}">

                            <!-- Model -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="MODEL" Classes="sectionHeader"/>
                                <!-- ItemTemplate strippuje příponu pro display — uživatel vidí
                                     „flux1-schnell-Q4_K_S" místo „…gguf". SelectedItem ale
                                     drží plný name (s příponou), což ComfyUI potřebuje pro load. -->
                                <ComboBox ItemsSource="{Binding AvailableCheckpoints}"
                                          SelectedItem="{Binding SelectedModel}"
                                          HorizontalAlignment="Stretch"
                                          Background="#1C1C1E"
                                          Foreground="#EBEBF5"
                                          BorderBrush="#2A2A2E"
                                          CornerRadius="8"
                                          FontSize="13"
                                          PlaceholderText="Vybrat checkpoint…">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding Converter={StaticResource StripExt}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding Prompt}"
                                         PlaceholderText="Popiš obrázek..."
                                         AcceptsReturn="True"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         Background="#1C1C1E"
                                         Foreground="#EBEBF5"
                                         BorderBrush="#2A2A2E"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Negative prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="NEGATIVNÍ PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding NegativePrompt}"
                                         PlaceholderText="Co nechceš na obrázku..."
                                         AcceptsReturn="True"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         Background="#1C1C1E"
                                         Foreground="#EBEBF5"
                                         BorderBrush="#2A2A2E"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Reference images (multi) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="REFERENČNÍ OBRÁZKY" Classes="sectionHeader"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ReferenceImages.Count, StringFormat={}{0} ks}"
                                               FontSize="10" Foreground="#444450"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasReferenceImages}"/>
                                </Grid>

                                <!-- Empty state — žádný obrázek nepřidán -->
                                <Border Classes="card" Padding="12"
                                        IsVisible="{Binding !HasReferenceImages}">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="#333340"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="0,20"
                                            Command="{Binding PickReferenceImageCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xEB9F;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       Foreground="#444450"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Přidat referenční obrázky"
                                                       FontSize="12"
                                                       Foreground="#555560"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="(jeden i víc, Ctrl+klik pro multiselect)"
                                                       FontSize="10"
                                                       Foreground="#3A3A44"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- List vybraných obrázků -->
                                <Border Classes="card" Padding="8"
                                        IsVisible="{Binding HasReferenceImages}">
                                    <StackPanel Spacing="8">
                                        <ScrollViewer MaxHeight="220"
                                                      VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ReferenceImages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReferenceImageItem">
                                                    <Border Background="#141416" CornerRadius="6"
                                                            Padding="6" Margin="0,0,0,4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Grid.Column="0"
                                                                    Width="40" Height="40"
                                                                    CornerRadius="4"
                                                                    ClipToBounds="True"
                                                                    Background="#1C1C1E">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FileName}"
                                                                       FontSize="11" Foreground="#9999AA"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding Path}"/>
                                                            <Button Grid.Column="2"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="6" Width="26" Height="26"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Center"
                                                                    VerticalContentAlignment="Center"
                                                                    ToolTip.Tip="Odebrat"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.RemoveReferenceImageCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="10" Foreground="#F87171"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Tlačítko přidat další -->
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderBrush="#2A2A30"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="0,8"
                                                Command="{Binding PickReferenceImageCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" Foreground="#888896"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Přidat další"
                                                           FontSize="11" Foreground="#888896"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Slider síly reference (společný pro všechny) -->
                                        <StackPanel Spacing="4" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Síla reference"
                                                           FontSize="11" Foreground="#555560"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ReferenceStrength, StringFormat={}{0:P0}}"
                                                           FontSize="11" Foreground="#888896"/>
                                            </Grid>
                                            <Slider Value="{Binding ReferenceStrength}"
                                                    Minimum="0.1" Maximum="1.0"
                                                    SmallChange="0.05"
                                                    Foreground="#7C3AED"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Aspect ratio + quality -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POMĚR STRAN" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.AspectRatios}"
                                              SelectedItem="{Binding SelectedAspectRatio}"
                                              HorizontalAlignment="Stretch"
                                              Background="#1C1C1E"
                                              Foreground="#EBEBF5"
                                              BorderBrush="#2A2A2E"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AspectRatioLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="KVALITA" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.Qualities}"
                                              SelectedItem="{Binding SelectedQuality}"
                                              HorizontalAlignment="Stretch"
                                              Background="#1C1C1E"
                                              Foreground="#EBEBF5"
                                              BorderBrush="#2A2A2E"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource QualityLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Resolution preview -->
                            <Border Background="#141416" CornerRadius="8" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Rozlišení" FontSize="12" Foreground="#555560"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResolutionLabel}"
                                               FontSize="12" Foreground="#A78BFA" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Steps, CFG -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="KROKY" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Steps}"
                                                   Minimum="1" Maximum="150"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="CFG / GUIDANCE" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Cfg}"
                                                   Minimum="0" Maximum="20"
                                                   Increment="0.5"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Seed + Variants -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="SEED (-1 = náhodný)" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Seed}"
                                                   Minimum="-1" Maximum="2147483647"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        VerticalAlignment="Bottom"
                                        Padding="10,10"
                                        ToolTip.Tip="Náhodný seed"
                                        Command="{Binding RandomizeSeedCommand}">
                                    <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POČET VARIANT" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding VariantCount}"
                                                   Minimum="1" Maximum="8"
                                                   Background="#1C1C1E"
                                                   Foreground="#EBEBF5"
                                                   BorderBrush="#2A2A2E"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Spacer na konci formuláře — zaručí, že poslední ovládací prvek
                                 (POČET VARIANT + Seed) má pod sebou rezervu i v případě, že
                                 ScrollViewer.Padding (Avalonia kvirk) extent správně nezahrne. -->
                            <Border Height="100"/>

                            </StackPanel>  <!-- konec MANUAL wrap (IsSmartMode=false) -->

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Generate / Stop button row -->
                    <Border Grid.Row="1"
                            Padding="18,12"
                            BorderBrush="#2A2A2E"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">

                            <!-- Progress bar + status (visible while generating) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsGenerating}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GenerationStatus}"
                                               FontSize="11"
                                               Foreground="#888896"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GenerationProgress, StringFormat={}{0} %}"
                                               FontSize="11"
                                               Foreground="#666672"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <ProgressBar Value="{Binding GenerationProgress}"
                                             Minimum="0" Maximum="100"
                                             Height="3"
                                             Foreground="#7C3AED"
                                             Background="#222228"/>
                            </StackPanel>

                            <!-- Status text when idle (chyby, pre-flight hlášky atd.) -->
                            <!-- HorizontalAlignment=Stretch + TextAlignment=Center místo
                                 HorizontalAlignment=Center: jinak by se TextBlock smrsknul
                                 na natural width a delší texty (např. info o chybějících
                                 závislostech) by se ořezávaly. -->
                            <TextBlock Text="{Binding GenerationStatus}"
                                       FontSize="11"
                                       Foreground="#888896"
                                       IsVisible="{Binding !IsGenerating}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"/>

                            <Panel>
                                <!-- Generate — routed command podle IsSmartMode rozhodne,
                                     jestli se má použít Smart pipeline (intent parser →
                                     auto-fill → generování) nebo Manual (přímé spuštění
                                     s aktuálními poli). -->
                                <Button Classes="primary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Command="{Binding GenerateRoutedCommand}"
                                        IsVisible="{Binding !IsGenerating}">
                                    <TextBlock Text="Generovat" FontSize="14" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Stop -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Background="#3A1515"
                                        BorderBrush="#6B2020"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Command="{Binding StopGenerationCommand}"
                                        IsVisible="{Binding IsGenerating}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#F87171" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zastavit" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#F87171" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- ── Right panel – canvas / gallery ───────────────────────────── -->
            <Grid Grid.Column="1" Background="#0D0D0D" RowDefinitions="*,Auto">

                <!-- Main view area -->
                <Grid Grid.Row="0">

                    <!-- State A: Prázdný canvas, negeneruje se -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="!IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Text="&#xEB9F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="52"
                                   Foreground="#222228"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zatím žádný obrázek"
                                   FontSize="14"
                                   Foreground="#3A3A44"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zadej prompt a stiskni Generovat"
                                   FontSize="12"
                                   Foreground="#2A2A32"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State B: Prázdný canvas, generuje se (první obrázek) -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"
                                     Height="3"
                                     Foreground="#7C3AED"/>
                        <TextBlock Text="{Binding GenerationStatus}"
                                   FontSize="13"
                                   Foreground="#888896"
                                   MaxWidth="500"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State C: Existují obrázky — zobraz poslední + overlay při generování -->
                    <Grid IsVisible="{Binding HasGeneratedImages}" RowDefinitions="*,Auto">
                        <Border Grid.Row="0" Padding="24" Background="#0D0D0D">
                            <!-- FullBitmap = plná originální velikost (lazy). Bez toho by
                                 canvas zobrazoval 220 px thumbnail upscalovaný na ~700 px →
                                 rozmazaný. RenderOptions.BitmapInterpolationMode=HighQuality
                                 navíc použije ostřejší interpolation kernel pro downscale,
                                 takže 1024×1024 → 700×700 vypadá křišťálově. -->
                            <Image Source="{Binding LatestImage.FullBitmap}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>

                        <!-- Generating overlay over existing image -->
                        <Border Grid.Row="0"
                                Background="#88000000"
                                IsVisible="{Binding IsGenerating}">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <ProgressBar IsIndeterminate="True"
                                             Width="200"
                                             Height="3"
                                             Foreground="#7C3AED"/>
                                <TextBlock Text="{Binding GenerationStatus}"
                                           FontSize="13"
                                           Foreground="#EBEBF5"
                                           MaxWidth="500"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Image metadata bar — prompt + Model · Seed · Datum + akce -->
                        <Border Grid.Row="1"
                                Background="#0A0A0C"
                                BorderBrush="#1E1E24"
                                BorderThickness="0,1,0,0"
                                Padding="16,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6"
                                  DataContext="{Binding LatestImage}">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Prompt}"
                                               FontSize="11"
                                               Foreground="#888896"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Model}"
                                                   FontSize="10" Foreground="#555560"
                                                   IsVisible="{Binding Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="·" FontSize="10" Foreground="#3A3A44"
                                                   IsVisible="{Binding Model, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding Seed, StringFormat={}seed {0}}"
                                                   FontSize="10" Foreground="#555560"/>
                                        <TextBlock Text="·" FontSize="10" Foreground="#3A3A44"/>
                                        <TextBlock Text="{Binding FullDateLabel}"
                                                   FontSize="10" Foreground="#555560"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ResolutionLabel}"
                                           FontSize="11"
                                           Foreground="#A78BFA"
                                           FontWeight="SemiBold"
                                           Margin="12,0"
                                           VerticalAlignment="Center"/>
                                <!-- Copy prompt -->
                                <Button Grid.Column="2"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,4" CornerRadius="6"
                                        ToolTip.Tip="Kopírovat prompt"
                                        Command="{Binding CopyPromptCommand}">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#555560"/>
                                </Button>
                                <!-- Copy seed -->
                                <Button Grid.Column="3"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,4" CornerRadius="6"
                                        ToolTip.Tip="Kopírovat seed"
                                        Command="{Binding CopySeedCommand}">
                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#555560"/>
                                </Button>
                                <!-- Open in Explorer -->
                                <Button Grid.Column="4"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,4" CornerRadius="6"
                                        ToolTip.Tip="Otevřít v Průzkumníku"
                                        Command="{Binding OpenInExplorerCommand}">
                                    <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#555560"/>
                                </Button>
                                <!-- Delete -->
                                <Button Grid.Column="5"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,4" CornerRadius="6"
                                        ToolTip.Tip="Smazat obrázek"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.DeleteImageCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#7A4040"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── Thumbnail strip ──────────────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#080809"
                        BorderBrush="#1E1E24"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        IsVisible="{Binding HasGeneratedImages}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="90">
                        <ItemsControl ItemsSource="{Binding GeneratedImages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GeneratedImageViewModel">
                                    <Border CornerRadius="6"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding FullDateLabel}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected)">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected):pointerover">
                                                <Setter Property="BorderBrush" Value="#5B21B6"/>
                                            </Style>
                                        </Border.Styles>
                                        <!-- Kontextové menu (pravý klik) — Kopírovat prompt/seed,
                                             Otevřít v Explorer, Smazat. Delete je destruktivní,
                                             takže červený štítek nahoře vizuálně varuje. -->
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Kopírovat prompt"
                                                          Command="{Binding CopyPromptCommand}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Kopírovat seed"
                                                          Command="{Binding CopySeedCommand}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Otevřít v Průzkumníku"
                                                          Command="{Binding OpenInExplorerCommand}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Smazat"
                                                          Foreground="#F87171"
                                                          Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.DeleteImageCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12" Foreground="#F87171"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.SelectImageCommand}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{Binding Thumbnail}"
                                                   Width="78"
                                                   Height="78"
                                                   Stretch="UniformToFill"/>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
