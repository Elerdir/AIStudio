<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.ImageStudio"
             xmlns:controls="using:AIStudio.App.Views.ImageStudio"
             xmlns:conv="using:AIStudio.App.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             xmlns:models="using:AIStudio.Core.Models"
             x:Class="AIStudio.App.Views.ImageStudio.ImageStudioPageView"
             x:DataType="vm:ImageStudioPageViewModel">

    <UserControl.Resources>
        <conv:AspectRatioLabelConverter x:Key="AspectRatioLabel"/>
        <conv:ImageQualityLabelConverter x:Key="QualityLabel"/>
        <conv:FileNameWithoutExtensionConverter x:Key="FileNameNoExt"/>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{ReflectionBinding ActiveGenerator.CloseZoomCommand}"/>
    </UserControl.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,22,28,14"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Image Studio" Classes="pageTitle"/>
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding AddGeneratorCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Nový generátor" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── ComfyUI status bar ──────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource VeryDeepBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Status dot — Panel se čtyřmi Ellipsy, vždy právě jeden viditelný -->
                <Panel Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Fill="#4ADE80" IsVisible="{Binding ComfyRunning}"/>
                    <Ellipse Fill="#F59E0B" IsVisible="{Binding ComfyStarting}"/>
                    <Ellipse Fill="#EF4444" IsVisible="{Binding ComfyError}"/>
                    <Ellipse Fill="{DynamicResource TextDisabledBrush}" IsVisible="{Binding ComfyIdle}"/>
                </Panel>

                <TextBlock Grid.Column="1"
                           Text="{Binding ComfyStatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>

                <!-- Konfiguruj — když ComfyUI cesta není nastavená -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        IsVisible="{Binding !ComfyConfigured}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Cog}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Otevřít Nastavení" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Spustit — když je nakonfigurováno, ale neběží -->
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding StartComfyCommand}"
                        IsEnabled="{Binding !ComfyStarting}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ComfyConfigured"/>
                            <Binding Path="!ComfyRunning"/>
                        </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Play}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Spustit ComfyUI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Stop button (shown when running) -->
                <Button Grid.Column="3"
                        Padding="12,5"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Background="#1A1010"
                        BorderBrush="#3A1515"
                        BorderThickness="1"
                        CornerRadius="8"
                        Command="{Binding StopComfyCommand}"
                        IsVisible="{Binding ComfyRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Power}" Width="14" Height="14" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Zastavit" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── FLUX dependency download banner ────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#0D1018"
                BorderBrush="#1A2A3A"
                BorderThickness="0,0,0,1"
                Padding="20,7"
                IsVisible="{Binding FluxDownloading}">
            <Grid ColumnDefinitions="Auto,*,Auto,80">
                <!-- Ikona -->
                <mi:MaterialIcon Grid.Column="0"
                                 Kind="{x:Static miKind:MaterialIconKind.CloudDownloadOutline}"
                                 Width="14" Height="14"
                                 Foreground="#38BDF8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                <!-- Status text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding FluxDownloadStatus}"
                           FontSize="12"
                           Foreground="#7DD3FC"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Procenta -->
                <TextBlock Grid.Column="2"
                           FontSize="11"
                           Foreground="#38BDF8"
                           VerticalAlignment="Center"
                           Margin="10,0,8,0">
                    <Run Text="{Binding FluxDownloadPercent, StringFormat='{}{0:0.0}'}"/>
                    <Run Text="%"/>
                </TextBlock>
                <!-- Progress bar -->
                <ProgressBar Grid.Column="3"
                             Value="{Binding FluxDownloadPercent}"
                             Minimum="0" Maximum="100"
                             Height="4" CornerRadius="2"
                             Foreground="#0EA5E9"
                             Background="#1A2A3A"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Generator tabs ──────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource DeepPanelBgBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Generators}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageGeneratorViewModel">
                            <!-- Classes.active / Classes.inactive řídí vizuální styl tabu -->
                            <Border CornerRadius="8,8,0,0"
                                    Cursor="Hand"
                                    BorderThickness="1,1,1,0"
                                    Classes.active="{Binding IsActive}"
                                    Classes.inactive="{Binding !IsActive}">
                                <Border.Styles>
                                    <Style Selector="Border.active">
                                        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBgBrush}"/>
                                    </Style>
                                    <Style Selector="Border.inactive">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Border.inactive:pointerover">
                                        <Setter Property="Background" Value="#0D0D0F"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                    </Style>
                                    <!-- Název aktivního tabu světlejší -->
                                    <Style Selector="Border.active TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                    <Style Selector="Border.inactive TextBlock.tabTitle">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    </Style>
                                </Border.Styles>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="14,8,8,8"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.SelectGeneratorCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0"
                                                   Classes="tabTitle"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Foreground="{DynamicResource TextWeakBrush}"
                                                FontSize="11"
                                                Content="✕"
                                                Command="{ReflectionBinding $parent[UserControl].DataContext.CloseGeneratorCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Active generator ─────────────────────────────────────────────── -->
        <Grid Grid.Row="4" DataContext="{Binding ActiveGenerator}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left panel – controls ──────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,0">
                <Grid RowDefinitions="*,Auto">

                    <ScrollViewer Grid.Row="0" Padding="18,16,0,0"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" MaxWidth="284">

                            <!-- ── Přepínač Smart / Manuální ───────────────────── -->
                            <Border Background="{DynamicResource DeepPanelBgBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <!-- Smart tlačítko -->
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,8"
                                            CornerRadius="8"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Command="{Binding SetSmartModeCommand}"
                                            Classes.activeToggle="{Binding IsSmartMode}"
                                            Classes.inactiveToggle="{Binding IsManualMode}">
                                        <Button.Styles>
                                            <Style Selector="Button.activeToggle">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button.activeToggle /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#2A1F5A"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="Button.activeToggle:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#2A1F5A"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextWeakBrush}"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.AutoFix}" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Smart" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Manuální tlačítko -->
                                    <Button Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="0,8"
                                            CornerRadius="8"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Command="{Binding SetManualModeCommand}"
                                            Classes.activeToggle="{Binding IsManualMode}"
                                            Classes.inactiveToggle="{Binding IsSmartMode}">
                                        <Button.Styles>
                                            <Style Selector="Button.activeToggle">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button.activeToggle /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#2A1F5A"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="Button.activeToggle:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#2A1F5A"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextWeakBrush}"/>
                                            </Style>
                                            <Style Selector="Button.inactiveToggle:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            </Style>
                                        </Button.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.TuneVariant}" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Manuální" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ══ SMART MÓD — sekce jsou přímí potomci vnějšího StackPanelu ══ -->

                            <!-- Info banner: Smart mód bez LLM -->
                            <Border Background="#1A140A"
                                    BorderBrush="#4A3010"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    IsVisible="{Binding IsSmartModeWithoutLlm}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.InformationOutline}"
                                                     Width="14" Height="14"
                                                     Foreground="#D97706"
                                                     VerticalAlignment="Top"
                                                     Margin="0,1,0,0"/>
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="#B45309"
                                               MaxWidth="240">
                                        <Run Text="LLM model není načten — popis bude použit přímo jako prompt (bez překladu do angličtiny). Načti model v "/>
                                        <Run Text="Chatu" FontWeight="SemiBold"/>
                                        <Run Text=" pro plný Smart mód."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Model (Smart) — sdílený control, viz ModelPickerControl.axaml -->
                            <controls:ModelPickerControl IsVisible="{Binding IsSmartMode}"/>

                            <!-- Popis v češtině -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <TextBlock Text="POPIS OBRÁZKU" Classes="sectionHeader"/>
                                    <TextBox Text="{Binding CzechDescription}"
                                             PlaceholderText="Napiš co chceš vygenerovat, klidně česky…"
                                             AcceptsReturn="True"
                                             Height="120"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             Background="{DynamicResource CardBgBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource AppBorderBrush}"
                                             BorderThickness="1"
                                             CornerRadius="10"
                                             Padding="12,10"
                                             FontSize="13"/>
                                </StackPanel>

                                <!-- Negativní prompt (Smart) — volitelný -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <TextBlock Text="NEGATIVNÍ PROMPT" Classes="sectionHeader"/>
                                    <TextBox Text="{Binding NegativePrompt}"
                                             PlaceholderText="Co nechceš na obrázku (volitelné)…"
                                             AcceptsReturn="True"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             Background="{DynamicResource CardBgBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource AppBorderBrush}"
                                             BorderThickness="1"
                                             CornerRadius="10"
                                             Padding="12,10"
                                             FontSize="13"/>
                                </StackPanel>

                                <!-- Orientace — 3 tlačítka -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsSmartMode}">
                                    <TextBlock Text="ORIENTACE" Classes="sectionHeader"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"
                                          HorizontalAlignment="Stretch">
                                        <!-- Čtverec -->
                                        <Border Grid.Column="0"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationSquare}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationSquareCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="20" Height="20"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Čtverec" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <!-- Na výšku -->
                                        <Border Grid.Column="1"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationPortrait}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationPortraitCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="14" Height="20"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Na výšku" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <!-- Na šířku -->
                                        <Border Grid.Column="2"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Classes.activeOrientation="{Binding OrientationLandscape}">
                                            <Border.Styles>
                                                <Style Selector="Border.activeOrientation">
                                                    <Setter Property="Background" Value="#2A1F5A"/>
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                </Style>
                                                <Style Selector="Border:not(.activeOrientation)">
                                                    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Padding="6,10"
                                                    Command="{Binding SetOrientationLandscapeCommand}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Border Width="20" Height="14"
                                                            CornerRadius="2"
                                                            BorderThickness="1.5"
                                                            HorizontalAlignment="Center">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>
                                                    <TextBlock Text="Na šířku" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <!-- Referenční obrázky (smart verze — reference + slider) -->
                                <StackPanel x:Name="SmartRefArea"
                                            Spacing="6" HorizontalAlignment="Stretch" IsVisible="{Binding IsSmartMode}"
                                            DragDrop.AllowDrop="True">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0"
                                                   Text="REFERENČNÍ OBRÁZEK"
                                                   Classes="sectionHeader"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Padding="8,4"
                                                FontSize="11"
                                                Command="{Binding PickReferenceImageCommand}"
                                                ToolTip.Tip="Přidat referenční obrázek (styl, kompozice)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Přidat" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Prázdný stav / drop zone -->
                                    <Border Background="{DynamicResource DeepPanelBgBrush}"
                                            BorderBrush="{DynamicResource HoverBgBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            HorizontalAlignment="Stretch"
                                            IsVisible="{Binding !HasReferenceImage}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="3">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImagePlus}"
                                                       Width="20" Height="20"
                                                       Foreground="{DynamicResource ElevatedBgBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Přetáhni obrázek sem nebo klikni Přidat"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Obrázky + slider -->
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch" IsVisible="{Binding HasReferenceImage}">
                                        <ItemsControl ItemsSource="{Binding ReferenceImagePaths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Background="{DynamicResource SubtlePanelBgBrush}"
                                                            BorderBrush="{DynamicResource HoverBgBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,6"
                                                            Margin="0,0,0,4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <mi:MaterialIcon Grid.Column="0"
                                                                       Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="14" Height="14"
                                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontSize="11"
                                                                       Foreground="#8888A0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding}"/>
                                                            <Button Grid.Column="2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="4,2"
                                                                    Foreground="{DynamicResource TextWeakBrush}"
                                                                    FontSize="11"
                                                                    Content="✕"
                                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ClearReferenceImageCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="Kreativní volnost"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextWeakBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="0 = drž se reference, 1 = jen inspirace"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ReferenceStrength, StringFormat={}{0:P0}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,2"
                                                    Foreground="{DynamicResource TextWeakBrush}"
                                                    FontSize="10"
                                                    Content="✕ vše"
                                                    Command="{Binding ClearAllReferenceImagesCommand}"/>
                                        </Grid>
                                        <Slider Value="{Binding ReferenceStrength}"
                                                Minimum="0.0" Maximum="1.0"
                                                SmallChange="0.05"
                                                HorizontalAlignment="Stretch"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            <!-- LoRA adaptery (Smart) — sdílený control, viz LoraPickerControl.axaml -->
                            <controls:LoraPickerControl IsVisible="{Binding IsSmartMode}"/>

                            <!-- Upscale (Smart) — hires fix + ESRGAN -->
                            <CheckBox IsChecked="{Binding EnableUpscale}" IsVisible="{Binding IsSmartMode}"
                                      ToolTip.Tip="Po vygenerování proběhne hires fix (2. průchod modelu = víc detailu, pleť/vlasy/oči, hloubka) a ESRGAN upscaler (rozlišení + ostrost). Výsledek je ~2× větší. Je to pomalejší a při prvním použití se stáhne ~64 MB upscale model.">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Vylepšit kvalitu (upscale 2×)"
                                               FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                    <TextBlock Text="Hires fix + ESRGAN — víc detailu, hloubky a rozlišení. Pomalejší."
                                               FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- ══ konec SMART MÓD sekcí ══════════════════════════ -->

                            <!-- ══ MANUÁLNÍ MÓD panel ════════════════════════════ -->
                            <StackPanel Spacing="16" IsVisible="{Binding IsManualMode}">

                            <!-- Model (Manuál) — sdílený control, viz ModelPickerControl.axaml -->
                            <controls:ModelPickerControl/>

                            <!-- Prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding Prompt}"
                                         PlaceholderText="Popiš obrázek..."
                                         AcceptsReturn="True"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource CardBgBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Negative prompt -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="NEGATIVNÍ PROMPT" Classes="sectionHeader"/>
                                <TextBox Text="{Binding NegativePrompt}"
                                         PlaceholderText="Co nechceš na obrázku..."
                                         AcceptsReturn="True"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         Background="{DynamicResource CardBgBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         CornerRadius="10"
                                         Padding="12,10"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- Referenční obrázky (více) -->
                            <StackPanel x:Name="ManualRefArea"
                                        Spacing="6"
                                        DragDrop.AllowDrop="True">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="REFERENČNÍ OBRÁZKY"
                                               Classes="sectionHeader"
                                               VerticalAlignment="Center"/>
                                    <!-- Tlačítko Přidat vždy viditelné -->
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Padding="8,4"
                                            FontSize="11"
                                            Command="{Binding PickReferenceImageCommand}"
                                            ToolTip.Tip="Přidat jeden nebo více obrázků jako referenci">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Plus}" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Přidat" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Prázdný stav / drop zone -->
                                <Border Background="{DynamicResource DeepPanelBgBrush}"
                                        BorderBrush="{DynamicResource HoverBgBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,16"
                                        IsVisible="{Binding !HasReferenceImage}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImagePlus}" Width="22" Height="22"
                                                   Foreground="{DynamicResource ElevatedBgBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Přetáhni obrázky sem nebo klikni Přidat"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seznam obrázků -->
                                <ItemsControl ItemsSource="{Binding ReferenceImagePaths}"
                                              IsVisible="{Binding HasReferenceImage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{DynamicResource SubtlePanelBgBrush}"
                                                    BorderBrush="{DynamicResource HoverBgBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,6"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Pořadí -->
                                                    <mi:MaterialIcon Grid.Column="0"
                                                               Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="16" Height="16"
                                                               Foreground="{DynamicResource TextDisabledBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <!-- Cesta — zkrácená -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="#8888A0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding}"/>
                                                    <!-- Odebrat -->
                                                    <Button Grid.Column="2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="6,2"
                                                            Foreground="{DynamicResource TextWeakBrush}"
                                                            FontSize="11"
                                                            Content="✕"
                                                            ToolTip.Tip="Odebrat z reference"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ClearReferenceImageCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Slider kreativní volnost + tlačítko vymazat vše -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasReferenceImage}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Kreativní volnost"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextWeakBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="0 = výsledek blízký referenci&#10;1 = výsledek blízký promptu (reference jen inspiruje)"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ReferenceStrength, StringFormat={}{0:P0}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Foreground="{DynamicResource TextWeakBrush}"
                                                FontSize="10"
                                                Content="✕ vše"
                                                ToolTip.Tip="Odebrat všechny reference"
                                                Command="{Binding ClearAllReferenceImagesCommand}"/>
                                    </Grid>
                                    <Slider Value="{Binding ReferenceStrength}"
                                            Minimum="0.0" Maximum="1.0"
                                            SmallChange="0.05"
                                            Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource CardHoverBgBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="Img2img: první obrázek jako základ, prompt řídí výsledek."/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- LoRA adaptery (Manuál) — sdílený control, viz LoraPickerControl.axaml -->
                            <controls:LoraPickerControl/>

                            <!-- Upscale (Manuál) — hires fix + ESRGAN -->
                            <CheckBox IsChecked="{Binding EnableUpscale}"
                                      ToolTip.Tip="Po vygenerování proběhne hires fix (2. průchod modelu = víc detailu, pleť/vlasy/oči, hloubka) a ESRGAN upscaler (rozlišení + ostrost). Výsledek je ~2× větší. Je to pomalejší a při prvním použití se stáhne ~64 MB upscale model.">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Vylepšit kvalitu (upscale 2×)"
                                               FontSize="12" Foreground="{DynamicResource TextLightBrush}"/>
                                    <TextBlock Text="Hires fix + ESRGAN — víc detailu, hloubky a rozlišení. Pomalejší."
                                               FontSize="10" Foreground="{DynamicResource TextHintBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- Aspect ratio + quality -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POMĚR STRAN" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.AspectRatios}"
                                              SelectedItem="{Binding SelectedAspectRatio}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource CardBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource AspectRatioLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="KVALITA" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.Qualities}"
                                              SelectedItem="{Binding SelectedQuality}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource CardBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}"
                                              CornerRadius="8"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource QualityLabel}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Resolution preview -->
                            <Border Background="{DynamicResource SubtlePanelBgBrush}" CornerRadius="8" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Rozlišení" FontSize="12" Foreground="{DynamicResource TextWeakBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResolutionLabel}"
                                               FontSize="12" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>

                            <!-- Steps, CFG -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="KROKY" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Steps}"
                                                   Minimum="1" Maximum="150"
                                                   HorizontalAlignment="Stretch"
                                                   Background="{DynamicResource CardBgBrush}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   BorderBrush="{DynamicResource AppBorderBrush}"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="CFG / GUIDANCE" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Cfg}"
                                                   Minimum="0" Maximum="20"
                                                   Increment="0.5"
                                                   HorizontalAlignment="Stretch"
                                                   Background="{DynamicResource CardBgBrush}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   BorderBrush="{DynamicResource AppBorderBrush}"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sampler + Scheduler -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="SAMPLER" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.Samplers}"
                                              SelectedItem="{Binding SelectedSampler}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource CardBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}"
                                              CornerRadius="8"
                                              FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="SCHEDULER" Classes="sectionHeader"/>
                                    <ComboBox ItemsSource="{x:Static vm:ImageGeneratorViewModel.Schedulers}"
                                              SelectedItem="{Binding SelectedScheduler}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource CardBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}"
                                              CornerRadius="8"
                                              FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Seed + Variants -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="SEED (-1 = náhodný)" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding Seed}"
                                                   Minimum="-1" Maximum="2147483647"
                                                   HorizontalAlignment="Stretch"
                                                   Background="{DynamicResource CardBgBrush}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   BorderBrush="{DynamicResource AppBorderBrush}"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        VerticalAlignment="Bottom"
                                        Padding="10,10"
                                        ToolTip.Tip="Náhodný seed"
                                        Command="{Binding RandomizeSeedCommand}">
                                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Shuffle}" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="POČET VARIANT" Classes="sectionHeader"/>
                                    <NumericUpDown Value="{Binding VariantCount}"
                                                   Minimum="1" Maximum="8"
                                                   HorizontalAlignment="Stretch"
                                                   Background="{DynamicResource CardBgBrush}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   BorderBrush="{DynamicResource AppBorderBrush}"
                                                   CornerRadius="8"
                                                   FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            </StackPanel>
                            <!-- ══ konec MANUÁLNÍ MÓD ══════════════════════════ -->

                            <!-- Spodní rezerva MUSÍ být uvnitř scrollovaného obsahu, ne jako
                                 ScrollViewer.Padding (Avalonia kvirk: spodní padding se nezapočítá
                                 do scroll extentu → poslední prvek nedosažitelný v malém okně).
                                 Tenhle spacer je součást extentu, takže poslední ovládací prvek
                                 (upscale checkbox / počet variant) jde vždy doscrollovat. -->
                            <Border Height="48"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Generate / Stop button row -->
                    <Border Grid.Row="1"
                            Padding="18,12"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">

                            <!-- Progress bar + status (visible while generating) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsGenerating}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GenerationStatus}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GenerationProgress, StringFormat={}{0} %}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextHintBrush}"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <ProgressBar Value="{Binding GenerationProgress}"
                                             Minimum="0" Maximum="100"
                                             Height="3"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource HoverBgBrush}"/>
                            </StackPanel>

                            <!-- Status text when idle (chyby, pre-flight hlášky atd.) -->
                            <!-- HorizontalAlignment=Stretch + TextAlignment=Center místo
                                 HorizontalAlignment=Center: jinak by se TextBlock smrsknul
                                 na natural width a delší texty (např. info o chybějících
                                 závislostech) by se ořezávaly. -->
                            <TextBlock Text="{Binding GenerationStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding !IsGenerating}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"/>

                            <Panel>
                                <!-- Generate -->
                                <Button Classes="primary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Command="{Binding GenerateCommand}"
                                        IsVisible="{Binding !IsGenerating}">
                                    <TextBlock Text="Generovat" FontSize="14" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Stop -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="0,14"
                                        Background="#3A1515"
                                        BorderBrush="#6B2020"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Command="{Binding StopGenerationCommand}"
                                        IsVisible="{Binding IsGenerating}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Stop}" Width="16" Height="16" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Zastavit" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- ── Posuvná příčka ─────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#1A1A1E"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── Right panel – canvas / gallery ───────────────────────────── -->
            <Grid Grid.Column="2" Background="{DynamicResource AppBgBrush}" RowDefinitions="*,Auto">

                <!-- Main view area -->
                <Grid Grid.Row="0">

                    <!-- State A: Prázdný canvas, negeneruje se -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="!IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="52" Height="52"
                                   Foreground="{DynamicResource HoverBgBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zatím žádný obrázek"
                                   FontSize="14"
                                   Foreground="{DynamicResource CardHoverBgBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Zadej prompt a stiskni Generovat"
                                   FontSize="12"
                                   Foreground="#2A2A32"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State B: Prázdný canvas, generuje se (první obrázek) -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasGeneratedImages"/>
                                <Binding Path="IsGenerating"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"
                                     Height="3"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding GenerationStatus}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   MaxWidth="500"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- State C: Existují obrázky — zobraz poslední + overlay při generování -->
                    <Grid IsVisible="{Binding HasGeneratedImages}" RowDefinitions="*,Auto">
                        <Border Grid.Row="0" Padding="24" Background="{DynamicResource AppBgBrush}">
                            <Image Source="{Binding LatestImage.FullBitmap}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>

                        <!-- Generating overlay over existing image -->
                        <Border Grid.Row="0"
                                Background="#88000000"
                                IsVisible="{Binding IsGenerating}">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <ProgressBar IsIndeterminate="True"
                                             Width="200"
                                             Height="3"
                                             Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding GenerationStatus}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           MaxWidth="500"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Image metadata bar -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource VeryDeepBgBrush}"
                                BorderBrush="#1E1E24"
                                BorderThickness="0,1,0,0"
                                Padding="16,6">
                            <StackPanel DataContext="{Binding LatestImage}" Spacing="3">
                                <!-- Řádek 1: prompt + rozlišení + akce -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Prompt}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextHintBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding Prompt}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ResolutionLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextWeakBrush}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <!-- Zoom -->
                                    <Button Grid.Column="2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            ToolTip.Tip="Zvětšit (zoom)"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ToggleZoomCommand}">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.Fullscreen}" Width="16" Height="16" Foreground="{DynamicResource TextWeakBrush}"/>
                                    </Button>
                                    <!-- Copy prompt -->
                                    <Button Grid.Column="3"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            ToolTip.Tip="Kopírovat prompt"
                                            Command="{Binding CopyPromptCommand}">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ContentCopy}" Width="16" Height="16" Foreground="{DynamicResource TextWeakBrush}"/>
                                    </Button>
                                    <!-- Open in Explorer -->
                                    <Button Grid.Column="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,4"
                                            ToolTip.Tip="Otevřít ve Průzkumníku"
                                            Command="{Binding OpenInExplorerCommand}">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FolderOpen}" Width="16" Height="16" Foreground="{DynamicResource TextWeakBrush}"/>
                                    </Button>
                                </Grid>
                                <!-- Řádek 2: technická metadata -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SeedLabel, StringFormat='Seed: {0}'}"
                                               FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource ElevatedBgBrush}"/>
                                    <TextBlock Text="{Binding StepsLabel}"
                                               FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource ElevatedBgBrush}"/>
                                    <TextBlock Text="{Binding CfgLabel}"
                                               FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource ElevatedBgBrush}"
                                               IsVisible="{Binding SamplerSchedulerLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding SamplerSchedulerLabel}"
                                               FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                               IsVisible="{Binding SamplerSchedulerLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="·" FontSize="10" Foreground="{DynamicResource ElevatedBgBrush}"/>
                                    <TextBlock Text="{Binding ModelShort}"
                                               FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="180"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── Thumbnail strip ──────────────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#080809"
                        BorderBrush="#1E1E24"
                        BorderThickness="0,1,0,0"
                        Padding="8,6"
                        IsVisible="{Binding HasGeneratedImages}">
                    <DockPanel>
                        <!-- Pravý sloupec: status + „Načíst další" -->
                        <Border DockPanel.Dock="Right"
                                Background="#0C0C10"
                                BorderBrush="#1E1E24" BorderThickness="1,0,0,0"
                                Padding="12,6"
                                MinWidth="140">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GalleryStatusLine}"
                                           FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <Button Command="{Binding LoadMoreImagesCommand}"
                                        IsVisible="{Binding CanLoadMoreImages}"
                                        IsEnabled="{Binding !IsLoadingMoreImages}"
                                        Background="#1A1228"
                                        BorderBrush="#2A1A44" BorderThickness="1"
                                        CornerRadius="6" Padding="10,5"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        ToolTip.Tip="Načte ze SQLite dalších 50 obrázků">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ChevronDoubleDown}"
                                                         Width="12" Height="12" Foreground="{DynamicResource AccentLightBrush}"
                                                         VerticalAlignment="Center"/>
                                        <TextBlock Text="Načíst další"
                                                   FontSize="11" Foreground="{DynamicResource AccentLightBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsLoadingMoreImages}"/>
                                        <TextBlock Text="Načítám…"
                                                   FontSize="11" Foreground="{DynamicResource AccentLightBrush}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsLoadingMoreImages}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Vlastní strip -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="90">
                        <ItemsControl ItemsSource="{Binding GeneratedImages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GeneratedImageViewModel">
                                    <Border CornerRadius="6"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding TimeLabel}"
                                            Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected)">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Border:not(.selected):pointerover">
                                                <Setter Property="BorderBrush" Value="#5B21B6"/>
                                            </Style>
                                        </Border.Styles>
                                        <!-- Grid umožní vrstvit obrázek + hover overlay.
                                             POZN: Tapped handler v code-behind místo Button +
                                             ReflectionBinding $parent[UserControl] — ten v
                                             Avalonia 12 uvnitř hluboce nested DataTemplate
                                             nedeterministicky selhával (klik se „ztratil",
                                             metadata bar pod hlavním obrázkem se neaktualizoval). -->
                                        <Grid Width="78" Height="78" Classes="thumbGrid"
                                              Cursor="Hand"
                                              Tapped="ThumbnailGrid_Tapped">
                                            <Grid.Styles>
                                                <Style Selector="Grid.thumbGrid Border.thumbHover">
                                                    <Setter Property="Opacity" Value="0"/>
                                                </Style>
                                                <Style Selector="Grid.thumbGrid:pointerover Border.thumbHover">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Style>
                                            </Grid.Styles>
                                            <Image Source="{Binding Thumbnail}"
                                                   Width="78"
                                                   Height="78"
                                                   Stretch="UniformToFill"/>
                                            <!-- Hover overlay: tlačítko Použít jako referenci -->
                                            <Border Classes="thumbHover"
                                                    Background="#AA000000"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Použít jako referenci"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.UseAsReferenceCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImagePlus}"
                                                                   Width="18" Height="18"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Ref" FontSize="9" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ── Zoom overlay ──────────────────────────────────────────── -->
                <!-- Překryje celý pravý panel (oba řádky) při IsZoomed=true    -->
                <Grid Grid.Row="0" Grid.RowSpan="2"
                      Background="{DynamicResource AppBgBrush}"
                      Panel.ZIndex="20"
                      IsVisible="{Binding IsZoomed}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Záhlaví: zavřít + jméno souboru -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource VeryDeepBgBrush}"
                                BorderBrush="#1E1E24"
                                BorderThickness="0,0,0,1"
                                Padding="16,8">
                            <Grid ColumnDefinitions="*,Auto" DataContext="{Binding LatestImage}">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="10,6"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        ToolTip.Tip="Zavřít zoom"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.ActiveGenerator.ToggleZoomCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.FullscreenExit}" Width="16" Height="16"/>
                                        <TextBlock Text="Zavřít" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Plný obrázek -->
                        <Border Grid.Row="1" Padding="32" Background="{DynamicResource AppBgBrush}">
                            <Image Source="{Binding LatestImage.FullBitmap}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
