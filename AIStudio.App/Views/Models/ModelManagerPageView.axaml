<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="AIStudio.App.Views.Models.ModelManagerPageView"
             x:DataType="vm:ModelManagerPageViewModel">

    <UserControl.DataTemplates>
        <!-- Globální typed-template registrace — kdykoliv ItemsControl narazí
             na ModelItemViewModel a nemá vlastní ItemTemplate, použije tuhle.
             Funguje napříč všemi nested ItemsControly bez StaticResource lookupu
             (kterej v Avalonia 12 uvnitř nested DataTemplate má scoping kvirky). -->
        <DataTemplate DataType="vm:ModelItemViewModel" x:DataType="vm:ModelItemViewModel">
            <!-- Right margin 14 zaručí mezeru od scrollbaru bez ohledu na Avalonia
                 scrollbar rendering (overlay vs. inline). Padding na ScrollVieweru
                 by se mohl skrýt pod overlay scrollbarem; margin na card border
                 spolehlivě tlačí border doleva. -->
            <Border Margin="0,0,14,6" CornerRadius="12" Cursor="Hand" Background="{DynamicResource CardBgBrush}">
                <Button Background="Transparent" BorderThickness="0" Padding="14"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{ReflectionBinding $parent[UserControl].DataContext.SelectModelCommand}"
                        CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                        <!-- Thumbnail: načtený obrázek nebo placeholder ikona -->
                        <Border Grid.Column="0"
                                Width="48" Height="48" CornerRadius="10" ClipToBounds="True"
                                VerticalAlignment="Top"
                                Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                IsVisible="{Binding HasThumbnail}">
                            <Panel>
                                <Image Source="{Binding ThumbnailBitmap}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding HasLoadedThumbnail}"/>
                                <mi:MaterialIcon Kind="ImageOutline" Width="22" Height="22" Foreground="{DynamicResource InfoTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasLoadedThumbnail}"/>
                            </Panel>
                        </Border>

                        <!-- Obsah karty: název, badge, popis, meta — vše ve sloupci.
                             Název je samostatně, takže TextTrimming reálně funguje
                             (v horizontálním StackPanelu měl nekonečnou šířku a přetékal).
                             Badge i meta jdou do WrapPanelu — při úzkém okně se zalomí. -->
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">

                            <!-- Název -->
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Name}"/>

                            <!-- Badge — WrapPanel, každý badge má pravý margin místo Spacing -->
                            <WrapPanel>
                                <Border IsVisible="{Binding IsActive}" Margin="0,0,6,0"
                                        Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="● Aktivní" FontSize="10" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                                <Border IsVisible="{Binding IsDownloaded}" Margin="0,0,6,0"
                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="Staženo" FontSize="10" Foreground="{DynamicResource InfoTextBrush}"/>
                                </Border>
                                <Border IsVisible="{Binding IsChatCategory}" Margin="0,0,6,0"
                                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="Chat" FontSize="10" Foreground="{DynamicResource AccentLightBrush}"/>
                                </Border>
                                <Border IsVisible="{Binding IsImageCategory}" Margin="0,0,6,0"
                                        Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="Obrázky" FontSize="10" Foreground="{DynamicResource OkTextBrush}"/>
                                </Border>
                                <Border IsVisible="{Binding IsNsfw}" Margin="0,0,6,0"
                                        Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="NSFW" FontSize="10" Foreground="{DynamicResource ErrorBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Popis — max 2 řádky, pak ořez -->
                            <TextBlock Text="{Binding Description}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Meta info — WrapPanel, zalomí se na další řádek -->
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,2"
                                            IsVisible="{Binding Size, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <mi:MaterialIcon Kind="Harddisk" Width="14" Height="14" Foreground="{DynamicResource TextWeakBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource TextWeakBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,2" IsVisible="{Binding HasBaseModel}">
                                    <TextBlock Text="{Binding BaseModel}" FontSize="11" Foreground="{DynamicResource InfoTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,2">
                                    <mi:MaterialIcon Kind="Download" Width="14" Height="14" Foreground="{DynamicResource TextWeakBrush}"/>
                                    <TextBlock Text="{Binding DownloadCountLabel}" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,2" IsVisible="{Binding HasRating}">
                                    <mi:MaterialIcon Kind="Star" Width="14" Height="14" Foreground="{DynamicResource RatingBrush}"/>
                                    <TextBlock Text="{Binding RatingLabel}" FontSize="11" Foreground="{DynamicResource RatingBrush}"/>
                                </StackPanel>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1" Margin="0,0,8,2">
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource InfoTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1" Margin="0,0,8,2"
                                        IsVisible="{Binding Quantization, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Quantization}" FontSize="10" Foreground="{DynamicResource InfoTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1" Margin="0,0,8,2"
                                        IsVisible="{Binding HasVramInfo}">
                                    <TextBlock Text="{Binding VramLabel}" FontSize="10" Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Svislý oddělovač — vizuálně odděluje akční část karty -->
                        <Border Grid.Column="2" Width="1" Margin="0,2"
                                Background="{DynamicResource AppBorderBrush}"
                                VerticalAlignment="Stretch"/>

                        <!-- Akční část karty — pevná šířka, tlačítka jednotná (Stretch + Height 34) -->
                        <Panel Grid.Column="3" VerticalAlignment="Center" Width="156">
                            <!-- Stahování -->
                            <StackPanel IsVisible="{Binding ShowDownloading}" Spacing="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <ProgressBar Grid.Column="0" Value="{Binding DownloadProgress}"
                                                 Minimum="0" Maximum="100" Height="4" CornerRadius="2"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AppBorderBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DownloadProgressLabel}"
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding DownloadedLabel}" FontSize="10" Foreground="{DynamicResource TextWeakBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DownloadSpeedLabel}" FontSize="10" Foreground="{DynamicResource TextWeakBrush}"/>
                                            <TextBlock Text="{Binding EtaLabel}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                                       IsVisible="{Binding EtaLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Padding="8,4" FontSize="11"
                                            Foreground="{DynamicResource ErrorBrush}" Content="Zrušit"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.CancelDownloadCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Čeká ve frontě -->
                            <StackPanel IsVisible="{Binding IsQueued}" Spacing="5">
                                <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,5" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <mi:MaterialIcon Kind="TrayFull" Width="13" Height="13" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ve frontě" FontSize="11" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Classes="secondary" Padding="8,4" FontSize="11"
                                        Foreground="{DynamicResource ErrorBrush}" Content="Zrušit"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.CancelDownloadCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                            <!-- Chyba -->
                            <StackPanel IsVisible="{Binding ShowDownloadError}" Spacing="5">
                                <TextBlock Text="{Binding DownloadError}" FontSize="10"
                                           Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                                <Button Classes="secondary" Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                        MinHeight="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="Zkusit znovu"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.DownloadCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                            <!-- Staženo → Nastavit aktivní -->
                            <Button Classes="secondary" IsVisible="{Binding ShowDownloaded}"
                                    IsEnabled="{Binding !IsActive}"
                                    MinHeight="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="Nastavit aktivní"
                                    Command="{ReflectionBinding $parent[UserControl].DataContext.SetActiveCommand}"
                                    CommandParameter="{Binding}"/>

                            <!-- Nestaženo → Detail -->
                            <Button Classes="primary" IsVisible="{Binding ShowDownloadButton}"
                                    MinHeight="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="Detail"
                                    Command="{ReflectionBinding $parent[UserControl].DataContext.SelectModelCommand}"
                                    CommandParameter="{Binding}"/>
                        </Panel>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Detail modelu se otevírá v samostatném okně (ModelDetailWindow) —
             dříve byl ve splitteru, ale ten zbytečně užíral horizontální místo
             v seznamu modelů. Seznam teď zabírá celou šířku. -->

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,22,28,16"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Modely" Classes="pageTitle"/>
                    <TextBlock Text="Doporučené modely z HuggingFace a Civitai — nebo si najdi vlastní"
                               FontSize="12" Foreground="{DynamicResource TextHintBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="secondary" Command="{Binding OpenDownloadQueueCommand}"
                            ToolTip.Tip="Zobrazit frontu stahování">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="TrayFull" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Fronta" VerticalAlignment="Center"/>
                            <Border IsVisible="{Binding HasQueuedDownloads}"
                                    Background="{DynamicResource AccentBrush}" CornerRadius="8" MinWidth="18" Height="18"
                                    Padding="5,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DownloadQueueCount}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding AddLocalModelCommand}"
                            ToolTip.Tip="Přidat model ze svého disku">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Přidat lokální" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding RescanModelsCommand}"
                            ToolTip.Tip="Prohledat složku modelů znovu">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Prohledat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Command="{Binding OpenModelsFolderCommand}"
                            ToolTip.Tip="Otevřít složku modelů v Průzkumníku">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Složka" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar: 3 taby -->
        <Border Grid.Row="1" Padding="20,12,20,10"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource DeepPanelBgBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="tabBtn"
                            Classes.activeTab="{Binding IsRecommendedTabActive}"
                            Command="{Binding SelectTabCommand}" CommandParameter="0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Doporučené" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tabBtn"
                            Classes.activeTab="{Binding IsSearchTabActive}"
                            Command="{Binding SelectTabCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Hledat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tabBtn"
                            Classes.activeTab="{Binding IsDownloadedTabActive}"
                            Command="{Binding SelectTabCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="Download" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Stažené" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Refresh tlačítko jen pro „Doporučené" -->
                <Button Grid.Column="2" Classes="secondary"
                        IsVisible="{Binding IsRecommendedTab}"
                        Command="{Binding RefreshRecommendedCommand}"
                        ToolTip.Tip="Obnovit doporučené z internetu (mimo cache)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Obnovit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═════════════════ TAB 0: DOPORUČENÉ ═════════════════ -->
        <!-- Right padding 28 (vs 20 vlevo) drží mezeru mezi card border a scrollbarem.
             V Avalonia 12 ScrollBar Vertical zabírá ~12px a pokud je content všude
             paddováno stejně, border se s scrollbarem opticky slepí. -->
        <ScrollViewer Grid.Row="2" Padding="20,12,14,12"
                      IsVisible="{Binding IsRecommendedTab}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- Globální spinner při prvním loadu -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            IsVisible="{Binding IsLoadingRecommended}">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="3"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HoverBgBrush}"/>
                    <TextBlock Text="Načítám doporučené modely…" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Sekce -->
                <ItemsControl ItemsSource="{Binding RecommendedSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecommendedSectionViewModel">
                            <StackPanel Spacing="8" Margin="0,0,0,16">
                                <!-- Header sekce -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Per-section spinner -->
                                <ProgressBar IsIndeterminate="True" Height="2" CornerRadius="1"
                                             Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                                             IsVisible="{Binding IsLoading}"/>

                                <!-- Per-section error -->
                                <Border IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrSurfaceBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6">
                                    <TextBlock Text="{Binding LoadError}" FontSize="11"
                                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Empty state (load proběhl, ale nic) -->
                                <TextBlock Text="Pro tento výběr nic dostupného."
                                           FontSize="11" Foreground="{DynamicResource TextWeakBrush}"
                                           IsVisible="{Binding ShowEmptyState}"/>

                                <!-- Modely v sekci — DataTemplate se použije automaticky
                                     z UserControl.DataTemplates podle typu položky. -->
                                <ItemsControl ItemsSource="{Binding Models}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="80"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════════ TAB 1: HLEDAT ═════════════════ -->
        <ScrollViewer Grid.Row="2" Padding="20,12,14,12"
                      IsVisible="{Binding IsSearchTab}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- Search box -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource TextHintBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Grid.Column="1"
                                 Classes="chatInputInner"
                                 Text="{Binding SearchQuery}"
                                 PlaceholderText="Hledat — např. magnum, juggernaut, qwen 14b, flux dev"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentLightBrush}"
                                 Padding="8,8" FontSize="13">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding RunSearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" Classes="primary"
                                Command="{Binding RunSearchCommand}"
                                IsEnabled="{Binding !IsSearching}" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Hledat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Filtry: provider + kind + nsfw -->
                <Border Background="{DynamicResource DeepPanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="14">
                        <TextBlock Grid.Column="0" Text="Zdroj:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SearchProviderIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="HuggingFace + Civitai"/>
                            <ComboBoxItem Content="HuggingFace"/>
                            <ComboBoxItem Content="Civitai"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="Typ:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" SelectedIndex="{Binding SearchKindIndex}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Vše"/>
                            <ComboBoxItem Content="Chat (LLM)"/>
                            <ComboBoxItem Content="Image (Checkpoint)"/>
                            <ComboBoxItem Content="LoRA"/>
                        </ComboBox>
                        <CheckBox Grid.Column="4" IsChecked="{Binding IncludeNsfw}"
                                  Content="Včetně NSFW" FontSize="11"
                                  Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Loading -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            IsVisible="{Binding IsSearching}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="3"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HoverBgBrush}"/>
                    <TextBlock Text="Vyhledávám…" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Error -->
                <Border IsVisible="{Binding SearchError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrSurfaceBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8">
                    <TextBlock Text="{Binding SearchError}" FontSize="11"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Onboarding hint, dokud uživatel nehledal -->
                <Border IsVisible="{Binding HasNoSearchResults}"
                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoSurfaceBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Hledej napříč HuggingFace a Civitai"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentLighterBrush}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentSubtleBrush}" TextWrapping="Wrap"
                                       Text="HuggingFace = GGUF chat modely + FLUX. Civitai = SDXL / Pony / SD 1.5 / FLUX checkpointy a LoRA. Pro Civitai modely potřebuješ API klíč v Nastavení (jinak download selže). NSFW filtr platí jen pro Civitai."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Výsledky — typed template se aplikuje automaticky -->
                <ItemsControl ItemsSource="{Binding SearchResults}"/>

                <Border Height="80"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════════ TAB 2: STAŽENÉ ═════════════════ -->
        <ScrollViewer Grid.Row="2" Padding="20,12,14,12"
                      IsVisible="{Binding IsDownloadedTab}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- Empty state — žádné modely vůbec -->
                <Border IsVisible="{Binding HasNoDownloadedModels}"
                        Background="{DynamicResource DeepPanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Zatím nic není stažené" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"
                                   Text="Pro stažení přejdi do tabu Doporučené nebo Hledat. Můžeš taky přidat lokální soubor (.gguf, .safetensors, .ckpt, .pt) tlačítkem nahoře."/>
                    </StackPanel>
                </Border>

                <!-- Filter + sort toolbar — zobrazuje se jen pokud jsou vůbec nějaké modely -->
                <Border Background="{DynamicResource DeepPanelBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,8"
                        IsVisible="{Binding !HasNoDownloadedModels}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <!-- Typ filtru -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <Button Classes="tabBtn"
                                    Classes.activeTab="{Binding IsFilterAll}"
                                    Command="{Binding SetDownloadedFilterCommand}" CommandParameter="0"
                                    Content="Vše"/>
                            <Button Classes="tabBtn"
                                    Classes.activeTab="{Binding IsFilterChat}"
                                    Command="{Binding SetDownloadedFilterCommand}" CommandParameter="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="Chat" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chat" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="tabBtn"
                                    Classes.activeTab="{Binding IsFilterImage}"
                                    Command="{Binding SetDownloadedFilterCommand}" CommandParameter="2">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <mi:MaterialIcon Kind="ImageOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Obrázky" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Řazení -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Řadit:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding DownloadedSortIndex}" MinWidth="120">
                                <ComboBoxItem Content="Název A–Z"/>
                                <ComboBoxItem Content="Velikost ↑"/>
                                <ComboBoxItem Content="Velikost ↓"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding FilteredDownloadedModels}"/>

                <Border Height="80"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Detail panel byl přesunut do samostatného okna ModelDetailWindow -->

    </Grid>
</UserControl>
