<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.Video"
             xmlns:svc="using:AIStudio.Core.Services"
             xmlns:models="using:AIStudio.Core.Models"
             xmlns:conv="using:AIStudio.App.Converters"
             xmlns:controls="using:AIStudio.App.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             x:Class="AIStudio.App.Views.Video.VideoPageView"
             x:DataType="vm:VideoPageViewModel">

    <UserControl.Resources>
        <conv:FileNameWithoutExtensionConverter x:Key="FileNameNoExt"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Hlavička -->
        <Border Grid.Row="0" Padding="28,20,28,14"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <TextBlock Text="Video" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Generování videa přes Wan 2.1 — z textu nebo rozhýbání obrázku"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="28,18,28,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Model -->
                <StackPanel Spacing="6">
                    <TextBlock Text="MODEL" Classes="sectionHeader"/>
                    <ComboBox MinWidth="320" HorizontalAlignment="Left" MinHeight="36"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:WanVideoModel">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ModelDescription}" FontSize="11"
                               Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Rozlišení / kvalita -->
                <StackPanel Spacing="6">
                    <TextBlock Text="ROZLIŠENÍ" Classes="sectionHeader"/>
                    <ComboBox MinWidth="260" HorizontalAlignment="Left" MinHeight="36"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VideoResolution">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"
                               Text="720p = vyšší kvalita, ale výrazně víc VRAM a času. Pro obrázek→video v 720p vyber model s označením 720p."/>
                </StackPanel>

                <!-- Vstupní obrázek (jen obrázek→video) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsImageToVideo}">
                    <TextBlock Text="VSTUPNÍ OBRÁZEK (co rozhýbat)" Classes="sectionHeader"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Width="120" Height="120" CornerRadius="10"
                                ClipToBounds="True" Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                            <Panel>
                                <TextBlock Text="bez obrázku" FontSize="11" IsVisible="{Binding !HasStartImage}"
                                           Foreground="{DynamicResource TextWeakBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding StartImageBitmap}" Stretch="UniformToFill"
                                       IsVisible="{Binding HasStartImage}"/>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="secondary" Padding="12,7"
                                    Command="{Binding PickStartImageCommand}" Content="Vybrat obrázek…"/>
                            <Button Classes="secondary" Padding="12,7"
                                    IsVisible="{Binding HasStartImage}"
                                    Command="{Binding ClearStartImageCommand}" Content="Odebrat"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Prompt -->
                <StackPanel Spacing="6">
                    <TextBlock Text="PROMPT (anglicky funguje nejlépe)" Classes="sectionHeader"/>
                    <TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" MaxHeight="160"
                             PlaceholderText="např. a red fox running through a snowy forest, cinematic, tracking shot"/>
                </StackPanel>

                <!-- Negativní prompt -->
                <StackPanel Spacing="6">
                    <TextBlock Text="NEGATIVNÍ PROMPT (co NEchceš — nepovinné)" Classes="sectionHeader"/>
                    <TextBox Text="{Binding NegativePrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="48" MaxHeight="110"
                             PlaceholderText="prázdné = použije se ověřený Wan default (rozmazání, artefakty, deformace…)"/>
                </StackPanel>

                <!-- Parametry -->
                <StackPanel Spacing="6">
                    <TextBlock Text="PARAMETRY" Classes="sectionHeader"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="3" IsVisible="{Binding SingleLengthVisible}">
                            <TextBlock Text="Délka (snímků)" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                            <NumericUpDown Value="{Binding Length}" Minimum="9" Maximum="129" Increment="4"
                                           FormatString="0" MinWidth="90"
                                           ToolTip.Tip="Délka videa = počet snímků. Krok 4 (Wan vyžaduje 4n+1: 33, 49, 65, 81…). Doporučeno do ~81 (≈5 s)."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="FPS" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                            <NumericUpDown Value="{Binding Fps}" Minimum="8" Maximum="30" Increment="1"
                                           FormatString="0" MinWidth="80"
                                           ToolTip.Tip="Snímků za sekundu při přehrávání. Wan 2.1 nativně 16. Délka v sekundách = snímky ÷ FPS."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="Kroky" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                            <NumericUpDown Value="{Binding Steps}" Minimum="10" Maximum="50" Increment="1"
                                           FormatString="0" MinWidth="80"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="CFG" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                            <NumericUpDown Value="{Binding Cfg}" Minimum="1.0" Maximum="12.0" Increment="0.5"
                                           FormatString="0.0" MinWidth="80"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding DurationLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DimensionsLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextHintBrush}"/>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SingleLengthVisible}"
                               Text="Délku videa řídíš počtem snímků ÷ FPS. Wan 2.1 zvládá krátké klipy — doporučeno do ~81 snímků (≈ 5 s); víc = výrazně víc VRAM a času."/>
                </StackPanel>

                <!-- Dlouhé video (řetězení segmentů) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="DLOUHÉ VIDEO" Classes="sectionHeader"/>
                    <CheckBox IsChecked="{Binding LongVideoMode}"
                              Content="Složit delší video z navazujících ~5s segmentů"
                              ToolTip.Tip="Wan zvládne nativně jen ~5 s. Delší video appka složí z více segmentů — každý navazuje na poslední snímek předchozího (kontinuita). Segmenty se nakonec spojí do jednoho MP4."/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding LongVideoMode}">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Cílová délka (s)" FontSize="11" Foreground="{DynamicResource TextHintBrush}"/>
                            <NumericUpDown Value="{Binding TargetSeconds}" Minimum="5" Maximum="180" Increment="5"
                                           FormatString="0" MinWidth="100"
                                           ToolTip.Tip="Cílová délka výsledného videa v sekundách. Appka ji sama rozplánuje na segmenty (čím delší, tím víc segmentů a času)."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SegmentPlanLabel}" FontSize="12"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextHintBrush}" TextWrapping="Wrap"
                                       Text="Pozn.: každé navázání mírně driftuje barvy/detail a čas roste lineárně (víc segmentů = víc minut). Bez vstupního obrázku začne 1. segment z textu (potřebuje i text→video model)."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Kvalita (upscale + interpolace) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="KVALITA" Classes="sectionHeader"/>
                    <CheckBox IsChecked="{Binding Upscale}"
                              Content="Zvýšit rozlišení 2× (ESRGAN upscale nad 480/720p)"
                              ToolTip.Tip="Wan generuje nativně 480/720p. Tahle volba po vygenerování protáhne snímky ESRGAN modelem na ~2× rozlišení (skutečné HD+). Přidá samostatný krok a čas; model (~64 MB) se případně stáhne sám."/>
                    <CheckBox IsChecked="{Binding Interpolate}"
                              Content="Plynulejší pohyb (interpolace mezisnímků – RIFE)"
                              ToolTip.Tip="Wan generuje 16 fps, což může působit lehce sekaně. RIFE dopočítá mezisnímky a video bude plynulejší, aniž by se generovalo víc. Přidá samostatný krok; potřebný node se případně doinstaluje sám."/>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Interpolate}" Margin="26,0,0,0">
                        <TextBlock Text="Násobek" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextHintBrush}"/>
                        <NumericUpDown Value="{Binding InterpolateMultiplier}" Minimum="2" Maximum="4" Increment="1"
                                       FormatString="0" MinWidth="80"
                                       ToolTip.Tip="2 = dvojnásobné FPS (16→32), 3 = trojnásobné (16→48). Vyšší = plynulejší, ale pomalejší."/>
                        <TextBlock Text="{Binding InterpolationLabel}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentLightBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- LoRA (volitelné) -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="LORA ADAPTERY (nepovinné)" Classes="sectionHeader" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="secondary" Padding="8,4" FontSize="11"
                                Command="{Binding LoadLorasCommand}" ToolTip.Tip="Načíst dostupné LoRA">
                            ↻ Načíst
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" MinHeight="34" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding AvailableLoras}"
                                  SelectedItem="{Binding SelectedLoraToAdd}"
                                  PlaceholderText="Vybrat LoRA…">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding Converter={StaticResource FileNameNoExt}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <NumericUpDown Grid.Column="1" Value="{Binding LoraStrength}" Minimum="0.0" Maximum="2.0"
                                       Increment="0.05" FormatString="0.00" MinWidth="110" FontSize="12"
                                       ToolTip.Tip="Síla LoRA"/>
                        <Button Grid.Column="2" Classes="secondary" Padding="10,5" FontSize="12"
                                Command="{Binding AddLoraCommand}">+ Přidat</Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SelectedLoras}" IsVisible="{Binding HasLoras}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LoraItem">
                                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8,5" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name, Converter={StaticResource FileNameNoExt}}"
                                                   FontSize="12" Foreground="{DynamicResource AccentLightBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Margin="6,0" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                            <Run Text="×"/><Run Text="{Binding StrengthModel, StringFormat='{}{0:0.00}'}"/>
                                        </TextBlock>
                                        <Button Grid.Column="2" Classes="secondary" Padding="6,2" FontSize="10" Content="✕"
                                                ToolTip.Tip="Odebrat LoRA"
                                                Command="{Binding $parent[ItemsControl].((vm:VideoPageViewModel)DataContext).RemoveLoraCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Závislosti (velké modely) -->
                <Border IsVisible="{Binding !DepsReady}"
                        Background="{DynamicResource WarnSurfaceBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.DownloadOutline}"
                                             Width="16" Height="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Chybí Wan modely (jednorázové stažení, jednotky až desítky GB)"
                                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MissingDepsLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Button Classes="secondary" Padding="12,7" HorizontalAlignment="Left"
                                IsVisible="{Binding !IsDownloadingDeps}"
                                Command="{Binding DownloadDependenciesCommand}"
                                Content="Stáhnout modely"/>
                        <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingDeps}">
                            <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2"
                                         Foreground="{DynamicResource AccentLightBrush}"/>
                            <TextBlock Text="{Binding DepsStatus}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Generovat -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Padding="0,12" CornerRadius="10" BorderThickness="0"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        IsEnabled="{Binding CanGenerate}"
                        IsVisible="{Binding !IsGenerating}"
                        Command="{Binding GenerateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MovieOpenOutline}" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Vygenerovat video" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Průběh generování -->
                <Border IsVisible="{Binding IsGenerating}"
                        Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusLine}" FontSize="12"
                                       Foreground="{DynamicResource AccentLighterBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="secondary" Padding="10,4"
                                    Command="{Binding CancelGenerateCommand}" Content="Zrušit"/>
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                     Height="5" CornerRadius="3"
                                     Foreground="{DynamicResource AccentLightBrush}" Background="{DynamicResource InfoSurfaceBrush}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="{Binding ProgressLabel}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding EtaLabel}" FontSize="11"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextHintBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Chyba -->
                <Border IsVisible="{Binding HasError}"
                        Background="{DynamicResource ErrSurfaceBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource ErrTextBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Výsledek -->
                <Border IsVisible="{Binding HasResult}"
                        Background="{DynamicResource OkSurfaceBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.CheckCircleOutline}"
                                             Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Video vygenerováno a uloženo do galerie." FontSize="12"
                                       Foreground="{DynamicResource OkTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border CornerRadius="8" ClipToBounds="True" Height="300"
                                Background="#000000">
                            <controls:VideoPlayerControl Source="{Binding ResultVideoPath}"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Padding="12,7"
                                    Command="{Binding OpenResultFileCommand}" Content="Přehrát"/>
                            <Button Classes="secondary" Padding="12,7"
                                    Command="{Binding OpenGalleryCommand}" Content="Otevřít galerii"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Height="28"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
