<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AIStudio.App.ViewModels.Creation"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:miKind="using:Material.Icons"
             x:Class="AIStudio.App.Views.Creation.CreationPageView"
             x:DataType="vm:CreationPageViewModel">

    <TabControl Padding="0"
                Background="{DynamicResource AppBgBrush}"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

        <TabControl.Styles>
            <!-- Záhlaví záložek odsazené od kraje, ať nelepí na sidebar -->
            <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                <Setter Property="Margin" Value="24,12,24,0"/>
            </Style>
        </TabControl.Styles>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ImageOutline}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Obrázky" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding ImageStudioPage}"/>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.MovieOpenOutline}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Videa" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding VideoPage}"/>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ViewGalleryOutline}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Galerie" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding GalleryPage}"/>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{x:Static miKind:MaterialIconKind.ArrowExpandAll}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Upscale" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ContentControl Content="{Binding UpscalePage}"/>
        </TabItem>

    </TabControl>
</UserControl>
