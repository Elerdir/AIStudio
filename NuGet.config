<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet config repo-local: kromě nuget.org přidává lokální feed `./lib`.
    Tam je commitnutý `UpdateHub.Client.X.Y.Z.nupkg`, který je závislost pro
    AIStudio.Infrastructure (AutoUpdate přes updatehub.niderle.cz).

    Důvod: UpdateHub.Client je vlastní knihovna z repa Elerdir/updatehub,
    ale my ji nechceme jako ProjectReference (vyžadovalo by mít sourozenecké
    repo) ani jako submodule (komplikuje clone). NuGet package commitnutý
    v repu = `git clone && dotnet build` funguje bez extra kroků a CI taky.

    Update postupu (když máme nový build UpdateHubu):
      cd ../updatehub
      dotnet pack sdk/UpdateHub.Client/UpdateHub.Client.csproj -c Release -o ../AIStudio/lib
      # zvedneme Version v UpdateHub.Client.csproj a v AIStudio.Infrastructure.csproj
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-lib" value="./lib" />
  </packageSources>
</configuration>
